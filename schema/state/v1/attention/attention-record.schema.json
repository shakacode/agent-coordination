{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shakacode/agent-coordination/blob/main/schema/state/v1/attention/attention-record.schema.json",
  "title": "Agent Coordination Attention Record v1",
  "description": "A durable unresolved or resolved human-decision record with its source task identity. This contract stores bounded decision context, not prompts or transcripts.",
  "x-contract-version": 1,
  "x-record-family": "attention",
  "x-logical-key": ["workspace", "repository", "id"],
  "x-storage-key": {
    "template": "attention/{workspace}/{repository_owner}/{repository_name}/{id}.json",
    "segment_encoding": "workspace, repository, and id are each limited to 160 ASCII characters. Path segments use the existing agent-coord safe segment grammar: ASCII alphanumeric, underscore, dot, colon, and hyphen. repository is split at its single slash into owner and name. The longest valid key is 497 bytes, below the Worker's 512-byte active-path limit."
  },
  "$ref": "#/$defs/attention_record",
  "$defs": {
    "non_empty_bounded_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "capability_state": {
      "enum": ["available", "unavailable", "unknown"],
      "description": "Capability truth only. Unknown or untested behavior remains unknown; unavailable behavior is never simulated."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "host_id", "task_id", "last_seen_at", "capabilities"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
        "host_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "task_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "open_uri": { "type": "string", "format": "uri", "maxLength": 2000 },
        "last_seen_at": { "type": "string", "format": "date-time" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["native_open", "prompt_forwarding"],
          "properties": {
            "native_open": { "$ref": "#/$defs/capability_state" },
            "prompt_forwarding": { "$ref": "#/$defs/capability_state" }
          }
        }
      }
    },
    "attention_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "workspace", "id", "repository", "target", "status", "kind", "question",
        "choices", "priority_class", "priority_reason", "safe_resume", "source", "source_generation",
        "created_at", "refreshed_at"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "workspace": {
          "type": "string", "pattern": "^[A-Za-z0-9_:-]+(?:[.][A-Za-z0-9_:-]+)*$",
          "maxLength": 160, "default": "default"
        },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_:-]+(?:[.][A-Za-z0-9_:-]+)*$", "maxLength": 160 },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "maxLength": 160 },
        "target": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "status": { "enum": ["open", "resolved"] },
        "kind": { "type": "string", "minLength": 1, "maxLength": 100 },
        "question": { "$ref": "#/$defs/non_empty_bounded_text" },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "priority_class": {
          "enum": ["urgent-risk", "unblocks-work", "current-head-merge", "product-architecture"]
        },
        "priority_reason": { "$ref": "#/$defs/non_empty_bounded_text" },
        "safe_resume": { "$ref": "#/$defs/non_empty_bounded_text" },
        "source": { "$ref": "#/$defs/source" },
        "source_generation": { "type": "integer", "minimum": 0 },
        "created_at": { "type": "string", "format": "date-time" },
        "refreshed_at": { "type": "string", "format": "date-time" },
        "resolved_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "resolved" } }, "required": ["status"] },
          "then": { "required": ["resolved_at"] },
          "else": { "not": { "required": ["resolved_at"] } }
        }
      ]
    }
  }
}
