#!/usr/bin/env bash
# Usage: worker/bin/provision-token <machine-name> [--local] [--database NAME] [--rotate] scopes
# Prints a fresh token once; stores only its SHA-256 hash in D1.
set -euo pipefail

usage() {
  echo "usage: worker/bin/provision-token <machine-name> [--local] [--database NAME] [--rotate] --all-state" >&2
  echo "   or: worker/bin/provision-token <machine-name> [--local] [--database NAME] [--rotate] [--read-prefix PREFIX] [--write-prefix PREFIX]" >&2
  echo "       at least one prefix is required; prefix flags are repeatable" >&2
  exit 1
}

[ "$#" -ge 1 ] || usage

MACHINE="$1"
shift
case "$MACHINE" in
  --*) usage ;;
esac

SCOPE="--remote"
DATABASE="agent-coord"
ROTATE=0
READ_PREFIXES=()
WRITE_PREFIXES=()
READ_PREFIXES_GIVEN=0
WRITE_PREFIXES_GIVEN=0
ALL_STATE=0

if [[ ! "$MACHINE" =~ ^[A-Za-z0-9._:-]+$ ]]; then
  echo "machine name may contain only letters, numbers, dots, underscores, colons, and hyphens" >&2
  exit 1
fi

valid_prefix() {
  local prefix="$1"
  local active_prefix="${prefix#archive/}"
  if [[ "$active_prefix" == host_limits || "$active_prefix" == host_limits/* ]]; then
    [[ "$prefix" == "$active_prefix" || "$prefix" == "archive/$active_prefix" ]] || return 1
    valid_host_limit_prefix "$active_prefix" || return 1
    if [[ "$prefix" == archive/* ]]; then
      if host_limit_record_path "$active_prefix"; then
        [[ "${#active_prefix}" -le 512 ]] && [[ "${#prefix}" -le 520 ]]
      else
        [[ "${#prefix}" -le 512 ]]
      fi
    else
      [[ "${#prefix}" -le 512 ]]
    fi
    return
  fi
  [[ "$prefix" =~ ^[A-Za-z0-9_./:-]+$ ]] || return 1
  [[ "$prefix" != *..* ]] || return 1
  [[ "$prefix" != *//* ]] || return 1
  [[ "$prefix" != */ ]] || return 1
  local segment='[A-Za-z0-9_.:-]+'
  local active="claims(/${segment}(/${segment}(/${segment}\\.json)?)?)?|heartbeats(/${segment}\\.json)?|batches(/${segment}\\.json)?|events(/${segment}(/${segment}\\.json)?)?"
  local pattern="^(${active}|archive(/(${active}))?)$"
  if [[ "$prefix" == attention || "$prefix" == attention/* ]]; then
    valid_attention_prefix "$prefix" || return 1
  else
    [[ "$prefix" =~ $pattern ]] || return 1
  fi
  local archivable_path="claims/${segment}/${segment}/${segment}\\.json|heartbeats/${segment}\\.json|batches/${segment}\\.json|events/${segment}/${segment}\\.json"
  local archive_path_pattern="^archive/(${archivable_path})$"
  if [[ "$prefix" =~ $archive_path_pattern ]]; then
    local active_path="${prefix#archive/}"
    [[ "${#active_path}" -le 512 ]] && [[ "${#prefix}" -le 520 ]]
  else
    [[ "${#prefix}" -le 512 ]]
  fi
}

valid_host_limit_prefix() {
  local prefix="$1"
  local parts=()
  local canonical='^[a-z0-9]([a-z0-9._-]{0,126}[a-z0-9])?$'
  IFS=/ read -r -a parts <<< "$prefix"
  [[ "${parts[0]}" == "host_limits" ]] || return 1
  case "${#parts[@]}" in
    1) return 0 ;;
    2) valid_host_limit_encoded_component "${parts[1]}" ;;
    3) valid_host_limit_encoded_component "${parts[1]}" && valid_host_limit_encoded_component "${parts[2]}" ;;
    4)
      valid_host_limit_encoded_component "${parts[1]}" && valid_host_limit_encoded_component "${parts[2]}" &&
        [[ "${parts[3]}" =~ $canonical ]]
      ;;
    5)
      [[ "${parts[4]}" == *.json ]] || return 1
      local scope="${parts[4]%.json}"
      valid_host_limit_encoded_component "${parts[1]}" && valid_host_limit_encoded_component "${parts[2]}" &&
        [[ "${parts[3]}" =~ $canonical ]] && [[ "$scope" =~ $canonical ]]
      ;;
    *) return 1 ;;
  esac
}

host_limit_record_path() {
  local parts=()
  IFS=/ read -r -a parts <<< "$1"
  [[ "${#parts[@]}" -eq 5 ]] && [[ "${parts[4]}" == *.json ]]
}

valid_host_limit_encoded_component() {
  local value="$1"
  local encoded_component='^([A-Za-z0-9_-]|%[0-9A-F]{2})+$'
  [[ "$value" =~ $encoded_component ]] || return 1

  local index=0 length=${#value}
  while [[ "$index" -lt "$length" ]]; do
    if [[ "${value:index:1}" != "%" ]]; then
      index=$((index + 1))
      continue
    fi

    local hex="${value:index+1:2}"
    local byte=$((16#$hex))
    # ADR 0007 leaves these ASCII bytes literal, so an encoded spelling is not canonical.
    if (( (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) ||
          (byte >= 97 && byte <= 122) || byte == 45 || byte == 95 )); then
      return 1
    fi
    if (( byte <= 127 )); then
      index=$((index + 3))
      continue
    fi

    local continuation_count first_min=128 first_max=191
    if (( byte >= 194 && byte <= 223 )); then
      continuation_count=1
    elif (( byte >= 224 && byte <= 239 )); then
      continuation_count=2
      (( byte == 224 )) && first_min=160
      (( byte == 237 )) && first_max=159
    elif (( byte >= 240 && byte <= 244 )); then
      continuation_count=3
      (( byte == 240 )) && first_min=144
      (( byte == 244 )) && first_max=143
    else
      return 1
    fi

    local offset continuation_hex continuation_byte
    for ((offset = 1; offset <= continuation_count; offset++)); do
      local continuation_index=$((index + offset * 3))
      [[ "${value:continuation_index:1}" == "%" ]] || return 1
      continuation_hex="${value:continuation_index+1:2}"
      [[ "$continuation_hex" =~ ^[0-9A-F]{2}$ ]] || return 1
      continuation_byte=$((16#$continuation_hex))
      if (( offset == 1 )); then
        (( continuation_byte >= first_min && continuation_byte <= first_max )) || return 1
      else
        (( continuation_byte >= 128 && continuation_byte <= 191 )) || return 1
      fi
    done
    index=$((index + (continuation_count + 1) * 3))
  done
}

valid_attention_component() {
  local value="$1"
  [[ "${#value}" -le 160 ]] && [[ "$value" =~ ^[A-Za-z0-9_:-]+(\.[A-Za-z0-9_:-]+)*$ ]]
}

valid_attention_repo_segment() {
  local value="$1"
  [[ "$value" != "." ]] && [[ "$value" != *..* ]] && [[ "$value" =~ ^[A-Za-z0-9_.-]+$ ]]
}

valid_attention_repository() {
  local owner="$1"
  local name="$2"
  [[ $((${#owner} + 1 + ${#name})) -le 160 ]] &&
    valid_attention_repo_segment "$owner" && valid_attention_repo_segment "$name"
}

valid_attention_prefix() {
  local prefix="$1"
  local parts=()
  IFS=/ read -r -a parts <<< "$prefix"
  [[ "${parts[0]}" == "attention" ]] || return 1
  case "${#parts[@]}" in
    1) return 0 ;;
    2) valid_attention_component "${parts[1]}" ;;
    3)
      valid_attention_component "${parts[1]}" &&
        [[ "${#parts[2]}" -le 158 ]] && valid_attention_repo_segment "${parts[2]}"
      ;;
    4)
      valid_attention_component "${parts[1]}" &&
        valid_attention_repository "${parts[2]}" "${parts[3]}"
      ;;
    5)
      [[ "${parts[4]}" == *.json ]] || return 1
      local attention_id="${parts[4]%.json}"
      valid_attention_component "${parts[1]}" &&
        valid_attention_repository "${parts[2]}" "${parts[3]}" &&
        valid_attention_component "$attention_id"
      ;;
    *) return 1 ;;
  esac
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --remote)
      SCOPE="--remote"
      shift
      ;;
    --local)
      SCOPE="--local"
      shift
      ;;
    --all-state)
      ALL_STATE=1
      shift
      ;;
    --database)
      [ "$#" -ge 2 ] || usage
      DATABASE="$2"
      shift 2
      ;;
    --rotate)
      ROTATE=1
      shift
      ;;
    --read-prefix)
      [ "$#" -ge 2 ] || usage
      [ -n "$2" ] || { echo "prefix cannot be empty; pass --all-state for all-state access" >&2; exit 1; }
      valid_prefix "$2" || { echo "invalid read prefix" >&2; exit 1; }
      READ_PREFIXES_GIVEN=1
      READ_PREFIXES+=("$2")
      shift 2
      ;;
    --write-prefix)
      [ "$#" -ge 2 ] || usage
      [ -n "$2" ] || { echo "prefix cannot be empty; pass --all-state for all-state access" >&2; exit 1; }
      valid_prefix "$2" || { echo "invalid write prefix" >&2; exit 1; }
      WRITE_PREFIXES_GIVEN=1
      WRITE_PREFIXES+=("$2")
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done

case "$DATABASE" in
  -*)
    echo "database name cannot start with a hyphen" >&2
    exit 1
    ;;
esac

if [[ ! "$DATABASE" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "database name may contain only letters, numbers, dots, underscores, and hyphens" >&2
  exit 1
fi

if [ "$ALL_STATE" -eq 1 ] && { [ "$READ_PREFIXES_GIVEN" -eq 1 ] || [ "$WRITE_PREFIXES_GIVEN" -eq 1 ]; }; then
  echo "--all-state cannot be combined with --read-prefix or --write-prefix" >&2
  exit 1
elif [ "$ALL_STATE" -eq 1 ]; then
  READ_PREFIXES=("")
  WRITE_PREFIXES=("")
elif [ "$READ_PREFIXES_GIVEN" -ne 1 ] && [ "$WRITE_PREFIXES_GIVEN" -ne 1 ]; then
  echo "provide at least one --read-prefix or --write-prefix, or pass --all-state" >&2
  exit 1
fi

json_array() {
  "$NODE_BIN" -e 'process.stdout.write(JSON.stringify(process.argv.slice(1)))' -- "$@"
}

sql_literal() {
  local value="$1"
  value=${value//\'/\'\'}
  printf "'%s'" "$value"
}

OPENSSL_BIN="${OPENSSL_BIN:-openssl}"
NPX_BIN="${NPX_BIN:-npx}"
NODE_BIN="${NODE_BIN:-node}"

TOKEN=$("$OPENSSL_BIN" rand -hex 24)
HASH=$(printf %s "$TOKEN" | "$OPENSSL_BIN" dgst -sha256 -r | cut -d' ' -f1)
if [ "${#READ_PREFIXES[@]}" -eq 0 ]; then
  READ_PREFIX_JSON=$(json_array)
else
  READ_PREFIX_JSON=$(json_array "${READ_PREFIXES[@]}")
fi
if [ "${#WRITE_PREFIXES[@]}" -eq 0 ]; then
  WRITE_PREFIX_JSON=$(json_array)
else
  WRITE_PREFIX_JSON=$(json_array "${WRITE_PREFIXES[@]}")
fi
READ_PREFIX_SQL=$(sql_literal "$READ_PREFIX_JSON")
WRITE_PREFIX_SQL=$(sql_literal "$WRITE_PREFIX_JSON")
SQL="INSERT INTO machines (machine, token_hash, read_prefixes, write_prefixes, created_at) VALUES ('${MACHINE}', '${HASH}', ${READ_PREFIX_SQL}, ${WRITE_PREFIX_SQL}, strftime('%Y-%m-%dT%H:%M:%SZ','now'))"
if [ "$ROTATE" -eq 1 ]; then
  SQL+=" ON CONFLICT(machine) DO UPDATE SET token_hash=excluded.token_hash, read_prefixes=excluded.read_prefixes, write_prefixes=excluded.write_prefixes, created_at=excluded.created_at, revoked_at=NULL"
fi

cd "$(dirname "$0")/.."
COMMAND=("$NPX_BIN" wrangler d1 execute "$DATABASE")
COMMAND+=("$SCOPE")
if [ "$SCOPE" = "--remote" ]; then
  COMMAND+=(--yes)
fi
COMMAND+=(--command "$SQL")
WRANGLER_STDERR=$(mktemp "${TMPDIR:-/tmp}/agent-coord-wrangler-stderr.XXXXXX")
trap 'rm -f "$WRANGLER_STDERR"' EXIT
if ! "${COMMAND[@]}" 2>"$WRANGLER_STDERR"; then
  cat "$WRANGLER_STDERR" >&2
  echo "wrangler d1 execute failed while provisioning ${MACHINE}; see wrangler output above" >&2
  if grep -Eqi "PRIMARY KEY|constraint failed" "$WRANGLER_STDERR"; then
    echo "If this was a duplicate machine or token constraint, delete or update the existing D1 machines row before re-provisioning" >&2
  fi
  exit 1
fi
cat "$WRANGLER_STDERR" >&2
rm -f "$WRANGLER_STDERR"
trap - EXIT

echo "machine:  ${MACHINE}"
echo "reads:    ${READ_PREFIX_JSON}"
echo "writes:   ${WRITE_PREFIX_JSON}"
echo "token:    ${TOKEN}"
echo "Set on that machine:"
echo "  export AGENT_COORD_API_URL=<worker-url>"
echo "  export AGENT_COORD_API_TOKEN=${TOKEN}"
echo "Persist those values in \${AGENT_COORD_ENV_FILE:-~/.config/agent-coord/env} with mode 600, then restart consumers."
