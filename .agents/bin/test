#!/usr/bin/env bash
# Generated by shakacode/agent-workflows agent-workflow-seam-doctor --init.
set -euo pipefail
cd "$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"

unset AGENT_COORD_API_URL AGENT_COORD_API_TOKEN AGENT_COORD_STATE_ROOT
test_tmp_base="${TMPDIR:-/tmp}"
test_state_root="$(mktemp -d "${test_tmp_base%/}/agent-coordination-test.XXXXXX")"
trap 'rm -rf -- "$test_state_root"' EXIT
export AGENT_COORD_STATE_ROOT="$test_state_root"

for test_file in test/*_test.rb; do
  case "$test_file" in
    test/http_backend_integration_test.rb) continue ;;
  esac
  bundle exec ruby -Itest "$test_file" "$@"
done

bundle exec ruby sim/test/scripted_worker_test.rb "$@"
bundle exec ruby sim/test/race_test.rb "$@"
bundle exec ruby sim/test/verify_batch_test.rb "$@"
bundle exec ruby sim/test/llm_worker_test.rb "$@"
bundle exec ruby sim/test/graveyard_test.rb "$@"
bundle exec ruby sim/test/template_test.rb "$@"
