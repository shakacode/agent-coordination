#!/usr/bin/env bash
# Usage: sim/bin/seed <owner/repo> [--reset]
set -euo pipefail
REPO="${1:?usage: seed <owner/repo> [--reset]}"
RESET="${2:-}"
HERE="$(cd "$(dirname "$0")/.." && pwd)"
WORK="$(mktemp -d)"
ISSUE_PLAN="$(mktemp)"
cleanup() {
  rm -R -f "$WORK"
  rm -f "$ISSUE_PLAN"
}
trap cleanup EXIT

case "$REPO" in
  shakacode/agent-coord-sim-alpha | shakacode/agent-coord-sim-beta) ;;
  *)
    echo "refusing to overwrite non-simulation repo: $REPO" >&2
    echo "allowed repos: shakacode/agent-coord-sim-alpha, shakacode/agent-coord-sim-beta" >&2
    exit 1
    ;;
esac

python3 - "$HERE/issues.json" <<'PY'
import json
import sys
from collections import Counter

with open(sys.argv[1], encoding="utf-8") as handle:
    issues = json.load(handle)["issues"]

titles = [issue["title"] for issue in issues]
duplicates = [title for title, count in Counter(titles).items() if count > 1]
if duplicates:
    sys.stderr.write(
        "duplicate issue title(s) in sim/issues.json: " + ", ".join(duplicates) + "\n"
    )
    raise SystemExit(1)

# Titles and bodies cross into the shell as a NUL-delimited stream, so an
# embedded NUL in either would shift every subsequent title/body pairing and
# silently misassign the rest of the run.
embedded_nul = [
    issue["title"]
    for issue in issues
    if "\0" in issue["title"] or "\0" in issue["body"]
]
if embedded_nul:
    sys.stderr.write(
        "issue title(s)/body(ies) in sim/issues.json contain a NUL byte: "
        + ", ".join(repr(title) for title in embedded_nul)
        + "\n"
    )
    raise SystemExit(1)

# Titles are matched for dedupe and printed in diagnostics; a control line break
# would corrupt both.
malformed = [title for title in titles if any(ch in title for ch in "\t\r\n")]
if malformed:
    sys.stderr.write(
        "issue title(s) in sim/issues.json contain a tab or newline: "
        + ", ".join(repr(title) for title in malformed)
        + "\n"
    )
    raise SystemExit(1)
PY

cp -R "$HERE/template/." "$WORK/"
cd "$WORK"
git init -q -b main && git add -A
git commit -qm "Seed sim content $(date -u +%Y-%m-%dT%H:%M:%SZ)"
git remote add origin "https://github.com/$REPO"
git push -q --force origin main

if [ "$RESET" = "--reset" ]; then
  gh issue list --repo "$REPO" --label sim-batch --state open --limit 1000 --json number \
    --jq '.[].number' | while read -r n; do
    gh issue close "$n" --repo "$REPO" --comment "Reseeded." || true
  done
  # `gh issue list` is served by GitHub's search index, which lags behind the
  # closes above. Without this wait a just-closed issue can still be reported
  # open, its title is then treated as already seeded, and the repo is left
  # short an issue while the summary still claims a full seed.
  remaining=""
  attempt=0
  while [ "$attempt" -lt 20 ]; do
    attempt=$((attempt + 1))
    # Tolerate a transient gh failure here: this loop exists to wait out
    # eventual consistency, so a rate limit or network blip should be retried
    # rather than aborting the run under `set -e`.
    remaining="$(gh issue list --repo "$REPO" --label sim-batch --state open \
      --limit 1000 --json number --jq 'length' 2>/dev/null || true)"
    [ "$remaining" = "0" ] && break
    sleep 2
  done
  if [ "$remaining" != "0" ]; then
    echo "error: sim-batch issues are still reported open after reset" \
      "(last count: ${remaining:-unknown}). The search index is lagging, so seeding" \
      "would skip those titles and under-seed the repository. Re-run in a moment." >&2
    exit 1
  fi
  gh api --paginate "repos/$REPO/branches" --jq '.[].name' | { grep -v '^main$' || true; } | while read -r b; do
    gh api -X DELETE "repos/$REPO/git/refs/heads/$b" || true
  done
fi

gh label create sim-batch --repo "$REPO" --color 5319e7 \
  --description "Seeded simulation issue" 2>/dev/null || true

# Record numbers alongside titles so verification can read each issue directly
# instead of trusting the same search listing that produced the dedupe set.
existing_json="$WORK/existing.json"
gh issue list --repo "$REPO" --label sim-batch --state open --limit 1000 --json number,title \
  > "$existing_json"

# Match in Python against raw JSON rather than with `awk` over a tab-separated
# file: `awk -v` applies backslash-escape processing to the value it assigns and
# `==` coerces numeric-looking strings, so titles like `C:\temp` or `01` would
# mis-compare. Python compares decoded strings exactly, and a tab already
# present in a GitHub issue title cannot shift a field boundary because there
# are no fields.
python3 - "$HERE/issues.json" "$existing_json" > "$ISSUE_PLAN" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    issues = json.load(handle)["issues"]
with open(sys.argv[2], encoding="utf-8") as handle:
    existing = json.load(handle)

by_title = {}
for row in existing:
    by_title.setdefault(row["title"], str(row["number"]))

for issue in issues:
    number = by_title.get(issue["title"], "")
    sys.stdout.write(number + "\0" + issue["title"] + "\0" + issue["body"] + "\0")
PY

count=0
created=0
skipped=0

expected_numbers="$WORK/expected_numbers"
: > "$expected_numbers"

while IFS= read -r -d '' number && IFS= read -r -d '' TITLE && IFS= read -r -d '' BODY; do
  count=$((count + 1))
  if [ -n "$number" ]; then
    skipped=$((skipped + 1))
  else
    url="$(gh issue create --repo "$REPO" --title "$TITLE" --body "$BODY" --label sim-batch)"
    printf '%s\n' "$url"
    number="${url##*/}"
    created=$((created + 1))
  fi
  printf '%s\n' "$number" >> "$expected_numbers"
done < "$ISSUE_PLAN"

echo "SEEDED $REPO with $count issues ($created created, $skipped skipped)"

# Verify each expected issue with a direct object read. `gh issue view` hits
# `repos/:owner/:repo/issues/:number`, which is strongly consistent, unlike the
# `gh issue list` search index that can still report a closed issue as open.
missing=0
while IFS= read -r number; do
  state=""
  attempt=0
  while [ "$attempt" -lt 20 ]; do
    attempt=$((attempt + 1))
    state="$(gh issue view "$number" --repo "$REPO" --json state --jq '.state' 2>/dev/null || true)"
    [ -n "$state" ] && break
    sleep 2
  done
  if [ "$state" != "OPEN" ]; then
    echo "  not open: $REPO#$number (state: ${state:-unreadable})" >&2
    missing=$((missing + 1))
  fi
done < "$expected_numbers"

if [ "$missing" -ne 0 ]; then
  echo "error: $missing of $count seeded issue(s) are not open in $REPO" >&2
  exit 1
fi
