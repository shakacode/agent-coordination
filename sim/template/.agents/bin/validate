#!/usr/bin/env bash
set -euo pipefail
root="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$root"

# Keep this base-ref resolution aligned with .agents/bin/ci.
base_ref="${AGENT_SIM_BASE_REF:-}"
if [ -z "$base_ref" ] && [ -n "${GITHUB_BASE_REF:-}" ]; then
  git fetch --quiet origin "$GITHUB_BASE_REF"
  base_ref="$(git rev-parse FETCH_HEAD)"
elif [ -z "$base_ref" ] && [ "$(git branch --show-current)" != "main" ]; then
  if git rev-parse --verify -q main >/dev/null; then
    base_ref="main"
  elif git rev-parse --verify -q origin/main >/dev/null; then
    base_ref="origin/main"
  fi
fi

if [ -n "$base_ref" ]; then
  merge_base="$(git merge-base "$base_ref" HEAD)" || {
    printf 'Could not resolve simulation merge base.\n' >&2
    exit 1
  }
  ruby -ropen3 -rrbconfig -e '
    root, merge_base = ARGV
    output, error, status = Open3.capture3(
      "git", "-C", root, "diff", "--no-renames", "--name-only", "-z", merge_base
    )
    unless status.success?
      warn error unless error.empty?
      abort "Could not inspect simulation changes."
    end

    changed = output.dup.force_encoding(Encoding::UTF_8)
    abort "Changed simulation paths must be valid UTF-8." unless changed.valid_encoding?

    paths = changed.split("\0")
    if paths.empty?
      test_runner = File.join(root, ".agents/bin/test")
      exec [test_runner, test_runner]
    end

    task_path = %r{\Alib/task_[[:alnum:]_]+\.rb\z}
    invalid = paths.reject { |path| path.match?(task_path) }
    unless invalid.empty?
      warn "Unexpected changed files for single-task validation:"
      invalid.each { |path| warn path }
      exit 1
    end

    abort "Expected exactly one changed task file, found #{paths.length}." unless paths.one?

    task_name = paths.fetch(0).delete_prefix("lib/").delete_suffix(".rb")
    test_file = File.join("test", "#{task_name}_test.rb")
    abort "Expected matching test file for changed task: #{test_file}" unless File.file?(test_file)

    exec RbConfig.ruby, test_file
  ' "$root" "$merge_base"
  exit 0
fi

"$root/.agents/bin/test"
