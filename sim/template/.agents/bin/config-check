#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "open3"
require "rbconfig"
require "yaml"

root = File.expand_path("../..", __dir__)
base_ref = ARGV[0] or abort "usage: config-check <base_ref>"
allowed_paths = %w[
  .agents/agent-workflow.yml
  .agents/bin/README.md
  .agents/bin/ci
  .agents/bin/config-check
  .agents/bin/seam-guard
  .agents/bin/validate
  .github/workflows/seam-guard.yml
  AGENTS.md
]
task_path = %r{\Alib/task_[[:alnum:]_]+\.rb\z}
expected_validator_sha256 = "c56a7aea6284034237e7352b8de4739aea909739c5a5f81905d5722c6a12d47b"

base_commit, base_status = Open3.capture2("git", "-C", root, "rev-parse", "--verify", "#{base_ref}^{commit}")
abort "Could not resolve config-check base ref." unless base_status.success?
merge_base, merge_base_status = Open3.capture2("git", "-C", root, "merge-base", base_commit.strip, "HEAD")
abort "Could not resolve config-check merge base." unless merge_base_status.success?

changed_output, changed_status = Open3.capture2(
  "git", "-C", root, "diff", "--name-only", "-z", merge_base.strip
)
abort "Could not inspect simulation changes." unless changed_status.success?

changed_paths = changed_output.split("\0")
task_paths, non_task_paths = changed_paths.partition { |path| path.match?(task_path) }

validator = File.join(root, ".agents/bin/validate")
validator_sha256 = Digest::SHA256.file(validator).hexdigest
abort "Simulation validator does not match the checked contract." unless validator_sha256 == expected_validator_sha256

unless task_paths.empty?
  abort "Task changes cannot be combined with config or unrelated paths: #{non_task_paths.join(', ')}" unless non_task_paths.empty?

  puts "TASK_ONLY"
  exit 0
end

unexpected_paths = non_task_paths - allowed_paths
abort "Unexpected config-only paths: #{unexpected_paths.join(', ')}" unless unexpected_paths.empty?

scripts = [
  validator,
  File.join(root, ".agents/bin/ci"),
  File.join(root, ".agents/bin/test")
]
abort "Simulation command scripts must remain executable." unless scripts.all? { |script| File.executable?(script) }
abort "Invalid shell syntax in simulation command scripts." unless scripts.all? { |script| system("bash", "-n", script) }
ruby_scripts = [__FILE__, File.join(root, ".agents/bin/seam-guard")]
abort "Simulation guard scripts must remain executable." unless ruby_scripts.all? { |script| File.executable?(script) }
abort "Invalid Ruby syntax in simulation guard scripts." unless ruby_scripts.all? do |script|
  system(RbConfig.ruby, "-c", script, out: File::NULL, err: File::NULL)
end

agents = File.read(File.join(root, "AGENTS.md"))
heading = "## Agent Workflow Configuration"
section_start = agents.index(heading)
abort "Missing canonical Agent Workflow Configuration pointer." unless section_start

expected_pointer = <<~MARKDOWN.chomp
  ## Agent Workflow Configuration

  Portable shared skills resolve this repo's commands and policy through:
  - **Commands** — run `.agents/bin/<name>` (`setup`, `validate`, `test`, ...); see `.agents/bin/README.md`. A missing script means that capability is n/a here.
  - **Policy / config** — `.agents/agent-workflow.yml`.
MARKDOWN
actual_pointer = agents[section_start..].rstrip
abort "Agent Workflow Configuration pointer is not canonical." unless actual_pointer == expected_pointer

policy = YAML.safe_load(File.read(File.join(root, ".agents/agent-workflow.yml")), aliases: false)
abort "Agent workflow policy must be a YAML mapping." unless policy.is_a?(Hash)

readme = File.read(File.join(root, ".agents/bin/README.md"))
required_readme_rows = [
  "| `validate` | Sim-aware gate: one task file runs its matching test; task/config mixes and unrelated diffs are rejected. |",
  "| `config-check` | Validate allowed config-only paths, canonical seam content, policy YAML, and script syntax. |",
  "| `seam-guard` | Base-trusted pull-request guard; rejects changes to CI and validator entrypoints before head code runs. |"
]
abort "Simulation command README does not document config-only validation." unless required_readme_rows.all? { |row| readme.include?(row) }

puts changed_paths.empty? ? "NO_CHANGES" : "CONFIG_ONLY"
