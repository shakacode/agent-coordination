  ].freeze
  # `scheme://` followed by an authority that ends in `@`. The authority stops
  # at the first `/`, `?`, or `#`, so an `@` in a path or query is never
  # mistaken for credentials.
  URL_USERINFO_PREFIX = %r{\A((?:[a-zA-Z][a-zA-Z0-9+.-]*://)?)[^/?\#\s]*@}
  # Unanchored twin for prose. URI::InvalidURIError embeds the offending URL in
  # its message, so a malformed configured value would otherwise reach stderr
  # with its userinfo intact -- the anchored form cannot match mid-sentence.
  # An explicit scheme makes username-only userinfo unambiguous; the scheme-less
  # branch still requires a colon so ordinary email addresses remain readable.
  URL_USERINFO_ANYWHERE = %r{
    (?:(?:([a-zA-Z][a-zA-Z0-9+.-]*://)[^\s/?\#"'@]*@)|(?:\b[^\s/?\#"'@:]*:[^\s/?\#"'@]*@))
  }x
  USER_CONFIG_ENV_KEYS = %w[
    AGENT_COORD_API_URL
    AGENT_COORD_API_TOKEN
    AGENT_COORD_MACHINE_ID
    AGENT_COORD_BACKEND
    AGENT_COORD_REF
    AGENT_COORD_STATE_ROOT
    AGENT_COORD_STATUS_STATE_ROOT
    AGENT_COORD_LOCAL
    AGENT_COORD_POLICY
  ].freeze
  ABSOLUTE_USER_CONFIG_PATH_KEYS = %w[
    AGENT_COORD_STATE_ROOT
    AGENT_COORD_STATUS_STATE_ROOT
  ].freeze
  SESSION_SOURCE_AGENT_COORD = "agent_coord_session_id"
  SESSION_SOURCE_CODEX = "codex_thread_id"
  SESSION_SOURCE_UNSET = "unset"
  MACHINE_MATCH_MATCH = "match"
  MACHINE_MATCH_MISMATCH = "mismatch"
  MACHINE_MATCH_UNVERIFIED = "unverified"
  JSON_PREFIXES = %w[claims heartbeats batches].freeze
  STATE_PREFIXES = (JSON_PREFIXES + %w[events archive]).freeze
  STATE_PATH_PATTERN = %r{\A(?:
    claims/[A-Za-z0-9_.:-]+/[A-Za-z0-9_.:-]+/[A-Za-z0-9_.:-]+\.json |
    heartbeats/[A-Za-z0-9_.:-]+\.json |
    batches/[A-Za-z0-9_.:-]+\.json |
    events/[A-Za-z0-9_.:-]+/[A-Za-z0-9_.:-]+\.json |
    archive/(?:(?:
      claims/[A-Za-z0-9_.:-]+/[A-Za-z0-9_.:-]+/[A-Za-z0-9_.:-]+\.json |
      heartbeats/[A-Za-z0-9_.:-]+\.json |
      batches/[A-Za-z0-9_.:-]+\.json |
      events/[A-Za-z0-9_.:-]+/[A-Za-z0-9_.:-]+\.json
    ))
  )\z}x
  STATE_DIRECTORY_PREFIX_PATTERN = %r{\A(?:
    claims(?:/[A-Za-z0-9_.:-]+(?:/[A-Za-z0-9_.:-]+)?)? |
    heartbeats |
    batches |
    events(?:/[A-Za-z0-9_.:-]+)? |
    archive(?:/(?:
      claims(?:/[A-Za-z0-9_.:-]+(?:/[A-Za-z0-9_.:-]+)?)? |
      heartbeats |
      batches |
      events(?:/[A-Za-z0-9_.:-]+)?
    ))?
  )\z}x
  # Canonical heartbeat/event status vocabulary. Multi-word values are
  # snake_case, matching the published in_progress schema example. Working
  # statuses keep a lane hot and visible; terminal statuses mean the owner is
  # finished with the lane and will not renew the heartbeat again. This is a
  # different axis from the lane-closure TERMINAL_STATES reasons above, though
  # the two stay coherent (done/abandoned/superseded appear in both).
  HEARTBEAT_WORKING_STATUSES = %w[
    in_progress blocked blocked_user_input waiting_on_checks_or_review external_gate_failing no_pr_evidence failed
  ].freeze
  HEARTBEAT_TERMINAL_STATUSES = %w[
    done merged ready ready_gates_clean ready_no_merge_authority abandoned superseded
  ].freeze
  HEARTBEAT_STATUSES = (HEARTBEAT_WORKING_STATUSES + HEARTBEAT_TERMINAL_STATUSES).freeze
  # Known synonyms coerced to canonical statuses at write time, applied after
  # case and hyphen/underscore folding. Values that resolve to neither the
  # canonical vocabulary nor this map warn on stderr and are preserved
  # verbatim alongside a status_raw copy.
  # "released" is deliberately absent: a released heartbeat can mean a claim
  # handoff rather than completion (see the released-dependency contract test),
  # so it takes the warn-and-preserve path instead of coercing to done.
  HEARTBEAT_STATUS_ALIASES = {
    "complete" => "done",
    "completed" => "done",
    "ready_to_merge" => "ready",
    "ready_handoff" => "ready",
    "ready_for_coordinator" => "ready",
    "in_process" => "in_progress",
    "claimed" => "in_progress",
    "implementing" => "in_progress",
    "validating" => "in_progress",
    "pushing" => "in_progress"
  }.freeze
  # Heartbeat statuses that satisfy a lane dependency: canonical terminal
  # statuses except abandoned/superseded (they end a lane without completing
  # it), plus legacy synonyms still present in rows written before write-time
  # status coercion existed.
  # Legacy "released" rows stay excluded: a released claim can mean handoff
  # without completion, and prematurely unblocking dependents is the riskier
  # misread of an ambiguous historical row.
  DEPENDENCY_DONE_STATUSES = ((HEARTBEAT_TERMINAL_STATUSES - %w[abandoned superseded]) + %w[complete completed]).freeze
  STATUS_BATCH_METADATA_FIELDS = %w[
    repo objective instructions launch_prompt operator dashboard_url status updated_at registered_at completed_at
    synthetic synthetic_kind
  ].freeze
  STATUS_LANE_METADATA_FIELDS = %w[
    thread_handle chat_handle host pr_url dashboard_url operator phase branch terminal closed_at closed_by
    pr_state evidence_url
  ].freeze
  STATUS_CLAIM_METADATA_FIELDS = %w[
    batch_id thread_handle chat_handle host machine_id session_id session_source pr_url dashboard_url operator
    phase generation instance_id
    release_mode handoff_to handoff_note terminal pr_state evidence_url workspace closed_by synthetic synthetic_kind
  ].freeze
  STATUS_HEARTBEAT_METADATA_FIELDS = %w[
    batch_id branch thread_handle chat_handle host machine_id session_id session_source pr_url dashboard_url
    operator phase generation instance_id status_raw
    synthetic synthetic_kind
  ].freeze
  STATUS_EVENT_METADATA_FIELDS = %w[
    event_id lane agent_id repo target branch status status_raw message thread_handle chat_handle host machine_id
    session_id session_source pr_url dashboard_url
    operator phase previous_phase generation instance_id release_mode handoff_to handoff_note terminal pr_state
    evidence_url
    workspace closed_by
    reason from_route to_route evidence severity category kind
    synthetic synthetic_kind
  ].freeze
  # Typed operational-signal event vocabulary (issue #77). Each name is a
  # first-class `record-event --type` value whose required fields are validated
  # at write time; any other --type value stays allowed and unvalidated. These
  # are payload fields only and never become path segments.
  TYPED_EVENT_PAYLOAD_FIELDS = %w[reason from_route to_route evidence severity category kind].freeze
  # Typed payload fields that belong to each typed --type. A typed event rejects
  # any TYPED_EVENT_PAYLOAD_FIELDS value outside its own set (message is a general
  # field, not a typed field, so it is unaffected). Keys are exactly the four
  # typed types; arbitrary --type values ignore typed fields as before.
  TYPED_EVENT_ALLOWED_FIELDS = {
    "help_requested" => %w[reason],
    "escalation_requested" => %w[from_route to_route evidence],
    "error" => %w[severity category],
    "human_intervention" => %w[kind]
  }.freeze
  HELP_REQUESTED_REASONS = %w[blocked-user-input question permission].freeze
  ERROR_SEVERITIES = %w[P0 P1 P2 P3].freeze
  HUMAN_INTERVENTION_KINDS = %w[takeover supersede manual-fix drain].freeze
  HEARTBEAT_TARGET_FIELDS = %w[repo target].freeze
  METADATA_OPTION_FIELDS = %w[
    thread_handle chat_handle host pr_url dashboard_url operator phase generation instance_id
    synthetic synthetic_kind
  ].freeze
  HANDOFF_STATE_FIELDS = %w[
    release_mode handoff_to handoff_note
  ].freeze
  HANDOFF_OPTION_FIELDS = %w[
    handoff_to handoff_note
  ].freeze
  CLAIM_PRESERVED_FIELDS = (%w[batch_id branch] + STATUS_CLAIM_METADATA_FIELDS).uniq.freeze
  # status_raw sits in STATUS_HEARTBEAT_METADATA_FIELDS for status --json
  # projection only. Its resulting membership here is inert: heartbeat writes
  # merge status_attribution_payload after the preserved payload, so the
  # current write always decides status_raw and a preserved value never
  # survives. Do not rely on status_raw preservation when reordering that
  # merge chain.
  HEARTBEAT_PRESERVED_FIELDS = (HEARTBEAT_TARGET_FIELDS + STATUS_HEARTBEAT_METADATA_FIELDS).uniq.freeze
  EXIT_USAGE = 1
  STACK_EXIT_USAGE = 64
  EXIT_OPERATIONAL = 2
  EXIT_CLAIM_REFUSED = 3
  EXIT_CODES = {
    "usage" => EXIT_USAGE,
    "stack_usage" => STACK_EXIT_USAGE,
    "operational" => EXIT_OPERATIONAL,
    "claim_refused" => EXIT_CLAIM_REFUSED
  }.freeze
  # batch-audit verdict -> process exit code. 0 when every registered lane is
  # telemetry-complete; 1 when gaps are found so closeout can fail-closed; 2
  # (EXIT_OPERATIONAL) when coordination state is UNKNOWN (unregistered or
  # unreadable batch), matching the repo convention that exit 2 means UNKNOWN.
  BATCH_AUDIT_EXIT_CODES = {
    "complete" => 0,
    "incomplete" => 1,
    "unknown" => EXIT_OPERATIONAL
  }.freeze
  # Column contract for `agent-coord log` (issue #129). `detail` carries free
  # text so it stays last, and `host_raw` preserves the unnormalized host beside
  # the family the trail groups on.
  LOG_TSV_FIELDS = %w[
    at machine host work_item type phase agent_id batch_id detail host_raw event_id synthetic synthetic_kind
  ].freeze
  LOG_TEXT_COLUMNS = %w[at machine host work_item type phase agent_id].freeze
  # Options that narrow the trail. Suppressing the claim fallback and rejecting a
  # narrowed --sync are the same question -- "was this answer filtered?" -- so
  # they read one list and a new filter cannot be added to only one of them.
  LOG_TRAIL_FILTERS = %i[since machine host type limit].freeze
  # Where gc puts a completed lane's events once it has compacted them and
  # deleted the hot copies. The trail is read from here as well as from `events`,
  # because a custody trail that ends when the work completes is the one case it
  # was written to answer.
  LOG_ARCHIVED_EVENTS_PREFIX = "archive/events"
  # The degradation reason for a prefix the backend does not implement, named so
  # the listing that classifies it and the caller that decides what it means
  # cannot drift apart.
  LOG_UNSUPPORTED_REASON = "not supported by backend"
  LOG_SYNC_FILENAME = "log.tsv"
  LOG_SYNC_LOCK_SUFFIX = ".lock"
  # C0 controls and DEL, minus the tab/CR/LF handled separately above. Text and
  # tsv go straight to a terminal, where an escape sequence from a recorded
  # message could clear or rewrite the trail being read. JSON is left alone: its
  # encoder escapes these already.
  LOG_CONTROL_CHARACTERS = /[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F\u0080-\u009F]/
  LOG_UNKNOWN = "?"
  # Issues and pull requests share one number sequence per repository, so
  # `319`, `issue:319`, and `pr:319` are the same item and the prefix is
  # decoration. `adhoc` is not that space: its ids are operator-chosen slugs, so
  # it is folded only where it cannot collide with a GitHub number.
  WORK_ITEM_GITHUB_KINDS = %w[issue pr].freeze
  WORK_ITEM_KINDS = (WORK_ITEM_GITHUB_KINDS + ["adhoc"]).freeze
  WORK_ITEM_NUMBER = /\A\d+\z/
  LOG_SINCE_UNITS = { "m" => 60, "h" => 3600, "d" => 86_400, "w" => 604_800 }.freeze
  BATCH_AUDIT_TERMINAL_REQUIRED_FACT_FIELDS = %w[event_id repo target terminal workspace at].freeze
  BATCH_AUDIT_TERMINAL_OPTIONAL_FACT_FIELDS = %w[
    batch_id lane agent_id branch pr_url pr_state evidence_url
  ].freeze
  BATCH_AUDIT_ORDINARY_LIFECYCLE_TYPES = %w[
    claim.acquired claim.released phase.changed
  ].freeze
  BATCH_AUDIT_ORDINARY_REQUIRED_FACT_FIELDS = %w[event_id batch_id agent_id at].freeze
  BATCH_AUDIT_ORDINARY_OPTIONAL_IDENTITY_FIELDS = %w[lane repo target].freeze
  RFC3339_PATTERN = /
    \A
    (?<year>\d{4})-(?<month>\d{2})-(?<day>\d{2})
    [Tt](?<hour>\d{2}):(?<minute>\d{2}):(?<second>\d{2})(?:\.\d+)?
    (?:[Zz]|[+-](?<offset_hour>\d{2}):(?<offset_minute>\d{2}))
    \z
  /x

  class Error < StandardError
    attr_reader :exit_code

    def initialize(message, exit_code: EXIT_USAGE)
      super(message)
      @exit_code = exit_code
    end
  end

  class OperationalError < Error
    def initialize(message, exit_code: EXIT_OPERATIONAL)
      super
    end
  end

  class ClaimRefused < Error
    def initialize(message, exit_code: EXIT_CLAIM_REFUSED)
      super(message.start_with?("CLAIM_REFUSED") ? message : "CLAIM_REFUSED: #{message}", exit_code: exit_code)
    end
  end

  class PathValidationError < Error
  end

  class Conflict < OperationalError
  end

  # Records the long-option declaration shapes used by this CLI so pre-parse
  # token detection can share its registered option names.
  class OptionRegistry
    attr_reader :value_options, :flag_options, :path_options

    def initialize(parser)
      @parser = parser
      @value_options = []
      @flag_options = []
      @path_options = []
    end

    def on(*declarations, &)
      @parser.on(*declarations, &)
      # This is a narrow extractor, not a parser for every OptionParser declaration form.
      # Before adding optional arguments or a non-first long switch, update this grammar
      # and its token-detection tests together.
      long_declaration = declarations.find { |declaration| declaration.is_a?(String) && declaration.start_with?("--") }
      if long_declaration
        option_name, argument = long_declaration.split(/\s+/, 2)
        target = argument ? @value_options : @flag_options
        target << option_name
        # A PATH placeholder is the declaration saying this value addresses the
        # filesystem. Those values are handed to syscalls rather than serialized,
        # so argv normalization has to leave their bytes alone.
        #
        # DECLARING A NEW PATH-VALUED OPTION: its placeholder must start with
        # PATH (`--archive-dir PATH`), because this match is on the placeholder
        # spelling, not on a type. `--archive-dir DIR`, `FILE`, `ROOT`, or
        # `[PATH]` is silently NOT exempted and its value is transcoded, which
        # changes which file it names; `--archive-dir=PATH` is not even seen as
        # a value option by the grammar above. Nothing fails loudly if you get
        # this wrong, so match the spelling.
        @path_options << option_name if argument.to_s.start_with?("PATH")
      end
      @parser
    end

    def banner=(value)
      @parser.banner = value
    end

    def separator(*)
      @parser.separator(*)
    end

    def long_options
      value_options + flag_options
    end

    def to_s
      @parser.to_s
    end
  end

  StoredJson = Struct.new(:path, :data, :sha, keyword_init: true)
  # Per-lane attribution context for batch-audit. `targets` is the lane's full
  # declared target list; `unique_targets` is the subset that maps to exactly one
  # lane in the batch. Grouping these keeps the event matcher within the argument
  # limit while carrying both the unique-target fast path and the full target list
  # the owner fallback needs for its in-lane membership check.
  BatchAuditLane = Struct.new(
    :batch_id, :name, :targets, :unique_targets, :owner, :owner_unique, keyword_init: true
  )
  DemoClock = Struct.new(:time) do
    def now
      time
    end
  end
  DemoResult = Struct.new(:code, :stdout, :stderr, keyword_init: true)

  class Runner # rubocop:disable Metrics/ClassLength
    # Every collaborator is an injectable keyword with the process default, so
    # tests never have to reach into private state. That is one keyword past the
    # metric's limit; splitting the seam into a bag would only hide it.
    def initialize(argv, stdin: $stdin, stdout: $stdout, stderr: $stderr, clock: Time, # rubocop:disable Metrics/ParameterLists
                   backend_conflict_warnings: true)
      @stdin = stdin
      @stdout = stdout
      @stderr = stderr
      @clock = clock
      @backend_conflict_warnings = backend_conflict_warnings
      # Set on the first degraded listing; read by both the --sync guard and the
      # --json trail state, so it must exist before either runs.
      @log_incomplete = nil
      # Last: rejecting an argument builds an option registry to resolve its
      # exit code, and nothing above depends on argv.
      @argv = normalized_argv(argv)
    end

    # Commands that provably consult neither @user_config nor @process_config
    # nor anything derived from them: the resolved backend, ref, policy, machine
    # identity, or the saved settings load_user_configuration! injects into ENV.
    # `version` renders constants only, and `bootstrap` copies a file and edits a
    # shell profile; neither is a backend_command?, so neither resolves a
    # selector, and both are the commands an operator reaches for while a broken
    # config is exactly what they are trying to repair.
    #
    # `demo` qualifies for the same reason once with_demo_isolated_env is in
    # place: its own dispatch reads nothing, and its nested runs deliberately
    # read a config home inside the demo's temporary root rather than the
    # operator's.
    #
    # This is an explicit allowlist, not an inferred or negative rule, so a new
    # command defaults to loading. Skipping the load for a command that does read
    # configuration would silently ignore the operator's configured backend,
    # which is far worse than failing on a config that cannot be read. Do not add
    # an entry without tracing the command's whole dispatch path.
    CONFIG_INDEPENDENT_COMMANDS = %w[version bootstrap demo].freeze
    KNOWN_COMMANDS = %w[
      claim release heartbeat register-batch record-event status log batch-audit
      gc version config doctor bootstrap demo
    ].freeze

    def run # rubocop:disable Metrics/CyclomaticComplexity
      return print_help if @argv.empty? || help_request?(@argv.first)

      command = @argv.shift
      config_action = command == "config" && %w[show set].include?(@argv.first) ? @argv.shift : nil
      raise Error, "unknown command: #{command}" unless KNOWN_COMMANDS.include?(command)

      load_user_configuration_unless_exempt!(command, config_action)
      case command
      when "claim"
        claim(parse_options(command, @argv))
      when "release"
        release(parse_options(command, @argv))
      when "heartbeat"
        heartbeat(parse_options(command, @argv))
      when "register-batch"
        register_batch(parse_options(command, @argv))
      when "record-event"
        record_event(parse_options(command, @argv))
      when "status"
        render_status(parse_options(command, @argv))
      when "log"
        render_log(parse_options(command, @argv, positional: :work_item))
      when "batch-audit"
        batch_audit(parse_options(command, @argv))
      when "gc"
        gc(parse_options(command, @argv))
      when "version"
        render_version(parse_options(command, @argv))
      when "config"
        if config_action == "set"
          persist_config(parse_options("config-set", @argv))
        else
          render_config(parse_options(command, @argv))
        end
      when "doctor"
        run_doctor_command(command)
      when "bootstrap"
        bootstrap(parse_options(command, @argv))
      when "demo"
        demo(@argv)
      else
        raise Error, "unknown command: #{command}"
      end
    rescue OptionParser::ParseError => e
      raise Error, e.message
    ensure
      restore_injected_user_configuration!
    end

    private

    # `config`'s subcommand has to be resolved before the load, because whether
    # it is `set` decides whether a missing explicit config file is tolerated.
    def load_user_configuration_unless_exempt!(command, config_action)
      return if CONFIG_INDEPENDENT_COMMANDS.include?(command)
      return if subcommand_help_request?(command, config_action)

      load_user_configuration!(creating_user_config: config_action == "set")
    end

    # OptionParser accepts help flags anywhere in the option stream. Detect the
    # same standalone tokens before loading configuration, without confusing a
    # positional "help", an option value, or a post-`--` literal for help.
    def subcommand_help_request?(command, config_action)
      parser_command = config_action == "set" ? "config-set" : command
      requested = false
      scan_raw_options(@argv, command: parser_command) do |_index, option, value_of, awaits_value, inline_value|
        requested ||= value_of.nil? && !awaits_value && inline_value.nil? && %w[-h --help].include?(option)
      end
      requested
    end

    # Runner#run temporarily injects canonical user settings into process-wide
    # ENV. In-process callers must serialize run invocations; normal CLI use is
    # one process per invocation.
    #
    # `creating_user_config` is set only by `config set`, the one command whose
    # job is to bring the file into existence. See read_selected_user_configuration.
    def load_user_configuration!(creating_user_config: false)
      @creating_user_config = creating_user_config
      @process_config = USER_CONFIG_ENV_KEYS.to_h { |key| [key, ENV.fetch(key, nil)] }
      process_policy = @process_config.fetch(POLICY_ENV, nil)
      # An exported-but-blank AGENT_COORD_POLICY is unset, exactly as an empty
      # one already was. Validating it instead failed every command with
      # "invalid coordination policy" while the injection below was busy
      # treating the same value as absent and publishing the saved policy.
      validate_policy!(process_policy, "process environment:#{POLICY_ENV}") if policy_supplied?(process_policy)
      @user_config_path, @user_config_path_explicit = selected_user_config_path
      @policy_file_path = legacy_policy_file_path
      @user_config = {}
      @policy_file_value = nil
      with_optional_config_read_lock do
        @user_config = read_selected_user_configuration
        user_policy = @user_config.fetch(POLICY_ENV, nil)
        if @policy_file_path && !policy_supplied?(process_policy) && !policy_supplied?(user_policy)
          @policy_file_value = read_policy_file(@policy_file_path)
        end
      end
      @injected_user_config_keys = []

      @user_config.each do |key, value|
        next if key == "AGENT_COORD_API_TOKEN"
        # A whitespace-only process value is not a selection: the downstream
        # readers strip before testing for empty, so treating it as present here
        # would drop the saved value without anything taking its place.
        next unless AgentCoord.environment_identity_value(key, env: @process_config).nil?

        ENV[key] = value
        @injected_user_config_keys << key
      end
      return if policy_supplied?(@process_config[POLICY_ENV])
      return if policy_supplied?(@user_config.fetch(POLICY_ENV, nil))
      return unless @policy_file_value

      ENV[POLICY_ENV] = @policy_file_value
      @injected_user_config_keys << POLICY_ENV unless @injected_user_config_keys.include?(POLICY_ENV)
    end

    # The policy is an AGENT_COORD_* setting like any other, so "supplied" means
    # the same thing here that it does for a backend selector or the ref.
    def policy_supplied?(value)
      AgentCoord.config_value_set?(value)
    end

    # The legacy policy file is a compatibility fallback for the conventional
    # <config home>/agent-coord/env layout only. AGENT_COORD_ENV_FILE can point
    # at a shared directory, where an unrelated sibling named "policy" would
    # otherwise be parsed and subjected to the 0600 checks, failing every command
    # despite a perfectly valid explicit config. An explicit path is the whole
    # distinction, so gate on the flag rather than on the path's spelling: a
    # shared layout is free to mirror the conventional directory names. The
    # remaining path is derived by selected_user_config_path as
    # <config home>/agent-coord/env, so the sibling is always the conventional one.
    def legacy_policy_file_path
      return nil unless @user_config_path
      return nil if @user_config_path_explicit

      File.join(File.dirname(@user_config_path), "policy")
    end

    # An explicit AGENT_COORD_ENV_FILE that does not exist is normally a loud
    # failure: silently falling back to a different config would use a backend
    # the operator did not select. `config set` is the exception, because the
    # documented first-time setup points AGENT_COORD_ENV_FILE at a path and then
    # runs `config set` to create it. Only *missing* is relaxed, and only here;
    # a file that exists but is insecure, unreadable, or malformed still fails
    # closed for `config set` too, so the command can never discard one.
    def read_selected_user_configuration
      return {} unless @user_config_path

      read_user_env_file(@user_config_path, required: @user_config_path_explicit && !@creating_user_config)
    end

    def restore_injected_user_configuration!
      Array(@injected_user_config_keys).each do |key|
        process_value = @process_config&.fetch(key, nil)
        process_value.nil? ? ENV.delete(key) : ENV[key] = process_value
      end
      @injected_user_config_keys = []
    end

    def selected_user_config_path
      configured = ENV.fetch("AGENT_COORD_ENV_FILE", "")
      if AgentCoord.config_value_set?(configured)
        unless Pathname.new(configured).absolute?
          raise OperationalError, "AGENT_COORD_ENV_FILE must be an absolute path"
        end

        return [File.expand_path(configured), true]
      end

      config_home = ENV.fetch("XDG_CONFIG_HOME", "")
      if config_home.empty?
        home = ENV.fetch("HOME", "")
        return [nil, false] if home.empty?

        config_home = File.join(home, ".config")
      end
      raise OperationalError, "XDG_CONFIG_HOME must be an absolute path" unless Pathname.new(config_home).absolute?

      [File.join(File.expand_path(config_home), "agent-coord", "env"), false]
    end

    def read_user_env_file(path, required:)
      contents = read_private_config_file(path, required:)
      return {} unless contents

      parse_user_env(contents.lines(chomp: true), path)
    end

    def read_private_config_file(path, required:)
      File.open(path, File::RDONLY | File::NOFOLLOW | File::NONBLOCK) do |file|
        validate_private_config_file!(file, path)
        contents = file.read.dup.force_encoding(Encoding::UTF_8)
        raise OperationalError, "user config contains invalid UTF-8: #{path}" unless contents.valid_encoding?

        contents
      end
    rescue Errno::ENOENT
      raise OperationalError, "configured user env file does not exist: #{path}" if required

      nil
    rescue Errno::ELOOP
      raise OperationalError, "user config must be a regular file, not a symlink: #{path}"
    rescue SystemCallError => e
      raise OperationalError, "cannot read user config #{path}: #{e.message}"
    end

    def validate_private_config_file!(file, path)
      stat = file.stat
      raise OperationalError, "user config must be a regular file: #{path}" unless stat.file?
      raise OperationalError, "user config is not owned by the current user: #{path}" unless stat.uid == Process.uid
      unless stat.mode.nobits?(0o077)
        raise OperationalError, "user config permissions are insecure (expected 0600): #{path}"
      end

      validate_secure_directory_chain!(
        File.dirname(path),
        create: false,
        private_leaf: dedicated_user_config_parent?
      )
    end

    def parse_user_env(lines, path)
      values = {}
      lines.each_with_index do |line, index|
        stripped = line.strip
        next if stripped.empty? || stripped.start_with?("#")

        assignment = line.lstrip.sub(/\Aexport\s+/, "")
        match = assignment.match(/\A([A-Z][A-Z0-9_]*)=(.*)\z/)
        raise OperationalError, "unsafe user config syntax at #{path}:#{index + 1}" unless match

        key = match[1]
        unless USER_CONFIG_ENV_KEYS.include?(key)
          next unless key.start_with?("AGENT_COORD_")

          raise OperationalError, "unsupported agent-coord key at #{path}:#{index + 1}: #{key}"
        end
        raise OperationalError, "duplicate user config key at #{path}:#{index + 1}: #{key}" if values.key?(key)

        values[key] = parse_env_assignment_value(match[2], path, index + 1)
      end
      user_policy = values.fetch(POLICY_ENV, nil)
      validate_policy!(user_policy, "#{path}:AGENT_COORD_POLICY") if policy_supplied?(user_policy)
      validate_user_config_paths!(values, path)
      values
    end

    def validate_user_config_paths!(values, path)
      ABSOLUTE_USER_CONFIG_PATH_KEYS.each do |key|
        value = values.fetch(key, nil)
        next unless AgentCoord.config_value_set?(value)
        next if Pathname.new(value).absolute?

        raise OperationalError, "#{key} in #{path} must be an absolute path"
      end
    rescue ArgumentError
      raise OperationalError, "user config path in #{path} must be an absolute path"
    end

    def parse_env_assignment_value(raw, path, line_number)
      return "" if raw.empty?

      uncommented = strip_env_assignment_comment(raw)
      words = Shellwords.shellsplit(uncommented)
      return "" if words.empty? && uncommented != raw

      raise OperationalError, "ambiguous user config value at #{path}:#{line_number}" unless words.length == 1

      words.first
    rescue ArgumentError
      raise OperationalError, "unsafe user config value at #{path}:#{line_number}"
    end

    # Shellwords deliberately does not interpret comments. Remove only an
    # unquoted, unescaped `#` that begins after whitespace, preserving literal
    # fragments such as `=#value`, quoted hashes, and escaped spaces/hashes.
    def strip_env_assignment_comment(raw)
      quote = nil
      escaped = false
      word_boundary = false
      # rubocop:disable Metrics/BlockLength -- explicit shell-lexing states are clearer kept together
      raw.each_char.with_index do |character, index|
        if escaped
          escaped = false
          word_boundary = false
          next
        end

        if quote
          if character == "\\" && quote == '"'
            escaped = true
          elsif character == quote
            quote = nil
          end
          next
        end

        case character
        when "\\"
          escaped = true
          word_boundary = false
        when '"', "'"
          quote = character
          word_boundary = false
        when /\s/
          word_boundary = true
        when "#"
          return raw[0...index] if word_boundary

          word_boundary = false
        else
          word_boundary = false
        end
      end
      # rubocop:enable Metrics/BlockLength
      raw
    end

    def read_policy_file(path)
      contents = read_private_config_file(path, required: false)
      return nil unless contents

      value = contents.strip
      validate_policy!(value, path)
      value
    end

    def validate_policy!(value, source)
      return if COORDINATION_POLICIES.include?(value)

      raise OperationalError,
            "invalid coordination policy in #{source}: expected #{COORDINATION_POLICIES.join(', ')}"
    end

    # The process tier wins only when it actually carries a value. This is the
    # same rule load_user_configuration! already applies when deciding whether
    # to inject a saved setting into ENV, and the two must not disagree: with a
    # saved AGENT_COORD_REF=configured-ref and an exported AGENT_COORD_REF='   ',
    # injection treated the process value as unset and published the saved ref,
    # while this reader spelled emptiness without stripping, returned the blank,
    # and GitHub-backed commands then requested `git/trees/   ` -- doctor probed
    # a ref no repository has. A blank is not a value at all; which tier a real
    # ref should follow is a separate question (issue #189).
    def effective_config_value(key)
      process_value = @process_config&.fetch(key, nil)
      return process_value if AgentCoord.config_value_set?(process_value)

      @user_config&.fetch(key, nil)
    end

    # A whitespace-only selector is not a selection. The CLI flags reject such a
    # value outright, so treating an exported AGENT_COORD_STATE_ROOT='   ' as a
    # process-tier selection would let the environment shadow a configured
    # backend in a way the equivalent flag cannot. Both the resolver and
    # `config show` pick their tier here, so they cannot disagree about which
    # tier is in play.
    def process_selects_backend?
      BACKEND_SELECTOR_ENV_KEYS.any? do |key|
        AgentCoord.config_value_set?(@process_config&.fetch(key, nil))
      end
    end

    def effective_backend_env_value(key)
      source = process_selects_backend? ? @process_config : @user_config
      source&.fetch(key, nil)
    end

    def backend_env_source
      process_selects_backend? ? "process_env" : "user_config"
    end

    def effective_policy
      process_policy = @process_config&.fetch(POLICY_ENV, nil)
      return [process_policy, "process_env"] if policy_supplied?(process_policy)

      user_policy = @user_config&.fetch(POLICY_ENV, nil)
      return [user_policy, "user_config"] if policy_supplied?(user_policy)
      return [@policy_file_value, "policy_file"] if @policy_file_value

      %w[optional default]
    end

    def run_doctor_command(command)
      doctor_argv = @argv.dup
      parse_state = { stack_json: false, backend_selector_count: 0 }
      doctor(parse_options(command, @argv, parse_state: parse_state))
    rescue OptionParser::ParseError => e
      stack_json = parse_state[:stack_json] || stack_json_option_token?(doctor_argv)
      raise Error.new(e.message, exit_code: stack_json ? STACK_EXIT_USAGE : EXIT_USAGE)
    rescue Error => e
      stack_json = parse_state[:stack_json] || stack_json_option_token?(doctor_argv)
      raise unless stack_json && e.exit_code == EXIT_USAGE

      raise Error.new(e.message, exit_code: STACK_EXIT_USAGE)
    end

    # Argument normalization has to run before anything reads argv, which is
    # earlier than run_doctor_command's EXIT_USAGE -> STACK_EXIT_USAGE mapping
    # above, so a rejected argument would otherwise exit 1 where
    # `doctor --stack-json` promises 64 for every usage error -- and a stack
    # aggregator reads 1 as degraded and then finds no report to parse. The
    # exit code is therefore resolved here instead.
    def normalized_argv(argv)
      raw = argv.map { |argument| argument.to_s.b }
      AgentCoord.normalize_argv(argv, raw_indexes: path_argument_indexes(raw))
    rescue Error => e
      raise unless e.exit_code == EXIT_USAGE && stack_json_argv?(raw)

      raise Error.new(e.message, exit_code: STACK_EXIT_USAGE)
    end

    # A path is a byte string on its way to a syscall; every other argument is
    # text on its way to JSON. Transcoding a path changes which file it names --
    # a latin-1 `/tmp/café` becomes a different, probably nonexistent directory,
    # and `status --state-root` would report empty coordination state for a root
    # that is not empty -- so those values keep the bytes the operator typed.
    # The set comes from the option declarations' PATH placeholder rather than a
    # second list that could drift away from them.
    def path_argument_indexes(raw)
      # The command decides which options are registered, and it is still raw
      # here. A non-ASCII one cannot name a real command, and interpolating it
      # into the parser banner would raise, so it falls back to the global set.
      command = raw.first.to_s
      command = "" unless command.ascii_only?
      paths = registered_options(command).path_options
      indexes = []
      scan_raw_options(raw, command:) do |index, option, value_of, _awaits_value|
        indexes << index if paths.include?(value_of || option)
      end
      indexes
    end

    # Takes the BINARY copy built above, because standalone_option_token_count
    # splits each argument on "=" and String#split raises on a UTF-8-tagged
    # string holding invalid bytes -- exactly the input that got us here. Option
    # names are ASCII, and an ASCII-only string compares equal to its BINARY
    # copy, so the match is unaffected. The command token is dropped to match
    # what run_doctor_command inspects.
    def stack_json_argv?(raw)
      raw.first == "doctor" && stack_json_option_token?(raw.drop(1))
    end

    def print_help
      @stdout.puts <<~HELP
        Usage: agent-coord <command> [options]

        Commands:
          claim      acquire or renew a claim lease
          release    mark a claim lease released
          heartbeat  upsert an agent heartbeat
          register-batch
                     write a batch manifest into coordination state
          record-event
                     append a lane or batch event into coordination state
          status     render full or scoped coordination state
          log        trace which machine and host worked an issue or PR, and when
          batch-audit
                     report per-lane lifecycle-event completeness for a batch
          gc         archive and purge terminal coordination state
          version    print CLI contract version
          config     inspect or safely persist global user configuration
          doctor     verify backend access and state layout
          bootstrap  install the agent-coord command
          demo       run an isolated claim and takeover walkthrough

        Common options:
          --api-url URL              use the HTTP backend at URL
          --state-root PATH          use local files for tests or smoke checks
          --backend OWNER/REPO       explicit legacy GitHub backend repository
          --ref REF                  legacy GitHub backend branch/ref (default: #{DEFAULT_REF})
          --json                     emit JSON for supported commands
          -h, --help                 show command help
      HELP
      0
    end

    def help_request?(value)
      ["-h", "--help", "help"].include?(value)
    end

    def parse_options(command, argv, parse_state: nil, positional: nil)
      options = default_options
      parse_state ||= { stack_json: false, backend_selector_count: 0 }
      parser, = build_option_parser(command, options, parse_state)
      raise Error, "--deep is only valid for doctor" if command != "doctor" && deep_option_token?(argv, command:)

      parser.parse!(argv)
      raise Error, "doctor --json and --stack-json are mutually exclusive" if options[:json] && options[:stack_json]

      validate_stack_json_backend_selector_count!(options, parse_state)
      # OptionParser permutes, so the positional can appear before or after the
      # options; take it only after parsing rather than shifting it up front.
      options[positional] = argv.shift if positional
      raise Error, "unexpected arguments: #{argv.join(' ')}" unless argv.empty?

      finalize_options(command, options)
    end

    def build_option_parser(command, options, parse_state)
      parser = OptionParser.new
      opts = OptionRegistry.new(parser)
      opts.banner = "Usage: agent-coord #{command} [options]"
      add_command_help(opts, command)

      add_backend_options(opts, options, parse_state)
      add_target_options(opts, options)
      add_synthetic_options(opts, options)
      add_release_options(opts, options, command)
      add_event_options(opts, options)
      add_register_batch_options(opts, options)
      add_doctor_options(opts, options, command, parse_state)
      add_gc_options(opts, options, command)
      add_status_options(opts, options, command)
      add_log_options(opts, options, command)
      add_bootstrap_options(opts, options)
      add_config_set_options(opts, options, command)
      add_help_option(opts)
      [parser, opts]
    end

    def add_backend_options(opts, options, parse_state)
      opts.on("--backend OWNER/REPO", "backend repository") do |value|
        options[:backend] = explicit_selector_value!(value, "--backend")
        options[:explicit_backend] = true
        options[:backend_cli] = true
        parse_state[:backend_selector_count] += 1
      end
      opts.on("--ref REF", "backend branch/ref") do |value|
        options[:ref] = explicit_selector_value!(value, "--ref")
        options[:ref_cli] = true
      end
      opts.on("--state-root PATH", "use local files instead of GitHub API") do |value|
        options[:state_root] = explicit_selector_value!(value, "--state-root")
        options[:state_root_cli] = true
        parse_state[:backend_selector_count] += 1
      end
      opts.on("--api-url URL", "use the HTTP backend at URL") do |value|
        options[:api_url] = explicit_selector_value!(value, "--api-url")
        options[:api_url_cli] = true
        parse_state[:backend_selector_count] += 1
      end
      opts.on("--json", "emit JSON for supported commands") { options[:json] = true }
    end

    # Passing a backend selector or a ref is an explicit selection, so an empty
    # or whitespace-only value is a broken invocation, not a selection of nothing.
    # `agent-coord claim --state-root "$STATE_ROOT"` with STATE_ROOT unset used
    # to reach File.expand_path("") and silently read and write coordination
    # state into the working directory; `--api-url ""` selected the HTTP backend
    # with no endpoint; `--backend ""` fell through to the implicit local store
    # while config show had to be taught to report that fallthrough; and
    # `--ref ""` short-circuited ref resolution and sent the blank to the GitHub
    # API as a real ref, the CLI door into the same defect a blank exported
    # AGENT_COORD_REF opened. Rejecting at parse time is the same fail-closed
    # posture --token-stdin, the machine identity, and out-of-range ports
    # already take, and it removes the need for any downstream branch to model
    # an empty explicit selector.
    def explicit_selector_value!(value, flag)
      return value if AgentCoord.config_value_set?(value)

      raise Error, "#{flag} requires a non-empty value"
    end

    def validate_stack_json_backend_selector_count!(options, parse_state)
      return unless options[:stack_json]

      if parse_state[:backend_selector_count] == 1
        # Empty selector values are rejected during parsing now, for every
        # command rather than only under --stack-json.
        AgentCoord.validate_repo!(options[:backend], "backend") if options[:explicit_backend]

        return
      end

      raise Error, "doctor --stack-json requires exactly one of --state-root, --api-url, or --backend"
    end

    def add_target_options(opts, options)
      opts.on("--agent-id ID", "stable agent identifier") { |value| options[:agent_id] = value }
      opts.on("--repo OWNER/REPO", "target repository") { |value| options[:repo] = value }
      opts.on("--target ISSUE_OR_PR", "target issue or PR id") { |value| options[:target] = value }
      opts.on("--batch-id ID", "batch identifier") { |value| options[:batch_id] = value }
      opts.on("--branch BRANCH", "branch for the target") { |value| options[:branch] = value }
      opts.on("--thread-handle HANDLE", "worker chat thread handle") { |value| options[:thread_handle] = value }
      opts.on("--chat-handle HANDLE", "host-specific chat handle") { |value| options[:chat_handle] = value }
      opts.on("--host HOST",
              "host app or wrapper, e.g. codex or claude-code/conductor; " \
              "terminal closed_by.machine prefers AGENT_COORD_MACHINE_ID over --host") do |value|
        options[:host] = value
      end
      opts.on("--pr-url URL", "pull request URL for the lane") { |value| options[:pr_url] = value }
      opts.on("--dashboard-url URL", "dashboard deep link for the lane") { |value| options[:dashboard_url] = value }
      opts.on("--operator NAME", "human operator for the lane") { |value| options[:operator] = value }
      opts.on("--phase PHASE", "lane phase") { |value| options[:phase] = value }
      opts.on("--generation GENERATION", Integer, "claim/lane generation") { |value| options[:generation] = value }
      opts.on("--instance-id ID", "agent process instance identifier") { |value| options[:instance_id] = value }
      opts.on("--ttl SECONDS", Integer, "lease/heartbeat TTL in seconds") { |value| options[:ttl] = value }
      opts.on("--status STATUS", "heartbeat or event status") do |value|
        options[:status] = value
        options[:status_given] = true
      end
      opts.on("--terminal TERMINAL", "terminal closeout: done, abandoned, or superseded") do |value|
        options[:terminal] = value
      end
      opts.on("--pr-state STATE", "final pull request state for terminal closeout") do |value|
        options[:pr_state] = value
      end
      opts.on("--evidence-url URL", "replayable closeout evidence pointer") { |value| options[:evidence_url] = value }
      opts.on("--workspace WORKSPACE", "coordination workspace (default: #{DEFAULT_WORKSPACE})") do |value|
        options[:workspace] = value
      end
    end

    def add_synthetic_options(opts, options)
      opts.on("--synthetic", "mark smoke or simulation state for aggressive retention") do
        options[:synthetic] = true
      end
      opts.on("--synthetic-kind KIND", "classify synthetic state, e.g. simulation or smoke") do |value|
        options[:synthetic_kind] = value
      end
    end

    def add_release_options(opts, options, command)
      return unless command == "release"

      opts.on("--handoff-to ID", "release handoff destination agent, host, or operator") do |value|
        options[:handoff_to] = value
      end
      opts.on("--handoff-note TEXT", "resume note for a release handoff") do |value|
        options[:handoff_note] = value
      end
    end

    def add_event_options(opts, options)
      opts.on("--type TYPE", "event type to record (record-event) or to filter on (log)") do |value|
        options[:type] = value
      end
      opts.on("--lane NAME", "record-event only: batch lane name") { |value| options[:lane] = value }
      opts.on("--message TEXT", "record-event only: event message") { |value| options[:message] = value }
      add_typed_event_options(opts, options)
    end

    # Typed operational-signal fields (issue #77). Like --type/--lane/--message
    # they are accepted globally but only meaningful for record-event; per-type
    # required-field validation happens in validate_typed_event_options!.
    def add_typed_event_options(opts, options)
      opts.on("--reason REASON", "record-event help_requested: reason enum") { |value| options[:reason] = value }
      opts.on("--from-route ROUTE", "record-event escalation_requested: current route") do |value|
        options[:from_route] = value
      end
      opts.on("--to-route ROUTE", "record-event escalation_requested: requested route") do |value|
        options[:to_route] = value
      end
      opts.on("--evidence TEXT", "record-event escalation_requested: evidence summary") do |value|
        options[:evidence] = value
      end
      opts.on("--severity SEVERITY", "record-event error: severity enum") { |value| options[:severity] = value }
      opts.on("--category CATEGORY", "record-event error: error category") { |value| options[:category] = value }
      opts.on("--kind KIND", "record-event human_intervention: kind enum") { |value| options[:kind] = value }
    end

    def add_register_batch_options(opts, options)
      opts.on("--file PATH", "batch manifest JSON file") { |value| options[:file] = value }
      opts.on("--launch-prompt PATH|-", "coordination launch prompt file or stdin") do |value|
        options[:launch_prompt] = value
      end
    end

    def add_doctor_options(opts, options, command, parse_state)
      return unless command == "doctor"

      opts.on("--stack-json", "doctor only: emit the component stack-doctor contract") do
        options[:stack_json] = true
        parse_state[:stack_json] = true
      end
      opts.on("--deep", "doctor only: parse every JSON state record") { options[:deep] = true }
      opts.on("--doctor-prefix PREFIX", "doctor only: resource prefix or record probe") do |value|
        options[:doctor_prefix] = value
      end
    end

    def add_gc_options(opts, options, command)
      return unless command == "gc"

      opts.on("--dry-run", "plan retention changes without writing") { options[:dry_run] = true }
      opts.on("--execute", "apply retention changes") { options[:execute] = true }
      opts.on("--hot-days DAYS", Integer, "days terminal state remains hot (default: #{DEFAULT_HOT_DAYS})") do |value|
        options[:hot_days] = value
      end
      opts.on("--archive-days DAYS", Integer,
              "days archived state remains before deletion (default: #{DEFAULT_ARCHIVE_DAYS})") do |value|
        options[:archive_days] = value
      end
      opts.on("--synthetic-hot-days DAYS", Integer,
              "days synthetic state remains hot (default: #{DEFAULT_SYNTHETIC_HOT_DAYS})") do |value|
        options[:synthetic_hot_days] = value
      end
      opts.on("--prefix PREFIX", "hot family to scan: claims, heartbeats, batches, or events (repeatable)") do |value|
        (options[:prefixes] ||= []) << value
      end
    end

    def add_status_options(opts, options, command)
      return unless command == "status"

      opts.on("--include-archived", "include archived records in status output") do
        options[:include_archived] = true
      end
    end

    def add_log_options(opts, options, command)
      return unless command == "log"

      opts.on("--since VALUE", "only events at or after a duration or ISO8601 timestamp") do |value|
        options[:since] = value
      end
      opts.on("--machine ID", "only events recorded by one machine") { |value| options[:machine] = value }
      opts.on("--limit N", Integer, "keep only the N most recent events") do |value|
        raise Error, "--limit must not be negative, got #{value}" if value.negative?

        options[:limit] = value
      end
      opts.on("--format FORMAT", "log output format: text or tsv") { |value| options[:format] = value }
      opts.on("--sync", "append unseen events to the local greppable log") { options[:sync] = true }
      opts.on("--include-synthetic", "include simulation and smoke records") { options[:include_synthetic] = true }
    end

    def add_bootstrap_options(opts, options)
      opts.on("--install-dir PATH", "bootstrap install directory") { |value| options[:install_dir] = value }
      opts.on("--status-state-root PATH", "install agent-coord with a local status state root") do |value|
        options[:status_state_root] = value
      end
      opts.on("--profile PATH", "shell profile to update during bootstrap") { |value| options[:profile] = value }
      opts.on("--no-profile", "do not update shell profile during bootstrap") { options[:no_profile] = true }
    end

    def add_config_set_options(opts, options, command)
      return unless command == "config-set"

      opts.on("--token-stdin", "read the HTTP API token from stdin without echoing it") do
        options[:token_stdin] = true
      end
      opts.on("--machine-id ID", "persist the machine identity") do |value|
        options[:machine_id] = value
        options[:machine_id_given] = true
      end
      opts.on("--policy POLICY", COORDINATION_POLICIES, "persist required, optional, or disabled policy") do |value|
        options[:policy] = value
        options[:policy_given] = true
      end
    end

    def add_help_option(opts)
      opts.on("-h", "--help", "show command help") do
        @stdout.puts opts
        exit 0
      end
    end

    def finalize_options(command, options)
      validate_doctor_prefix!(command, options)
      validate_closeout_option_usage!(command, options)
      validate_register_batch_option_usage!(command, options)
      validate_config_set_backend_option_usage!(command, options)

      if backend_command?(command)
        resolve_backend_env(options)
        resolve_default_local_backend(command, options)
        warn_consumer_split_brain(command, options)
        refuse_split_brain_write!(command, options)
      end
      options
    end

    def validate_config_set_backend_option_usage!(command, options)
      return unless command == "config-set"

      unsupported = {
        state_root_cli: "--state-root",
        backend_cli: "--backend",
        ref_cli: "--ref"
      }.find { |field, _option| options[field] }
      return unless unsupported

      raise Error, "#{unsupported.last} is not valid for config set"
    end

    def validate_doctor_prefix!(command, options)
      return unless command == "doctor" && doctor_prefix_supplied?(options)

      prefix = options.fetch(:doctor_prefix)
      AgentCoord.safe_path!(prefix)
      raise PathValidationError, "unsafe state path: #{prefix}" if prefix.split("/").include?(".")
      return unless options[:stack_json]

      family = prefix.split("/", 2).first
      raise PathValidationError, "unknown doctor prefix family: #{family}" unless STATE_PREFIXES.include?(family)
      return if AgentCoord.state_directory_prefix?(prefix) || AgentCoord.state_record_path?(prefix)

      raise PathValidationError, "invalid doctor prefix shape: #{prefix}"
    end

    def validate_register_batch_option_usage!(command, options)
      return unless options[:launch_prompt]
      return if command == "register-batch"

      raise Error, "--launch-prompt is only valid for register-batch"
    end

    def validate_closeout_option_usage!(command, options)
      fields = %i[terminal pr_state evidence_url workspace]
      supplied = fields.select { |field| options.key?(field) }
      return if supplied.empty?

      if command == "release"
        missing_terminal = supplied.reject { |field| field == :terminal }
        if !missing_terminal.empty? && options[:terminal].to_s.empty?
          raise Error, "--#{missing_terminal.first.to_s.tr('_', '-')} requires --terminal"
        end

        return
      end
      return if command == "record-event" && options[:type] == "lane_closed"

      raise Error, "terminal-only options require --type lane_closed" if command == "record-event"

      raise Error, "--#{supplied.first.to_s.tr('_', '-')} is only valid with terminal closeout"
    end

    def backend_command?(command)
      %w[claim release heartbeat register-batch record-event status log batch-audit gc doctor].include?(command)
    end

    def default_options
      {
        backend: DEFAULT_BACKEND,
        ref: DEFAULT_REF,
        state_root: nil,
        api_url: nil,
        status: "in_progress"
      }
    end

    def resolve_backend_env(options)
      resolve_effective_ref!(options)
      return if options[:stack_json] && options[:explicit_backend]

      cli_api = options[:api_url] if options[:api_url_cli]
      env_api = effective_backend_env_value("AGENT_COORD_API_URL")
      env_root = effective_backend_env_value("AGENT_COORD_STATE_ROOT")
      env_backend = effective_backend_env_value("AGENT_COORD_BACKEND")
      env_api = nil unless AgentCoord.config_value_set?(env_api)
      env_root = nil unless AgentCoord.config_value_set?(env_root)
      env_backend = nil unless AgentCoord.config_value_set?(env_backend)

      configured = { api_url: env_api, state_root: env_root, backend: env_backend }
      return if resolve_cli_backend?(options, cli_api, configured)

      resolve_configured_backend(options, env_api, env_root, env_backend)
    end

    # Both tiers can be blank -- an exported AGENT_COORD_REF='   ' over a saved
    # AGENT_COORD_REF='' -- so the fallback to DEFAULT_REF asks the same
    # question effective_config_value just asked, not a looser one.
    def resolve_effective_ref!(options)
      return if options[:ref_cli]

      configured_ref = effective_config_value("AGENT_COORD_REF")
      options[:ref] = AgentCoord.config_value_set?(configured_ref) ? configured_ref : DEFAULT_REF
    end

    # `configured` carries all three configured selectors, AGENT_COORD_BACKEND
    # included. These branches return before resolve_configured_backend ever
    # runs, so a CLI flag that displaces a configured backend can only be
    # announced here; reading AGENT_COORD_BACKEND in the caller and not passing
    # it in is what made GitHub-to-local and GitHub-to-HTTP overrides silent.
    def resolve_cli_backend?(options, cli_api, configured)
      if options[:state_root_cli]
        warn_cli_state_root_override(options, cli_api, configured)
        options[:backend_source] = "cli"
        return true
      end

      if cli_api
        warn_cli_api_url_override(options, configured)
        options[:backend_source] = "cli"
        return true
      end

      return false unless options[:backend_cli]

      warn_cli_backend_override(options, configured)
      options[:backend_source] = "cli"
      true
    end

    def warn_cli_state_root_override(options, cli_api, configured)
      message =
        if cli_api
          "warning: --api-url and --state-root are both set; using the local backend."
        elsif options[:backend_cli]
          "warning: --backend and --state-root are both set; using the local backend."
        elsif configured_selector?(configured, :api_url)
          "warning: AGENT_COORD_API_URL and --state-root are both set; using the local backend."
        elsif configured_selector?(configured, :backend)
          "warning: AGENT_COORD_BACKEND and --state-root are both set; using the local backend."
        end
      emit_backend_conflict_warning(message, options:) if message
    end

    def warn_cli_api_url_override(options, configured)
      message =
        if options[:backend_cli]
          "warning: --backend and --api-url are both set; using the HTTP backend."
        elsif configured_selector?(configured, :state_root)
          "warning: --api-url and AGENT_COORD_STATE_ROOT are both set; " \
            "using the HTTP backend. Pass --state-root to force local."
        elsif configured_selector?(configured, :backend)
          "warning: AGENT_COORD_BACKEND and --api-url are both set; using the HTTP backend."
        end
      emit_backend_conflict_warning(message, options:) if message
    end

    # --backend silently outranks a configured fleet backend exactly the way
    # --state-root and --api-url do, so it has to announce the same conflict.
    # The value is guaranteed non-empty: explicit_selector_value! rejected the
    # empty case during parsing, so this is always a real override.
    def warn_cli_backend_override(options, configured)
      message =
        if configured_selector?(configured, :api_url)
          "warning: AGENT_COORD_API_URL and --backend are both set; " \
            "using the legacy GitHub backend."
        elsif configured_selector?(configured, :state_root)
          "warning: AGENT_COORD_STATE_ROOT and --backend are both set; " \
            "using the legacy GitHub backend."
        end
      emit_backend_conflict_warning(message, options:) if message
    end

    def configured_selector?(configured, key)
      !configured.fetch(key).to_s.empty?
    end

    # Configured-tier precedence is API_URL > STATE_ROOT > BACKEND, and every
    # pair in which a selector is displaced warns once. The winning branch names
    # only the next-highest loser, so all three set reports the state root and
    # then the backend on the next run once that is removed; two warnings for one
    # "HTTP wins" decision would only train operators to skip them. A selector on
    # its own is an unambiguous selection and stays quiet.
    def resolve_configured_backend(options, env_api, env_root, env_backend)
      options[:api_url] = env_api
      if env_api
        options[:backend_source] = backend_env_source
        if env_root
          emit_backend_conflict_warning(
            "warning: AGENT_COORD_API_URL and AGENT_COORD_STATE_ROOT are both set; " \
            "using the HTTP backend. Pass --state-root to force local.", options:
          )
        elsif env_backend
          emit_backend_conflict_warning(
            "warning: AGENT_COORD_API_URL and AGENT_COORD_BACKEND are both set; " \
            "using the HTTP backend. Pass --backend to force the legacy GitHub backend.", options:
          )
        end
        return
      end
      if env_root
        options[:state_root] = env_root
        options[:backend_source] = backend_env_source
        if env_backend
          emit_backend_conflict_warning(
            "warning: AGENT_COORD_STATE_ROOT and AGENT_COORD_BACKEND are both set; " \
            "using the local backend. Pass --backend to force the legacy GitHub backend.", options:
          )
        end
        return
      end
      return unless env_backend

      options[:backend] = env_backend
      options[:backend_source] = backend_env_source
    end

    def emit_backend_conflict_warning(message, options:)
      return if options[:stack_json]

      @stderr.puts message if @backend_conflict_warnings
    end

    # Read-only, status-style commands that prefer the status state root over the
    # write-mode local default. batch-audit reads coordination state exactly like
    # status, so it resolves and warns identically.
    #
    # resolve_default_local_backend is the only place that default is applied, and
    # it yields to an explicitly selected backend. A command body that re-applies
    # it -- `options[:state_root] ||= default_status_state_root` -- runs after that
    # decision and silently answers from local state for a request that named a
    # different backend, so do not reintroduce one.
    def status_read_command?(command)
      %w[status log doctor batch-audit].include?(command)
    end

    def warn_consumer_split_brain(command, options)
      return unless status_read_command?(command)
      return if options[:stack_json]
      return if local_mode_opt_in?
      # doctor reports the enforcing condition itself; do not say it twice.
      return if command == "doctor" && consumer_split_brain_env_file(options)
      return unless options[:state_root] && !options[:api_url]
      return if process_api_url_configured?

      env_file = consumer_env_files.find { |path| consumer_api_url_configured?(path) }
      return unless env_file

      @stderr.puts(
        "warning: split-brain configuration: #{env_file} configures AGENT_COORD_API_URL, " \
        "but this CLI is using the local backend. Load that env file for fleet reads or remove it if local mode " \
        "is intended."
      )
    end

    # Commands that mutate coordination state. gc only prunes an already chosen
    # root, and read commands keep the advisory warning, so neither hard stops.
    def split_brain_write_command?(command)
      %w[claim release heartbeat record-event register-batch].include?(command)
    end

    # Commands that surface the split-brain condition themselves, and so must not
    # be preceded by the local-mode notice.
    def split_brain_reporting_command?(command)
      split_brain_write_command?(command) || command == "doctor"
    end

    def local_mode_opt_in?
      LOCAL_MODE_TRUE_VALUES.include?(ENV.fetch(LOCAL_MODE_ENV, "").strip.downcase)
    end

    # A consumer env file configures a fleet API URL, but the CLI fell back to the
    # implicit local root because that file was never sourced. Writes here would be
    # invisible to the fleet, so the operator must choose a backend explicitly.
    # A status-scoped root only redirects reads. Writes on the same host never
    # consult it, so they still fall through to the implicit local root — doctor
    # must report the condition those writes would hit, not the one its own read
    # path took.
    def split_brain_eligible_local?(options)
      return true if options[:implicit_local]

      options[:status_root_local] && !AgentCoord.config_value_set?(ENV.fetch("AGENT_COORD_STATE_ROOT", ""))
    end

    def consumer_split_brain_env_file(options)
      return nil if options[:stack_json]
      return nil unless split_brain_eligible_local?(options)
      return nil if process_api_url_configured?
      return nil if local_mode_opt_in?
      # Consulted from the notice, the refusal and the doctor payload in one run;
      # compute it once rather than re-reading the file at each site.
      return options[:split_brain_env_file] if options.key?(:split_brain_env_file)

      options[:split_brain_env_file] = consumer_env_files.find { |path| consumer_api_url_configured?(path) }
    end

    def process_api_url_configured?
      AgentCoord.config_value_set?(@process_config&.fetch("AGENT_COORD_API_URL", nil))
    end

    def consumer_split_brain_message(env_file)
      "split-brain configuration: #{env_file} configures AGENT_COORD_API_URL, but this CLI resolved to the " \
        "implicit local backend; refusing writes that would land on the local state root while a fleet API URL " \
        "is configured. Source #{env_file} for fleet writes, pass --state-root PATH to choose a local root " \
        "explicitly, or set #{LOCAL_MODE_ENV}=1 to opt into local mode."
    end

    def refuse_split_brain_write!(command, options)
      return unless split_brain_write_command?(command)

      env_file = consumer_split_brain_env_file(options)
      return unless env_file

      raise OperationalError, consumer_split_brain_message(env_file)
    end

    def consumer_env_files
      configured = ENV.fetch("AGENT_COORD_ENV_FILE", "")
      config_home = ENV.fetch("XDG_CONFIG_HOME", "")
      if config_home.empty?
        home = ENV.fetch("HOME", "")
        config_home = File.join(home, ".config") unless home.empty?
      end
      conventional = if config_home.empty?
                       []
                     else
                       %w[env http-env.sh].map { |name| File.join(config_home, "agent-coord", name) }
                     end
      ([configured] + conventional).select { |path| AgentCoord.config_value_set?(path) }.uniq
    end

    def consumer_api_url_configured?(path)
      File.foreach(path).any? do |line|
        # Capture from the "=" without consuming the space after it: in a shell,
        # `=#x` assigns "#x" while `= #x` assigns nothing, and the value scanner
        # needs that whitespace to tell them apart.
        match = line.match(/^\s*(?:export\s+)?AGENT_COORD_API_URL=(.*)$/)
        next false unless match

        # Must agree with backend resolution: a blank assignment is not a
        # configured fleet URL, so treating it as one would hard-stop a write
        # that resolution correctly sent to the implicit local backend.
        AgentCoord.config_value_set?(consumer_env_assignment_value(match[1].to_s))
      end
    rescue SystemCallError, ArgumentError
      false
    end

    # What a shell would actually leave in the variable. Quoted and unquoted
    # fragments concatenate (`=""https://host` is a nonempty URL), an unquoted `#`
    # at a word boundary starts a comment, and unquoted whitespace ends the word.
    # A `#` inside an unquoted URL stays part of the value. Without this,
    # `AGENT_COORD_API_URL= # remote disabled` reads as a configured fleet URL and
    # refuses every write.
    def consumer_env_assignment_value(raw)
      value = +""
      index = 0
      while index < raw.length
        char = raw[index]
        case char
        when '"', "'"
          close = raw.index(char, index + 1)
          # An unterminated quote is a broken file; keep the rest so the guard
          # errs toward firing rather than silently permitting a write.
          return value << raw[(index + 1)..] unless close

          value << raw[(index + 1)...close]
          index = close + 1
        # Unquoted whitespace ends the word, and an unquoted shell metacharacter
        # ends the assignment: `AGENT_COORD_API_URL=; # disabled` assigns nothing.
        when /\s/, ";", "&", "|", "<", ">", "(", ")"
          break
        when "#"
          # Only a "#" that begins a word is a comment. Directly after the "=",
          # or inside a URL, it is an ordinary character.
          break if index.positive? && raw[index - 1].match?(/\s/)

          value << char
          index += 1
        else
          value << char
          index += 1
        end
      end
      value
    end

    def resolve_default_local_backend(command, options)
      return if options[:state_root] || options[:api_url] || !options[:backend].to_s.empty?

      status_command = status_read_command?(command)
      configured_status_root = ENV.fetch(STATUS_STATE_ROOT_ENV, nil)
      if status_command && AgentCoord.config_value_set?(configured_status_root)
        options[:state_root] = configured_status_root
        options[:status_root_local] = true
        return
      end

      if configured_api_token?
        raise OperationalError,
              "AGENT_COORD_API_TOKEN is set but AGENT_COORD_API_URL is missing or empty; " \
              "set AGENT_COORD_API_URL or unset AGENT_COORD_API_TOKEN"
      end

      status_root = default_status_state_root if status_command
      if status_root
        options[:state_root] = status_root
        # Also read-only redirection: writes still fall through to implicit local.
        options[:status_root_local] = true
        return
      end

      options[:state_root] = default_local_state_root
      options[:implicit_local] = true
      # A refused write never enters local mode, and doctor reports the same
      # condition itself, so the notice would only soften the error that follows.
      return if split_brain_reporting_command?(command) && consumer_split_brain_env_file(options)

      @stderr.puts "notice: local mode — single-machine only; state root: #{options[:state_root]}"
    end

    def add_command_help(opts, command)
      case command
      when "status"
        opts.separator ""
        opts.separator "Status scopes:"
        opts.separator "    no scope                      full audit; scans claims, heartbeats, and batches"
        opts.separator "    --repo OWNER/REPO --target N  target read; claim plus holder heartbeat only"
        opts.separator "    --batch-id ID                 batch read; batch, lane heartbeats, dependencies"
        opts.separator "Scoped JSON includes a degraded array for intentionally omitted state."
        opts.separator "Use --include-archived with unscoped status to inspect archive records."
        opts.separator "Exit 2 means coordination state for that command is UNKNOWN."
        opts.separator ""
      when "doctor"
        opts.separator ""
        opts.separator "Doctor modes:"
        opts.separator "    default  lightweight auth, ref, and layout checks without reading every JSON file"
        opts.separator "    --deep   parse every claim, heartbeat, and batch JSON file"
        opts.separator "    --stack-json  emit the versioned component report for stack aggregators"
        opts.separator "Exit 2 means coordination state is UNKNOWN until backend access is fixed."
        opts.separator ""
      when "gc"
        add_gc_command_help(opts)
      when "register-batch"
        opts.separator ""
        opts.separator "Batch registration:"
        opts.separator "    --file PATH           JSON manifest with batch_id and lanes"
        opts.separator "    --launch-prompt PATH|-  prompt file or stdin (overrides manifest)"
        opts.separator ""
      when "record-event"
        add_record_event_command_help(opts)
      when "log"
        add_log_command_help(opts)
      when "batch-audit"
        add_batch_audit_command_help(opts)
      when "release"
        opts.separator ""
        opts.separator "Handoff release:"
        opts.separator "    --handoff-to ID             intended next agent, host, or operator"
        opts.separator "    --handoff-note TEXT         resume note for the next claimant"
        opts.separator "    --terminal STATE            close as done, abandoned, or superseded"
        opts.separator "    --pr-state STATE            final pull request state"
        opts.separator ""
      end
    end

    def add_record_event_command_help(opts)
      opts.separator ""
      opts.separator "Event recording:"
      opts.separator "    --batch-id ID --type TYPE  append an event under events/<batch-id>/"
      opts.separator "    --lane NAME                 attach the event to a registered lane"
      opts.separator "Typed --type values validate required fields at write time:"
      opts.separator "    help_requested        --reason blocked-user-input|question|permission"
      opts.separator "    escalation_requested  --from-route ROUTE --to-route ROUTE --evidence TEXT"
      opts.separator "    error                 --severity P0|P1|P2|P3 --category CAT --message TEXT"
      opts.separator "    human_intervention    --kind takeover|supersede|manual-fix|drain"
      opts.separator ""
    end

    def add_log_command_help(opts)
      opts.separator ""
      opts.separator "Work-item custody trail:"
      opts.separator "    agent-coord log OWNER/REPO#TARGET   every event for one issue or PR"
      opts.separator "Columns: at, machine, host, work item, type, phase, agent, detail."
      opts.separator "Where it is now is the last line; a move is a change of machine, host, or agent."
      opts.separator "TARGET names a work item, not a spelling: 319, issue:319, and pr:319 are one trail."
      opts.separator "A trailing segment is a lane (issue:319:qa); the bare item covers its lanes."
      opts.separator "    --since VALUE        3d, 12h, 30m, or an ISO8601 timestamp"
      opts.separator "    --machine ID         only events from one machine, e.g. m1"
      opts.separator "    --host FAMILY        only events from codex or claude"
      opts.separator "    --type TYPE          only one event type, e.g. claim.acquired"
      opts.separator "    --limit N            keep only the N most recent events"
      opts.separator "    --format tsv         tab-separated with raw host and event id"
      opts.separator "    --sync               append unseen events to <state-root>/log.tsv for grep"
      opts.separator "    --include-synthetic  include simulation and smoke records"
      opts.separator ""
    end

    def add_batch_audit_command_help(opts)
      opts.separator ""
      opts.separator "Batch telemetry-completeness audit:"
      opts.separator "    --batch-id ID   report per-lane missing lifecycle events for closeout gating"
      opts.separator "A lane is complete with a claim.acquired event and a terminal signal"
      opts.separator "(claim.released OR lane_closed); either missing marks it incomplete."
      opts.separator "Exit 0 complete, 1 incomplete (gaps found), 2 UNKNOWN (unregistered/unreadable)."
      opts.separator ""
    end

    def add_gc_command_help(opts)
      opts.separator ""
      opts.separator "GC modes:"
      opts.separator "    --dry-run  plan retention changes without writing"
      opts.separator "    --execute  apply retention changes"
      opts.separator "    --hot-days DAYS      hot retention (default: #{DEFAULT_HOT_DAYS})"
      opts.separator "    --archive-days DAYS  archive retention (default: #{DEFAULT_ARCHIVE_DAYS})"
      opts.separator "    --synthetic-hot-days DAYS  synthetic hot retention (default: #{DEFAULT_SYNTHETIC_HOT_DAYS})"
      opts.separator "    --prefix PREFIX  scan one hot family; repeat for claims, heartbeats, batches, events"
      opts.separator "Exactly one mode is required."
      opts.separator ""
    end

    def gc(options)
      raise Error, "gc requires exactly one of --dry-run or --execute" if options[:dry_run] == options[:execute]

      hot_days = nonnegative_days(options[:hot_days] || DEFAULT_HOT_DAYS, "--hot-days")
      archive_days = nonnegative_days(options[:archive_days] || DEFAULT_ARCHIVE_DAYS, "--archive-days")
      synthetic_hot_days = nonnegative_days(
        options[:synthetic_hot_days] || DEFAULT_SYNTHETIC_HOT_DAYS,
        "--synthetic-hot-days"
      )
      prefixes = gc_prefixes(options[:prefixes])
      now = now_utc
      store = build_store(options)
      candidates = gc_candidates(store, now, hot_days, synthetic_hot_days, prefixes)
      validate_gc_archive_sizes!(candidates, now, archive_days)
      candidates.each { |candidate| execute_gc_candidate(store, candidate, now, archive_days) } if options[:execute]
      candidates.sort_by! do |candidate|
        action = candidate.fetch(:action)
        action["source_path"] || Array(action["source_paths"]).first || action.fetch("archive_path", "")
      end
      actions = candidates.map { |candidate| candidate.fetch(:action) }
      payload = {
        "mode" => options[:dry_run] ? "dry-run" : "execute",
        "policy" => {
          "hot_days" => hot_days,
          "archive_days" => archive_days,
          "synthetic_hot_days" => synthetic_hot_days
        }, "prefixes" => prefixes,
        "actions" => actions
      }
      options[:json] ? @stdout.puts(JSON.pretty_generate(payload)) : render_gc_text(payload)
      0
    ensure
      close_store(store)
    end

    def nonnegative_days(value, option)
      raise Error, "#{option} must be zero or greater" if value.negative?

      value
    end

    def gc_prefixes(values)
      prefixes = values || (JSON_PREFIXES + ["events"])
      invalid = prefixes.reject { |value| (JSON_PREFIXES + ["events"]).include?(value) }
      raise Error, "--prefix must be one of: claims, heartbeats, batches, events" unless invalid.empty?

      prefixes.uniq
    end

    def gc_candidates(store, now, hot_days, synthetic_hot_days, prefixes)
      archive_candidates = gc_archive_candidates(store, now, hot_days, synthetic_hot_days, prefixes & JSON_PREFIXES)
      compaction_candidates = if prefixes.include?("events")
                                gc_compaction_candidates(store, now, hot_days, synthetic_hot_days)
                              else
                                []
                              end
      protected_destinations = (archive_candidates + compaction_candidates).to_h do |candidate|
        [candidate.dig(:action, "archive_path"), true]
      end
      delete_candidates = gc_delete_candidates(store, now).reject do |candidate|
        protected_destinations[candidate.dig(:action, "source_path")]
      end
      archive_candidates + compaction_candidates + delete_candidates
    end

    def execute_gc_candidate(store, candidate, now, archive_days)
      case candidate.dig(:action, "action")
      when "archive" then gc_archive_record(store, candidate, now, archive_days)
      when "replace_archive" then gc_replace_archive_record(store, candidate, now, archive_days)
      when "compact" then gc_compact_events(store, candidate, now, archive_days)
      when "delete" then gc_delete_archive(store, candidate)
      end
    end

    def gc_archive_candidates(store, now, hot_days, synthetic_hot_days, prefixes = JSON_PREFIXES)
      candidates = prefixes.flat_map do |prefix|
        store.list_json(prefix).filter_map do |entry|
          reason, eligible_at = gc_archive_eligibility(entry, prefix, now)
          retention_days = entry.data["synthetic"] == true ? synthetic_hot_days : hot_days
          next unless reason && eligible_at <= now - (retention_days * 86_400)

          action = {
            "action" => "archive",
            "source_path" => entry.path,
            "archive_path" => AgentCoord.archive_path(entry.path),
            "reason" => reason,
            "eligible_at" => timestamp(eligible_at)
          }
          existing = store.read_json(action.fetch("archive_path"))
          if existing && !gc_same_archived_record?(existing.data, { "source_path" => entry.path, "data" => entry.data })
            next if gc_archive_delete_after(existing) > now

            action["action"] = "replace_archive"
            action["reason"] = "expired_archive_replacement"
          end
          { entry: entry, existing_archive: existing, action: action }
        end
      end
      candidates.sort_by { |candidate| candidate.dig(:action, "source_path") }
    end

    def gc_delete_candidates(store, now)
      store.list_json("archive").filter_map do |entry|
        delete_after = gc_archive_delete_after(entry)
        next if delete_after > now

        {
          entry: entry,
          action: {
            "action" => "delete",
            "source_path" => entry.path,
            "reason" => "archive_expired",
            "eligible_at" => timestamp(delete_after)
          }
        }
      end
    end

    def gc_compaction_candidates(store, now, hot_days, synthetic_hot_days)
      entries = store.list_json("events")
      terminal_lanes = gc_terminal_lanes_by_provenance(entries)
      groups = entries.group_by do |entry|
        data = entry.data
        provenance = gc_event_provenance(entry)
        lane = data["lane"]
        lanes = terminal_lanes[provenance]
        lane = lanes.first if lane.to_s.empty? && lanes&.one?
        [*provenance, lane]
      end
      groups.filter_map do |group, entries|
        gc_compaction_candidate(group, entries, now, hot_days, synthetic_hot_days)
      end
    end

    def gc_compaction_candidate(group, entries, now, hot_days, synthetic_hot_days)
      batch_id, repo, target, lane = group

      terminal = entries.select { |entry| gc_terminal_event?(entry.data) }
                        .max_by { |entry| gc_record_time(entry.data, nil, entry.path) }
      eligibility = gc_event_compaction_eligibility(entries, terminal, now, hot_days, synthetic_hot_days)
      return unless eligibility
      # Each fully aged source generation gets its own immutable envelope.
      return unless entries.all? { |entry| gc_hot_window_elapsed?(entry, now, hot_days, synthetic_hot_days) }

      reason, eligible_at = eligibility
      source_paths = entries.map(&:path).sort
      {
        entries: entries,
        action: {
          "action" => "compact",
          "source_paths" => source_paths,
          "archive_path" => gc_compaction_archive_path(batch_id, lane, repo, target, entries),
          "reason" => reason,
          "eligible_at" => timestamp(eligible_at)
        }
      }
    end

    def gc_event_provenance(entry)
      data = entry.data
      batch_id = data["batch_id"].to_s
      batch_id = AgentCoord.event_batch_from_path(entry.path) if batch_id.empty?
      [batch_id, data["repo"], data["target"]&.to_s]
    end

    def gc_terminal_lanes_by_provenance(entries)
      entries.each_with_object({}) do |entry, lanes_by_provenance|
        data = entry.data
        lane = data["lane"]
        next unless gc_terminal_event?(data) && !lane.to_s.empty?

        lanes = (lanes_by_provenance[gc_event_provenance(entry)] ||= [])
        lanes << lane unless lanes.include?(lane)
      end
    end

    def gc_event_compaction_eligibility(entries, terminal, now, hot_days, synthetic_hot_days)
      if terminal
        return unless gc_hot_window_elapsed?(terminal, now, hot_days, synthetic_hot_days)

        ["terminal_target_events", gc_record_time(terminal.data, nil, terminal.path)]
      elsif entries.all? { |entry| entry.data["synthetic"] == true }
        ["synthetic_orphan_events", entries.map { |entry| gc_record_time(entry.data, nil, entry.path) }.max]
      end
    end

    def gc_compaction_archive_path(batch_id, lane, repo, target, entries)
      identity = { "lane" => lane, "repo" => repo, "target" => target }
      target_digest = Digest::SHA256.hexdigest(gc_canonical_json(identity))[0, 16]
      source_identities = entries.sort_by(&:path).map { |entry| { "path" => entry.path, "data" => entry.data } }
      source_digest = Digest::SHA256.hexdigest(gc_canonical_json(source_identities))[0, 16]
      "archive/events/#{batch_id}/compact-#{target_digest}-#{source_digest}.json"
    end

    def gc_hot_window_elapsed?(entry, now, hot_days, synthetic_hot_days)
      data = entry.data
      retention_days = data["synthetic"] == true ? synthetic_hot_days : hot_days
      gc_record_time(data, nil, entry.path) <= now - (retention_days * 86_400)
    end

    def gc_terminal_event?(data)
      gc_terminal_identity_valid?(data) && gc_terminal_context_valid?(data)
    end

    def gc_terminal_identity_valid?(data)
      return false unless data["schema_version"] == LANE_CLOSED_SCHEMA_VERSION
      return false unless data["type"] == "lane_closed" && TERMINAL_STATES.include?(data["terminal"])
      return false unless gc_nonempty_string?(data["event_id"])
      return false unless gc_nonempty_string?(data["target"])

      data["repo"].is_a?(String) && data["repo"].match?(%r{\A[^/]+/[^/]+\z})
    end

    def gc_terminal_context_valid?(data)
      return false unless gc_nonempty_string?(data["workspace"])
      return false unless gc_valid_closed_by?(data["closed_by"]) && gc_valid_datetime?(data["at"])
      return false unless %w[batch_id lane branch pr_state].all? do |field|
        !data.key?(field) || gc_nonempty_string?(data[field])
      end

      %w[pr_url evidence_url].all? { |field| !data.key?(field) || gc_valid_http_uri?(data[field]) }
    end

    def gc_nonempty_string?(value)
      value.is_a?(String) && !value.empty?
    end

    def gc_valid_closed_by?(value)
      return false unless value.is_a?(Hash) && value.keys.sort == %w[agent_id machine]

      %w[agent_id machine].all? { |field| gc_nonempty_string?(value[field]) }
    end

    def gc_valid_datetime?(value)
      return false unless gc_nonempty_string?(value)

      match = value.match(RFC3339_PATTERN)
      return false unless match
      return false unless match[:hour].to_i.between?(0, 23)
      return false unless match[:minute].to_i.between?(0, 59)
      return false unless match[:second].to_i.between?(0, 60)
      return false if match[:offset_hour] && !match[:offset_hour].to_i.between?(0, 23)
      return false if match[:offset_minute] && !match[:offset_minute].to_i.between?(0, 59)

      DateTime.iso8601(value, Date::GREGORIAN)
      Time.iso8601(value)
      true
    rescue ArgumentError
      false
    end

    def gc_canonical_json(value)
      case value
      when Hash
        pairs = value.keys.sort.map do |key|
          "#{JSON.generate(key)}:#{gc_canonical_json(value.fetch(key))}"
        end
        "{#{pairs.join(',')}}"
      when Array
        "[#{value.map { |item| gc_canonical_json(item) }.join(',')}]"
      else
        JSON.generate(value)
      end
    end

    def gc_valid_http_uri?(value)
      return false unless gc_nonempty_string?(value) && !value.match?(/\s/)

      uri = URI.parse(value)
      %w[http https].include?(uri.scheme&.downcase) && !uri.host.to_s.empty?
    rescue URI::InvalidURIError
      false
    end

    def gc_compact_events(store, candidate, now, archive_days)
      entries = candidate.fetch(:entries)
      retained_entries = gc_compacted_entries(entries)
      action = candidate.fetch(:action)
      envelope = gc_compaction_envelope(entries, retained_entries, action, now, archive_days)
      archive_path = action.fetch("archive_path")
      begin
        store.write_json(archive_path, envelope, message: "Compact terminal events", create: true)
      rescue Conflict
        existing = store.read_json(archive_path)
        unless existing && gc_compaction_contains?(existing.data, entries, retained_entries)
          raise OperationalError, "event compaction destination conflict at #{archive_path}"
        end
      end
      entries.each do |entry|
        store.delete_json(entry.path, message: "Compact terminal events", sha: entry.sha)
      rescue Conflict => e
        raise OperationalError, "gc event changed at #{entry.path}; #{e.message}"
      end
    end

    def gc_compaction_envelope(entries, retained_entries, action, now, archive_days)
      {
        "schema_version" => SCHEMA_VERSION,
        "record_family" => "compacted_events",
        "source_paths" => action.fetch("source_paths"),
        "reason" => action.fetch("reason"),
        "synthetic" => entries.all? { |entry| entry.data["synthetic"] == true },
        "archived_at" => timestamp(now),
        "delete_after" => timestamp(now + (archive_days * 86_400)),
        "records" => retained_entries.map(&:data)
      }
    end

    def gc_compacted_entries(entries)
      ordered = entries.sort_by do |entry|
        [gc_record_time(entry.data, nil, entry.path), gc_terminal_event?(entry.data) ? 1 : 0, entry.path]
      end
      return ordered if ordered.length <= 2

      keep = [ordered.first, ordered.last]
      keep.concat(ordered.select { |entry| gc_terminal_event?(entry.data) })
      previous_phase = nil
      ordered.each do |entry|
        phase = entry.data["phase"]
        next if phase.to_s.empty?

        keep << entry if phase != previous_phase
        previous_phase = phase
      end
      keep.uniq.sort_by do |entry|
        [gc_record_time(entry.data, nil, entry.path), gc_terminal_event?(entry.data) ? 1 : 0, entry.path]
      end
    end

    def gc_compaction_contains?(existing, entries, retained_entries)
      return false unless existing["record_family"] == "compacted_events"

      source_paths = Array(existing["source_paths"])
      records = Array(existing["records"])
      entries.all? { |entry| source_paths.include?(entry.path) } &&
        retained_entries.all? { |entry| records.include?(entry.data) }
    end

    def gc_archive_delete_after(entry)
      data = entry.data
      unless %w[archived_record compacted_events].include?(data["record_family"])
        raise OperationalError, "archive record has unknown family at #{entry.path}"
      end

      Time.iso8601(data.fetch("delete_after")).utc
    rescue KeyError, ArgumentError
      raise OperationalError, "archive record has invalid delete_after at #{entry.path}"
    end

    def gc_delete_archive(store, candidate)
      entry = candidate.fetch(:entry)
      store.delete_json(entry.path, message: "Delete expired archive #{entry.path}", sha: entry.sha)
    rescue Conflict => e
      raise OperationalError, "gc archive changed at #{entry.path}; #{e.message}"
    end

    def gc_archive_record(store, candidate, now, archive_days)
      entry = candidate.fetch(:entry)
      action = candidate.fetch(:action)
      archive_path = action.fetch("archive_path")
      envelope = gc_archive_envelope(entry, action, now, archive_days)
      begin
        store.write_json(archive_path, envelope, message: "Archive #{entry.path}", create: true)
      rescue Conflict
        existing = store.read_json(archive_path)
        unless existing && gc_same_archived_record?(existing.data, envelope)
          raise OperationalError, "archive destination conflict at #{archive_path}"
        end
      end
      store.delete_json(entry.path, message: "Archive #{entry.path}", sha: entry.sha)
    rescue Conflict => e
      raise OperationalError, "gc source changed at #{entry.path}; #{e.message}"
    end

    def gc_replace_archive_record(store, candidate, now, archive_days)
      entry = candidate.fetch(:entry)
      existing = candidate.fetch(:existing_archive)
      action = candidate.fetch(:action)
      archive_path = action.fetch("archive_path")
      store.delete_json(archive_path, message: "Replace expired archive #{archive_path}", sha: existing.sha)
      envelope = gc_archive_envelope(entry, action, now, archive_days)
      store.write_json(archive_path, envelope, message: "Replace archive #{entry.path}", create: true)
      store.delete_json(entry.path, message: "Archive #{entry.path}", sha: entry.sha)
    rescue Conflict => e
      raise OperationalError, "gc archive replacement changed at #{archive_path}; #{e.message}"
    end

    def gc_archive_envelope(entry, action, now, archive_days)
      {
        "schema_version" => SCHEMA_VERSION,
        "record_family" => "archived_record",
        "source_path" => entry.path,
        "reason" => action.fetch("reason"),
        "synthetic" => entry.data["synthetic"] == true,
        "archived_at" => timestamp(now),
        "delete_after" => timestamp(now + (archive_days * 86_400)),
        "data" => entry.data
      }
    end

    def validate_gc_archive_sizes!(candidates, now, archive_days)
      candidates.each do |candidate|
        action = candidate.fetch(:action)
        envelope = case action.fetch("action")
                   when "archive", "replace_archive"
                     gc_archive_envelope(candidate.fetch(:entry), action, now, archive_days)
                   when "compact"
                     entries = candidate.fetch(:entries)
                     gc_compaction_envelope(entries, gc_compacted_entries(entries), action, now, archive_days)
                   end
        next unless envelope
        next if JSON.generate(envelope).bytesize <= MAX_ARCHIVE_STATE_BYTES

        raise OperationalError,
              "gc archive envelope exceeds #{MAX_ARCHIVE_STATE_BYTES} bytes at #{action.fetch('archive_path')}"
      end
    end

    def gc_same_archived_record?(existing, requested)
      existing["record_family"] == "archived_record" &&
        existing["source_path"] == requested["source_path"] &&
        existing["data"] == requested["data"]
    end

    def gc_archive_eligibility(entry, prefix, now)
      data = entry.data
      path = entry.path

      case prefix
      when "claims"
        return unless data["status"] == "released" || TERMINAL_STATES.include?(data["terminal"])

        ["terminal_claim", gc_record_time(data, nil, path)]
      when "heartbeats"
        if HEARTBEAT_TERMINAL_STATUSES.include?(data["status"])
          ["terminal_heartbeat", gc_record_time(data, nil, path)]
        elsif heartbeat_liveness(data, now) == "dead"
          ["dead_heartbeat", gc_heartbeat_dead_at(data, path)]
        end
      when "batches"
        return unless data["status"] == "completed"

        ["completed_batch", gc_record_time(data, "completed_at", path)]
      end
    end

    def gc_record_time(data, preferred = nil, path = nil)
      candidates = [preferred, "updated_at", "at", "released_at", "completed_at", "expires_at"].compact
      value = candidates.filter_map { |field| data[field] }.first
      location = path ? " at #{path}" : ""
      raise OperationalError, "gc record is missing a retention timestamp#{location}" unless value

      Time.iso8601(value).utc
    rescue ArgumentError, TypeError
      raise OperationalError, "gc record has invalid retention timestamp#{location}: #{value}"
    end

    def gc_heartbeat_dead_at(data, path = nil)
      updated_at = Time.iso8601(data.fetch("updated_at")).utc
      expires_at = Time.iso8601(data.fetch("expires_at")).utc
      ttl = expires_at - updated_at
      updated_at + (ttl * HEARTBEAT_DEAD_AFTER_TTL_MULTIPLIER)
    rescue KeyError, ArgumentError
      gc_record_time(data, nil, path)
    end

    def render_gc_text(payload)
      @stdout.puts "gc #{payload.fetch('mode')} hot=#{payload.dig('policy', 'hot_days')}d " \
                   "archive=#{payload.dig('policy', 'archive_days')}d " \
                   "synthetic_hot=#{payload.dig('policy', 'synthetic_hot_days')}d"
      if payload.fetch("actions").empty?
        @stdout.puts "- no actions"
      else
        payload.fetch("actions").each { |action| @stdout.puts "- #{gc_action_text(action)}" }
      end
    end

    def gc_action_text(action)
      source = action["source_path"] || Array(action["source_paths"]).join(",")
      destination = action["archive_path"] ? " -> #{action['archive_path']}" : ""
      "#{action.fetch('action')} #{source}#{destination} (#{action.fetch('reason')})"
    end

    def deep_option_token?(argv, command:)
      standalone_option_token?(argv, "--deep", command:)
    end

    def stack_json_option_token?(argv)
      standalone_option_token?(argv, "--stack-json", command: "doctor")
    end

    def standalone_option_token?(argv, token, command:)
      standalone_option_token_count(argv, [token], command:).positive?
    end

    # One walk over raw argv, shared by every pre-parse scan. Yields each
    # argument as (index, its resolved option, the option it is the value of,
    # whether it is awaiting a separate value, its inline value). Arguments
    # are expected to be BINARY copies: String#split raises on a UTF-8-tagged
    # string holding invalid bytes, which is reachable from every caller.
    def scan_raw_options(argv, command:)
      command_options = registered_options(command)
      doctor_options = command == "doctor" ? command_options : registered_options("doctor")
      value_options = command_options.value_options
      awaiting = nil
      argv.each_with_index do |argument, index|
        if awaiting
          yield(index, nil, awaiting, false, nil)
          awaiting = nil
          next
        end

        break if argument == "--"

        option_name, inline_value = argument.split("=", 2)
        option = resolve_standalone_option(option_name, command_options, doctor_options)
        awaiting = option if inline_value.nil? && value_options.include?(option)
        yield(index, option, nil, !awaiting.nil?, inline_value)
      end
    end

    def standalone_option_token_count(argv, tokens, command:)
      count = 0
      scan_raw_options(argv, command:) do |_index, option, value_of, awaits_value|
        count += 1 if value_of.nil? && !awaits_value && tokens.include?(option)
      end
      count
    end

    def resolve_standalone_option(option_name, command_options, target_options)
      return "-h" if option_name == "-h"
      return unless option_name&.start_with?("--")

      all_options = command_options.long_options | target_options.long_options
      matches = all_options.select { |candidate| candidate.start_with?(option_name) }
      command_matches = matches & command_options.long_options
      command_option = exact_or_unique_long_option(option_name, command_matches)
      return command_option if command_options.value_options.include?(command_option)

      exact_or_unique_long_option(option_name, matches & target_options.long_options)
    end

    def exact_or_unique_long_option(option_name, matches)
      return option_name if matches.include?(option_name)

      matches.one? ? matches.first : nil
    end

    def registered_options(command)
      _, registry = build_option_parser(
        command,
        default_options,
        { stack_json: false, backend_selector_count: 0 }
      )
      registry
    end

    def claim(options)
      require_options(options, :agent_id, :repo, :target)
      ttl = positive_ttl(options[:ttl] || DEFAULT_CLAIM_TTL)
      now = now_utc
      expires_at = now + ttl
      path = AgentCoord.claim_path(options.fetch(:repo), options.fetch(:target))
      store = build_store(options)
      existing = store.read_json(path)

      if existing && active_claim_record?(existing.data) && existing.data["agent_id"] != options[:agent_id]
        holder_state = claim_holder_state(store, existing.data, now)
        unless takeover_allowed?(holder_state)
          raise ClaimRefused, claim_refusal_message(options, existing.data, holder_state)
        end
      end

      claim_updates = {
        "schema_version" => SCHEMA_VERSION,
        "repo" => options.fetch(:repo),
        "target" => options.fetch(:target).to_s,
        "agent_id" => options.fetch(:agent_id),
        "batch_id" => options[:batch_id],
        "branch" => options[:branch],
        "status" => "active",
        "claimed_at" => claim_timestamp(existing, options, now),
        "updated_at" => timestamp(now),
        "expires_at" => timestamp(expires_at)
      }.compact
      payload = preserved_payload(existing, claim_preserved_fields(existing, options))
                .merge(claim_updates)
                .merge(metadata_payload(options))
                .merge(environment_identity_payload(existing&.data))
                .compact

      begin
        write_with_cas(store, path, payload, existing, "Claim #{options[:repo]}##{options[:target]}")
      rescue Conflict => e
        raise OperationalError, "claim write contention for #{options[:repo]}##{options[:target]}; #{e.message}"
      end
      record_claim_acquired_event(store, payload, now) if claim_acquired_event?(existing, options)
      @stdout.puts "claimed #{options[:repo]}##{options[:target]} by #{options[:agent_id]} " \
                   "until #{timestamp(expires_at)}"
      0
    ensure
      close_store(store)
    end

    def release(options)
      require_options(options, :agent_id, :repo, :target)
      validate_terminal_options!(options)
      now = now_utc
      path = AgentCoord.claim_path(options.fetch(:repo), options.fetch(:target))
      store = build_store(options)
      existing = store.read_json(path)
      raise Error, "no claim exists for #{options[:repo]}##{options[:target]}" unless existing

      holder = existing.data["agent_id"]
      if holder && holder != options[:agent_id]
        raise Error, "claim belongs to #{holder}; #{options[:agent_id]} cannot release it"
      end

      release_updates = {
        "agent_id" => holder || options[:agent_id],
        "status" => "released",
        "released_by" => options[:agent_id],
        "released_at" => timestamp(now),
        "updated_at" => timestamp(now),
        "expires_at" => timestamp(now)
      }
      payload = existing.data.merge(release_updates).merge(metadata_payload(options))
                        .merge(environment_identity_payload(existing.data)).compact
      payload = without_handoff_payload(payload)
      payload = payload.merge(handoff_payload(options)) if handoff_release?(options)
      payload["branch"] = options[:branch] if options[:branch]
      payload = terminal_release_payload(payload, options)
      validate_terminal_contract_payload!(payload) if options[:terminal]

      if options[:terminal]
        close_terminal_release(store, existing, payload, now, options)
        return 0
      end
      store.write_json(path, payload, message: "Release #{options[:repo]}##{options[:target]}", sha: existing.sha)
      record_release_event(store, payload, now)
      @stdout.puts "released #{options[:repo]}##{options[:target]} by #{options[:agent_id]}"
      0
    ensure
      close_store(store)
    end

    def render_version(options)
      payload = {
        "version" => VERSION,
        "schema_version" => SCHEMA_VERSION,
        "lane_closed_schema_version" => LANE_CLOSED_SCHEMA_VERSION,
        "archive_schema_version" => ARCHIVE_SCHEMA_VERSION,
        "default_backend" => DEFAULT_BACKEND,
        "default_ref" => DEFAULT_REF
      }
      emit_payload(payload, options) do
        @stdout.puts "agent-coord #{VERSION}"
        @stdout.puts "schema_version: #{SCHEMA_VERSION}"
        @stdout.puts "lane_closed_schema_version: #{LANE_CLOSED_SCHEMA_VERSION}"
        @stdout.puts "archive_schema_version: #{ARCHIVE_SCHEMA_VERSION}"
        @stdout.puts "default_backend: #{default_backend_text}"
        @stdout.puts "default_ref: #{DEFAULT_REF}"
      end
      0
    end

    def render_config(options)
      payload = config_payload(options)
      emit_payload(payload, options) do
        @stdout.puts "agent-coord config"
        @stdout.puts "version: #{payload.fetch('version')}"
        @stdout.puts "default_backend: #{default_backend_text}"
        @stdout.puts "default_claim_ttl_seconds: #{payload.fetch('default_claim_ttl_seconds')}"
        @stdout.puts "default_heartbeat_ttl_seconds: #{payload.fetch('default_heartbeat_ttl_seconds')}"
        @stdout.puts "heartbeat_dead_after_ttl_multiplier: #{payload.fetch('heartbeat_dead_after_ttl_multiplier')}"
        @stdout.puts "retention_policy: " \
                     "hot=#{payload.dig('retention_policy', 'hot_days')}d," \
                     "archive=#{payload.dig('retention_policy', 'archive_days')}d," \
                     "synthetic_hot=#{payload.dig('retention_policy', 'synthetic_hot_days')}d"
        @stdout.puts "dependency_terminal_statuses: #{payload.fetch('dependency_terminal_statuses').join(',')}"
        @stdout.puts "heartbeat_working_statuses: #{payload.dig('heartbeat_status_vocabulary', 'working').join(',')}"
        @stdout.puts "heartbeat_terminal_statuses: #{payload.dig('heartbeat_status_vocabulary', 'terminal').join(',')}"
        @stdout.puts "exit_codes: #{payload.fetch('exit_codes').map { |name, code| "#{name}=#{code}" }.join(',')}"
        coordination = payload.fetch("coordination")
        @stdout.puts "coordination_policy: #{coordination.fetch('policy')}"
        @stdout.puts "coordination_backend: #{coordination.fetch('backend')}"
        @stdout.puts "coordination_configured: #{coordination.fetch('configured')}"
      end
      0
    end

    def persist_config(options)
      unless @user_config_path
        raise OperationalError, "cannot persist user config; set XDG_CONFIG_HOME, HOME, or AGENT_COORD_ENV_FILE"
      end

      updates = {}
      if options[:api_url_cli]
        validate_config_api_url!(options.fetch(:api_url))
        updates["AGENT_COORD_API_URL"] = options.fetch(:api_url)
      end
      updates["AGENT_COORD_API_TOKEN"] = read_token_from_stdin if options[:token_stdin]
      if options[:machine_id_given]
        AgentCoord.validate_segment!(options.fetch(:machine_id), "machine-id")
        updates[MACHINE_ID_ENV] = options.fetch(:machine_id)
      end
      policy = options[:policy] if options[:policy_given]
      validate_policy!(policy, "--policy") if policy
      updates[POLICY_ENV] = policy if policy
      raise Error, "config set requires at least one setting" if updates.empty?

      with_config_write_lock do
        current = read_user_env_file(@user_config_path, required: false)
        validate_token_update_url_stability!(current, updates)
        validate_api_url_token_transition!(current, updates)
        merged = current.merge(updates)
        validate_config_token_binding!(merged)
        write_canonical_config_file(@user_config_path, render_user_env(merged))
      end
      @stdout.puts "updated user configuration: #{@user_config_path} (#{updates.keys.sort.join(', ')})" \
        unless updates.empty?
      @stdout.puts "updated coordination policy in canonical config: #{@user_config_path}" if policy
      0
    end

    def validate_token_update_url_stability!(current, updates)
      return unless updates.key?("AGENT_COORD_API_TOKEN")
      return if updates.key?("AGENT_COORD_API_URL")
      return if @user_config.fetch("AGENT_COORD_API_URL", nil) == current.fetch("AGENT_COORD_API_URL", nil)

      raise Error, "saved API URL changed while reading --token-stdin; retry with --api-url in the same transaction"
    end

    def validate_api_url_token_transition!(current, updates)
      return unless updates.key?("AGENT_COORD_API_URL")
      return if updates.key?("AGENT_COORD_API_TOKEN")
      return if current.fetch("AGENT_COORD_API_URL", nil) == updates.fetch("AGENT_COORD_API_URL")
      return unless AgentCoord.config_value_set?(current.fetch("AGENT_COORD_API_TOKEN", ""))

      raise Error, "--token-stdin is required when changing an API URL that has a saved token"
    end

    def validate_config_token_binding!(values)
      return unless AgentCoord.config_value_set?(values.fetch("AGENT_COORD_API_TOKEN", ""))
      return if AgentCoord.config_value_set?(values.fetch("AGENT_COORD_API_URL", ""))

      raise Error, "--token-stdin requires a saved API URL or --api-url in the same transaction"
    end

    def validate_config_api_url!(value)
      uri = URI.parse(value)
      unless %w[http https].include?(uri.scheme) && uri.host && !uri.host.empty?
        raise Error, "--api-url must be an absolute HTTP(S) URL"
      end
      raise Error, "--api-url must not include a query or fragment" if uri.query || uri.fragment
      raise Error, "--api-url port must be between 1 and 65535" unless HttpStore::VALID_PORT_RANGE.cover?(uri.port)
      if uri.scheme == "http" && !HttpStore::LOOPBACK_HOSTS.include?(uri.hostname.to_s.downcase)
        raise Error, "--api-url must use https unless it points at localhost"
      end
    rescue URI::InvalidURIError
      raise Error, "--api-url must be an absolute HTTP(S) URL"
    end

    def read_token_from_stdin
      token = @stdin.read(65_537).to_s
      raise Error, "--token-stdin input is too large" if token.bytesize > 65_536

      token = token.dup.force_encoding(Encoding::UTF_8)
      raise Error, "--token-stdin token must be valid UTF-8" unless token.valid_encoding?

      token = token.sub(/\r?\n\z/, "")
      # Reject blank input, but persist the unstripped value: internal and
      # trailing whitespace inside a real token is significant.
      raise Error, "--token-stdin requires a non-empty token" unless AgentCoord.config_value_set?(token)
      raise Error, "--token-stdin token must be one line" if token.match?(/[\r\n\0]/)

      token
    rescue IOError, SystemCallError => e
      raise Error, "--token-stdin could not read from stdin: #{e.message}"
    end

    def render_user_env(values)
      lines = USER_CONFIG_ENV_KEYS.filter_map do |key|
        next unless values.key?(key)

        "#{key}=#{Shellwords.escape(values.fetch(key))}"
      end
      "#{lines.join("\n")}\n"
    end

    def with_optional_config_read_lock
      return yield unless @user_config_path

      # The writer derives its lock identity from the resolved config directory,
      # so the reader has to resolve the same chain first. Digesting the
      # unresolved path puts the two sides on different lock files whenever an
      # ancestor is a symlink, and the reader then degrades to no lock forever.
      directory = resolved_user_config_directory
      return yield unless directory

      lock_path = user_config_lock_path(directory)
      lock = begin
        File.open(lock_path, File::RDONLY | File::NOFOLLOW | File::NONBLOCK)
      rescue Errno::ENOENT
        nil
      rescue Errno::ELOOP
        raise OperationalError, "config lock must not be a symlink: #{lock_path}"
      rescue SystemCallError => e
        raise OperationalError, "cannot acquire config read lock #{lock_path}: #{e.message}"
      end
      return yield unless lock

      begin
        validate_private_config_file!(lock, lock_path)
        raise OperationalError, "cannot acquire config read lock: #{lock_path}" unless lock.flock(File::LOCK_SH)
      rescue SystemCallError => e
        lock.close
        raise OperationalError, "cannot acquire config read lock #{lock_path}: #{e.message}"
      rescue StandardError
        lock.close
        raise
      end

      begin
        yield
      ensure
        begin
          lock.flock(File::LOCK_UN)
        ensure
          lock.close
        end
      end
    end

    def with_config_write_lock
      directory = validate_secure_directory_chain!(
        File.dirname(@user_config_path),
        create: true,
        private_leaf: dedicated_user_config_parent?
      )
      lock_path = user_config_lock_path(directory)
      File.open(lock_path, File::RDWR | File::CREAT | File::NOFOLLOW, 0o600) do |lock|
        validate_private_config_file!(lock, lock_path)
        # Same umask hazard as the staged config file, and the reader opens this
        # lock read-only. Chmod after validation so a pre-existing insecure lock
        # is still reported instead of quietly repaired.
        lock.chmod(0o600)
        raise OperationalError, "cannot acquire config write lock: #{lock_path}" unless lock.flock(File::LOCK_EX)

        yield
      ensure
        lock&.flock(File::LOCK_UN)
      end
    rescue Errno::ELOOP
      raise OperationalError, "config lock must not be a symlink: #{lock_path}"
    rescue SystemCallError => e
      raise OperationalError, "cannot acquire config write lock #{lock_path}: #{e.message}"
    end

    # Resolution runs before any ownership check, exactly like the write path:
    # the lock is still opened with NOFOLLOW and validate_private_config_file!
    # re-validates the resolved parent chain before the lock is honored. A
    # missing config directory is the ordinary "nothing configured yet" case and
    # must stay lock-free rather than fail closed; anything else still fails.
    def resolved_user_config_directory
      File.realpath(File.dirname(@user_config_path))
    rescue Errno::ENOENT, Errno::ENOTDIR
      nil
    rescue Errno::ELOOP
      raise OperationalError, "config parent must not be a symlink loop: #{File.dirname(@user_config_path)}"
    rescue SystemCallError => e
      raise OperationalError, "cannot resolve config parent #{File.dirname(@user_config_path)}: #{e.message}"
    end

    def user_config_lock_path(directory)
      destination = File.join(directory, File.basename(@user_config_path))
      digest = Digest::SHA256.hexdigest(destination)[0, 16]
      File.join(directory, ".agent-coord-config-#{digest}.lock")
    end

    def validate_secure_directory_chain!(directory, create:, private_leaf: true)
      expanded = File.expand_path(directory)
      current = File::SEPARATOR
      validate_secure_directory_component!(File.lstat(current), current, leaf: private_leaf && expanded == current)
      components = expanded.split(File::SEPARATOR).reject(&:empty?)

      components.each_with_index do |component, index|
        candidate = File.join(current, component)
        stat = secure_directory_lstat(candidate, create:)
        leaf = private_leaf && index == components.length - 1
        if stat.symlink?
          unless trusted_config_parent_symlink?(stat)
            raise OperationalError, "config parent must not contain a user-controlled symlink: #{candidate}"
          end

          current = File.realpath(candidate)
          validate_resolved_directory_chain!(current, leaf:)
          next
        end

        validate_secure_directory_component!(stat, candidate, leaf:)
        current = candidate
      end
      current
    rescue SystemCallError => e
      raise OperationalError, "cannot validate config parent #{directory}: #{e.message}"
    end

    def dedicated_user_config_parent?
      !@user_config_path_explicit
    end

    # POSIX ignores symlink permission bits (Linux reports them as 0777), so
    # ownership is the meaningful control boundary. Root- and current-user-owned
    # links are trusted for the same reason root- and current-user-owned
    # directories are: the standard dotfiles layouts (GNU stow, dotbot) link
    # ~/.config into a user-owned repository, and refusing that would break every
    # command rather than just config writes. The resolved target chain is
    # validated separately before traversal continues, so a trusted link cannot
    # smuggle in an unsafe destination.
    def trusted_config_parent_symlink?(stat)
      stat.uid.zero? || stat.uid == Process.uid
    end

    def validate_resolved_directory_chain!(directory, leaf:)
      expanded = File.expand_path(directory)
      current = File::SEPARATOR
      validate_secure_directory_component!(File.lstat(current), current, leaf: leaf && expanded == current)
      components = expanded.split(File::SEPARATOR).reject(&:empty?)

      components.each_with_index do |component, index|
        current = File.join(current, component)
        stat = File.lstat(current)
        validate_secure_directory_component!(stat, current, leaf: leaf && index == components.length - 1)
      end
      expanded
    end

    def secure_directory_lstat(path, create:)
      File.lstat(path)
    rescue Errno::ENOENT
      raise unless create

      begin
        Dir.mkdir(path, 0o700)
      rescue Errno::EEXIST
        nil
      end
      File.lstat(path)
    end

    def validate_secure_directory_component!(stat, path, leaf:)
      raise OperationalError, "config parent component is not a directory: #{path}" unless stat.directory?
      unless [0, Process.uid].include?(stat.uid)
        raise OperationalError, "config parent component has an unsafe owner: #{path}"
      end
      raise OperationalError, "config parent permissions are unsafe: #{path}" unless stat.mode.nobits?(0o022)
      return unless leaf

      raise OperationalError, "config parent leaf is not owned by the current user: #{path}" if stat.uid != Process.uid

      stat = harden_legacy_config_leaf!(stat, path) unless stat.mode.nobits?(0o077)
      return if stat.mode.nobits?(0o077)

      raise OperationalError, "config parent leaf permissions are unsafe (expected 0700): #{path}"
    end

    def harden_legacy_config_leaf!(expected_stat, path)
      File.open(path, File::RDONLY | File::NOFOLLOW) do |directory|
        current_stat = directory.stat
        unless current_stat.directory? && current_stat.dev == expected_stat.dev && current_stat.ino == expected_stat.ino
          raise OperationalError, "config parent leaf changed while hardening permissions: #{path}"
        end
        if current_stat.uid != Process.uid || !current_stat.mode.nobits?(0o022)
          raise OperationalError, "config parent leaf became unsafe while hardening permissions: #{path}"
        end

        directory.chmod(0o700)
        directory.stat
      end
    rescue Errno::ELOOP
      raise OperationalError, "config parent leaf must not be a symlink: #{path}"
    end

    def write_canonical_config_file(path, contents)
      directory = validate_secure_directory_chain!(
        File.dirname(path),
        create: true,
        private_leaf: dedicated_user_config_parent?
      )
      destination = File.join(directory, File.basename(path))
      temp_path = File.join(directory, ".#{File.basename(path)}.tmp-#{Process.pid}-#{SecureRandom.hex(6)}")
      write_private_config_temp_file(temp_path, contents)
      File.rename(temp_path, destination)
      File.open(directory, File::RDONLY | File::NOFOLLOW) do |directory_file|
        validate_secure_directory_component!(
          directory_file.stat,
          directory,
          leaf: dedicated_user_config_parent?
        )
        # The rename already committed, so an unsupported directory fsync must
        # not be reported as a write failure. Reuse the shared errno tolerance
        # rather than restating it, but sync the descriptor validated just above
        # instead of the path the helper would reopen.
        AgentCoord.fsync_parent_directory(destination) { directory_file.fsync }
      end
    rescue SystemCallError => e
      raise OperationalError, "cannot persist canonical user configuration: #{e.message}"
    ensure
      FileUtils.rm_f(temp_path) if temp_path
    end

    def write_private_config_temp_file(path, contents)
      File.open(path, File::WRONLY | File::CREAT | File::EXCL | File::NOFOLLOW, 0o600) do |file|
        # open(2) filters the requested mode through the caller's umask, so a
        # restrictive umask can strip owner-read and leave a 0200 file that this
        # CLI can no longer read back. Restate the mode on the descriptor we
        # already hold rather than on a path an attacker could swap.
        file.chmod(0o600)
        file.write(contents)
        file.flush
        file.fsync
      end
    end

    def default_backend_text
      DEFAULT_BACKEND || "none"
    end

    def doctor(options)
      return stack_doctor(options) if options[:stack_json]

      backend_kind = doctor_backend_kind(options)
      begin
        FileUtils.mkdir_p(options.fetch(:state_root)) if options[:implicit_local]
        store = verify_doctor_store(options, backend_kind, deep: options[:deep])
        store.verify_layout!(STATE_PREFIXES)
        section_notes, resource_checks, identity = doctor_deep_results(store, backend_kind, options)
      rescue JSON::ParserError, SystemCallError => e
        raise OperationalError, "state unreadable: #{e.message}"
      end

      payload = doctor_payload(options, backend_kind, options[:deep])
      payload["resource_checks"] = resource_checks if resource_checks
      payload["identity"] = identity if identity
      environment_identity = options[:deep] ? environment_identity_report(identity) : nil
      if environment_identity
        payload["environment_identity"] = environment_identity
        payload["status"] = "error" if machine_identity_mismatch?(environment_identity)
      end
      unless section_notes.empty?
        payload["degraded"] = section_notes.values.uniq
        payload["section_notes"] = section_notes
      end
      emit_payload(payload, options) do
        render_doctor_text(payload, options, section_notes)
      end
      raise_machine_identity_mismatch!(environment_identity) if environment_identity
      raise_consumer_split_brain!(payload)
      0
    ensure
      close_store(store)
    end

    # Structured non-secret machine/session attribution for doctor consumers.
    # token_machine comes from /v1/whoami when the deep HTTP doctor ran; the
    # environment tuple is metadata only and never carries token values.
    def environment_identity_report(token_identity)
      session_id, session_source = AgentCoord.environment_session_identity
      machine_id = AgentCoord.environment_machine_id
      token_machine = token_identity && token_identity["machine"].to_s
      token_machine = nil if token_machine.to_s.empty?
      {
        "client_version" => VERSION,
        "machine_id" => machine_id,
        "session_id" => session_id,
        "session_source" => session_source,
        "token_machine" => token_machine,
        "machine_match" => machine_match_status(machine_id, token_machine)
      }
    end

    def machine_match_status(machine_id, token_machine)
      return MACHINE_MATCH_UNVERIFIED unless machine_id && token_machine

      machine_id == token_machine ? MACHINE_MATCH_MATCH : MACHINE_MATCH_MISMATCH
    end

    def machine_identity_mismatch?(environment_identity)
      environment_identity.fetch("machine_match") == MACHINE_MATCH_MISMATCH
    end

    def raise_consumer_split_brain!(payload)
      env_file = payload["split_brain_env_file"]
      return unless env_file

      raise OperationalError, consumer_split_brain_message(env_file)
    end

    def raise_machine_identity_mismatch!(environment_identity)
      return unless machine_identity_mismatch?(environment_identity)

      raise OperationalError,
            "machine identity mismatch: #{MACHINE_ID_ENV}=#{environment_identity.fetch('machine_id')} does not " \
            "match the authenticated backend token machine #{environment_identity.fetch('token_machine')}; " \
            "the wrong machine token or #{MACHINE_ID_ENV} value may be installed on this machine"
    end

    def stack_doctor(options)
      backend_kind = doctor_backend_kind(options)
      checks = [
        stack_check(
          "cli.version",
          "healthy",
          "agent-coord CLI is ready",
          { "version" => VERSION }
        )
      ]
      store = verify_doctor_store(options, backend_kind, deep: options[:deep], read_only: true)
      store.verify_layout!(STATE_PREFIXES)
      checks << stack_check(
        "backend.readability",
        "healthy",
        "Coordination backend is readable",
        stack_backend_details(options, backend_kind)
      )
    rescue OperationalError, JSON::ParserError, SystemCallError => e
      emit_failed_stack_backend_report(checks, options, backend_kind, e.message)
    rescue StandardError => e
      emit_failed_stack_backend_report(
        checks, options, backend_kind, "Unexpected backend-readability failure",
        error_class: safe_stack_error_class(e)
      )
    else
      resource_check = stack_resource_check(store, backend_kind, options)
      checks << resource_check
      checks << stack_identity_check(resource_check.dig("details", "identity"))
      emit_stack_report(checks)
    ensure
      close_store(store)
    end

    def emit_failed_stack_backend_report(checks, options, backend_kind, error, error_class: nil)
      details = stack_backend_details(options, backend_kind).merge("error" => error)
      details["error_class"] = error_class if error_class
      checks << stack_check(
        "backend.readability",
        "failed",
        "Coordination backend is not readable",
        details,
        "Restore access to the configured coordination backend, then rerun the doctor."
      )
      checks << stack_check(
        "resources.deep",
        "skipped",
        "Resource evidence was not collected because the backend is unavailable",
        { "mode" => options[:deep] ? "deep" : "shallow", "reason" => "backend_unavailable" }
      )
      checks << stack_identity_check(nil)
      emit_stack_report(checks)
    end

    def stack_check(id, status, summary, details, guidance = nil)
      {
        "id" => id,
        "status" => status,
        "summary" => summary,
        "details" => details,
        "guidance" => guidance
      }
    end

    # Machine identity provenance for stack aggregators. The environment tuple
    # is non-secret attribution metadata; an environment machine id that
    # contradicts the authenticated token machine is a failed component check
    # because the wrong machine token may be installed.
    def stack_identity_check(token_identity)
      report = environment_identity_report(token_identity)
      case report.fetch("machine_match")
      when MACHINE_MATCH_MISMATCH
        stack_check(
          "identity.machine",
          "failed",
          "Environment machine id contradicts the authenticated backend token machine",
          report,
          "Install the machine token matching #{MACHINE_ID_ENV}, or correct the exported machine id, " \
          "then rerun the deep doctor."
        )
      when MACHINE_MATCH_MATCH
        stack_check(
          "identity.machine",
          "healthy",
          "Environment machine id matches the authenticated backend token machine",
          report
        )
      else
        stack_check(
          "identity.machine",
          "skipped",
          "Machine identity was not verified against an authenticated backend token machine",
          report
        )
      end
    end

    def stack_backend_details(options, backend_kind)
      {
        "backend" => backend_kind,
        "backend_repo" => backend_kind == "github" ? options.fetch(:backend) : nil,
        "backend_url" => active_backend_url(options, backend_kind),
        "state_root" => backend_kind == "local" ? options[:state_root] : nil
      }
    end

    def stack_resource_check(store, backend_kind, options)
      unless options[:deep]
        return stack_check(
          "resources.deep",
          "skipped",
          "Deep resource evidence was not requested",
          { "mode" => "shallow" }
        )
      end

      section_notes, resource_checks, identity = doctor_deep_results(store, backend_kind, options)
      details = stack_resource_scope_details(options)
      details["resource_checks"] = resource_checks if resource_checks
      details["identity"] = identity if identity
      unless section_notes.empty?
        details["notes"] = section_notes
        return stack_check(
          "resources.deep",
          "degraded",
          "Deep coordination resource evidence is incomplete",
          details,
          "Review the resource notes and backend capabilities before relying on unavailable evidence."
        )
      end

      summary = if doctor_prefix_supplied?(options)
                  "Requested coordination resource is readable"
                else
                  "Deep coordination resources are readable"
                end
      stack_check(
        "resources.deep",
        "healthy",
        summary,
        details
      )
    rescue OperationalError, JSON::ParserError, SystemCallError => e
      error = e.is_a?(OperationalError) ? e.message : "state unreadable: #{e.message}"
      failed_stack_resource_check(options, error)
    rescue StandardError => e
      failed_stack_resource_check(options, "Unexpected resource-check failure", error_class: safe_stack_error_class(e))
    end

    def failed_stack_resource_check(options, error, error_class: nil)
      details = stack_resource_scope_details(options).merge("error" => error)
      details["error_class"] = error_class if error_class
      stack_check(
        "resources.deep",
        "failed",
        "Deep coordination resource evidence is unreadable",
        details,
        "Repair or restore the unreadable coordination state, then rerun the deep doctor."
      )
    end

    def safe_stack_error_class(error)
      name = error.class.name.to_s
      name.match?(/\A[A-Z]\w*(?:::[A-Z]\w*)*\z/) ? name : "StandardError"
    end

    def stack_resource_scope_details(options)
      prefixes = doctor_prefix_supplied?(options) ? [doctor_read_prefix(options)] : STATE_PREFIXES
      details = { "mode" => "deep", "prefixes" => prefixes }
      if doctor_prefix_supplied?(options)
        probed_families = prefixes.map { |prefix| prefix.split("/", 2).first }
        details["unprobed_prefixes"] = STATE_PREFIXES - probed_families
      end
      details
    end

    def stack_report(checks)
      status = if checks.any? { |check| check.fetch("status") == "failed" }
                 "failed"
               elsif checks.any? { |check| check.fetch("status") == "degraded" }
                 "degraded"
               else
                 "healthy"
               end
      {
        "schema_version" => 1,
        "component" => "agent-coordination",
        "status" => status,
        "checks" => checks
      }
    end

    def emit_stack_report(checks)
      report = stack_report(checks)
      @stdout.puts JSON.pretty_generate(report)
      { "healthy" => 0, "degraded" => 1, "failed" => 2 }.fetch(report.fetch("status"))
    end

    def doctor_payload(options, backend_kind, deep)
      payload = {
        "version" => VERSION,
        "backend" => backend_kind,
        "backend_repo" => options.fetch(:backend),
        "backend_url" => active_backend_url(options, backend_kind),
        "state_root" => options[:state_root],
        "deep" => !deep.nil?,
        "status" => "ok"
      }
      split_brain_file = consumer_split_brain_env_file(options)
      if split_brain_file
        payload["status"] = "split_brain"
        payload["split_brain_env_file"] = split_brain_file
      end
      if backend_kind == "http" || doctor_prefix_supplied?(options)
        payload["doctor_prefix"] = doctor_read_prefix(options)
      end
      payload
    end

    def doctor_deep_results(store, backend_kind, options)
      return [{}, nil, nil] unless options[:deep]

      if doctor_prefix_supplied?(options) && (options[:stack_json] || backend_kind == "http")
        prefix = doctor_read_prefix(options)
        api_url = options[:api_url] if backend_kind == "http"
        section_notes, resource_checks = check_custom_resource!(store, prefix, api_url:)
        identity = store.whoami if backend_kind == "http"
        return [section_notes, resource_checks, identity]
      end
      return [check_state_readable!(store), nil, nil] unless backend_kind == "http"

      section_notes, resource_checks = check_http_resources!(store, api_url: options[:api_url])
      [section_notes, resource_checks, store.whoami]
    end

    def render_doctor_text(payload, options, section_notes)
      @stdout.puts "agent-coord doctor"
      %w[version backend backend_repo].each { |key| @stdout.puts "#{key}: #{payload.fetch(key)}" }
      @stdout.puts "backend_url: #{payload.fetch('backend_url')}" if payload.fetch("backend") == "http"
      @stdout.puts "doctor_prefix: #{payload.fetch('doctor_prefix')}" if payload["doctor_prefix"]
      @stdout.puts "state_root: #{options[:state_root] || '-'}"
      @stdout.puts "mode: #{payload.fetch('deep') ? 'deep' : 'lightweight'}"
      @stdout.puts "status: #{payload.fetch('status')}"
      render_doctor_split_brain(payload)
      render_doctor_http_details(payload)
      render_doctor_environment_identity(payload)
      return if section_notes.empty?

      @stdout.puts "degraded"
      section_notes.values.uniq.each { |note| @stdout.puts "- #{note}" }
    end

    def render_doctor_split_brain(payload)
      env_file = payload["split_brain_env_file"]
      return unless env_file

      # The remediation text arrives once, on stderr, from the error raised after
      # the report is emitted.
      @stdout.puts "split_brain_env_file: #{env_file}"
    end

    def render_doctor_http_details(payload)
      if payload["resource_checks"]
        @stdout.puts "resource_checks"
        payload.fetch("resource_checks").each { |prefix, status| @stdout.puts "- #{prefix}: #{status}" }
      end
      return unless payload["identity"]

      identity = payload.fetch("identity")
      @stdout.puts "machine: #{identity.fetch('machine')}"
      @stdout.puts "read_prefixes: #{format_scope_list(identity.fetch('read_prefixes'))}"
      @stdout.puts "write_prefixes: #{format_scope_list(identity.fetch('write_prefixes'))}"
    end

    def render_doctor_environment_identity(payload)
      identity = payload["environment_identity"]
      return unless identity

      @stdout.puts "machine_id: #{identity.fetch('machine_id') || '-'}"
      @stdout.puts "session_id: #{identity.fetch('session_id') || '-'}"
      @stdout.puts "session_source: #{identity.fetch('session_source')}"
      @stdout.puts "machine_match: #{identity.fetch('machine_match')}"
    end

    def doctor_backend_kind(options)
      return "http" if options[:api_url] && !options[:state_root]
      return "local" if options[:state_root]
      return "github" unless options[:backend].to_s.empty?

      "unconfigured"
    end

    def verify_doctor_store(options, backend_kind, deep: false, read_only: false)
      store = nil
      case backend_kind
      when "http"
        store = build_store(options)
        store.verify_readable!(doctor_read_prefix(options)) unless deep
      when "local"
        store = LocalStore.new(options.fetch(:state_root))
        read_only ? store.verify_readable_root! : store.verify_root!
      when "github"
        check_command!("gh", "auth", "status")
        check_command!("gh", "repo", "view", options.fetch(:backend))
        store = build_store(options)
        store.verify_not_archived!
        store.verify_readable!
      else
        store = build_store(options)
      end
      store
    rescue StandardError
      close_store(store)
      raise
    end

    def doctor_read_prefix(options)
      options.fetch(:doctor_prefix, JSON_PREFIXES.first)
    end

    def doctor_prefix_supplied?(options)
      options.key?(:doctor_prefix)
    end

    def check_http_resources!(store, api_url: nil)
      section_notes = {}
      checks = {}
      STATE_PREFIXES.each do |prefix|
        store.list_json(prefix)
        if filtered_status_list?(store, prefix)
          checks[prefix] = "filtered"
          section_notes[prefix] = "#{prefix} filtered by scoped token"
        else
          checks[prefix] = "ok"
        end
      rescue OperationalError => e
        if prefix == "events" && unsupported_resource_listing?(e)
          checks[prefix] = "unsupported"
          section_notes[prefix] = "event state not supported by backend"
          next
        end
        if prefix == "archive" && unsupported_resource_listing?(e)
          checks[prefix] = "unsupported"
          section_notes[prefix] = "archive state not supported by backend"
          next
        end
        if scoped_http_forbidden_listing?(e, prefix)
          checks[prefix] = "forbidden"
          section_notes[prefix] = "#{prefix} not readable by scoped token"
          next
        end
        raise doctor_auth_recovery_error(prefix, e, api_url:) if e.message.match?(/ failed: 401 /)

        raise
      end
      [section_notes, checks]
    end

    def check_custom_resource!(store, prefix, api_url: nil)
      if AgentCoord.state_record_path?(prefix)
        entry = store.read_json(prefix)
        return [{ prefix => "#{prefix} does not exist" }, { prefix => "missing" }] unless entry

        return [{}, { prefix => "ok" }]
      end

      store.list_json(prefix)
      return [{}, { prefix => "ok" }] unless filtered_status_list?(store, prefix)

      [{ prefix => "#{prefix} filtered by scoped token" }, { prefix => "filtered" }]
    rescue OperationalError => e
      raise unless api_url
      raise doctor_auth_recovery_error(prefix, e, api_url:) if e.message.match?(/ failed: 401 /)
      if e.message.match?(/ failed: 403 forbidden\z/)
        return [{ prefix => "#{prefix} not readable by scoped token" }, { prefix => "forbidden" }]
      end
      if prefix.match?(%r{\Aevents(?:/|\z)}) && unsupported_resource_listing?(e)
        return [{ prefix => "event state not supported by backend" }, { prefix => "unsupported" }]
      end
      if prefix.match?(%r{\Aarchive(?:/|\z)}) && unsupported_resource_listing?(e)
        return [{ prefix => "archive state not supported by backend" }, { prefix => "unsupported" }]
      end

      raise
    end

    def doctor_auth_recovery_error(prefix, error, api_url: nil)
      local_flag = local_http_url?(api_url) ? "--local " : ""
      OperationalError.new(
        "doctor resource #{prefix} failed authentication (#{error.message}). Re-provision the machine token with: " \
        "worker/bin/provision-token <machine-name> #{local_flag}--database <database-name> --rotate " \
        "<original-scope-flags>; use the machine's recorded read/write scopes and do not infer them from the " \
        "resource that returned 401, " \
        "then update AGENT_COORD_API_TOKEN, restart consumers, and follow docs/runbooks/rotate-backend.md"
      )
    end

    # Must use the same normalization as validate_config_api_url! and
    # HttpStore#parse_base_url. URI#host keeps IPv6 brackets and preserves
    # casing, so a configurable URL like http://LOCALHOST:8787 or
    # http://[::1]:8787 would not be recognized as loopback here and the
    # recovery hint would omit --local, pointing the operator at the remote
    # database instead of the local backend.
    def local_http_url?(url)
      hostname = URI(url.to_s).hostname.to_s.downcase
      HttpStore::LOOPBACK_HOSTS.include?(hostname)
    rescue URI::InvalidURIError
      false
    end

    # doctor and stack-doctor both report the selected URL. Both payloads are
    # diagnostics that operators paste into issues and that CI archives, so the
    # reported URL never carries userinfo.
    def active_backend_url(options, backend_kind)
      backend_kind == "http" ? redact_url_userinfo(options[:api_url]) : nil
    end

    def bootstrap(options)
      install_dir = File.expand_path(options[:install_dir] || File.join(Dir.home, ".local", "bin"))
      status_state_root = options[:status_state_root] && File.expand_path(options[:status_state_root])
      begin
        FileUtils.mkdir_p(install_dir)

        install_command(
          File.expand_path("agent-coord", __dir__),
          File.join(install_dir, "agent-coord"),
          status_state_root: status_state_root
        )
        legacy_alias_removed = remove_legacy_alias(File.join(install_dir, "agent_coord"))

        profile = nil
        unless options[:no_profile]
          profile = File.expand_path(options[:profile] || default_profile_path)
          ensure_profile_path(profile, install_dir)
        end
      rescue SystemCallError => e
        raise OperationalError, "bootstrap failed: #{e.message}"
      end

      @stdout.puts "installed agent-coord -> #{File.join(install_dir, 'agent-coord')}"
      @stdout.puts "removed legacy agent_coord -> #{File.join(install_dir, 'agent_coord')}" if legacy_alias_removed
      if profile
        @stdout.puts "profile updated: #{profile}"
      else
        @stdout.puts "profile update skipped"
      end
      0
    end

    def demo(argv)
      raise Error, "unexpected arguments: #{argv.join(' ')}" unless argv.empty?

      repo = "demo/example"
      target = "1"
      started_at = Time.utc(2026, 1, 1, 12, 0, 0)

      @stdout.puts "agent-coord demo"
      @stdout.puts "mode: isolated local store — no remote writes; temporary state is removed on exit"
      Dir.mktmpdir("agent-coord-demo") do |state_root|
        with_demo_isolated_env(state_root) do
          run_demo_claim_and_heartbeat(state_root, repo, target, started_at)
          run_demo_refusal(state_root, repo, target, started_at + 30)
          run_demo_liveness_step(state_root, repo, target, started_at + 120, "stale")
          run_demo_liveness_step(state_root, repo, target, started_at + 300, "dead")
          run_demo_takeover(state_root, repo, target, started_at + 300)
        end
      end
      @stdout.puts
      @stdout.puts "demo complete; temporary state removed"
      0
    end

    # "isolated local store — no remote writes" has to be true of the config the
    # nested runs read, not just of the state root they write. Each nested run
    # calls load_user_configuration! itself, so passing --state-root alone left
    # them reading the ambient AGENT_COORD_ENV_FILE / XDG_CONFIG_HOME config: an
    # insecure or malformed one failed the whole walkthrough.
    #
    # sim/bin/graveyard and the sim tests isolate by handing Open3 an env hash
    # that nils every AGENT_COORD_* key and points XDG_CONFIG_HOME at a
    # never-created directory under the run's own temporary root. These runs are
    # in-process, so there is no env hash to hand anyone; the equivalent is to
    # swap the same keys into ENV for the duration and restore them after, which
    # is the mechanism load_user_configuration! already uses for injection.
    # `demo` itself is in CONFIG_INDEPENDENT_COMMANDS, so nothing reads the
    # ambient config before this swap takes effect either.
    def with_demo_isolated_env(state_root)
      isolated_keys = USER_CONFIG_ENV_KEYS + ["AGENT_COORD_ENV_FILE", SESSION_ID_ENV, CODEX_THREAD_ID_ENV]
      values = isolated_keys.to_h { |key| [key, nil] }
      # Never created, and XDG_CONFIG_HOME must be absolute.
      values["XDG_CONFIG_HOME"] = File.join(File.expand_path(state_root), "xdg-config")
      saved = values.to_h { |key, _value| [key, ENV.fetch(key, nil)] }
      values.each { |key, value| value.nil? ? ENV.delete(key) : ENV[key] = value }
      yield
    ensure
      saved&.each { |key, value| value.nil? ? ENV.delete(key) : ENV[key] = value }
    end

    def run_demo_claim_and_heartbeat(state_root, repo, target, now)
      claim_args = ["claim", "--agent-id", "demo-alpha", "--repo", repo, "--target", target, "--ttl", "3600"]
      heartbeat_args = [
        "heartbeat", "--agent-id", "demo-alpha", "--repo", repo, "--target", target, "--ttl", "60"
      ]
      require_demo_success!(run_demo_command(claim_args, state_root, now), "initial claim")
      require_demo_success!(run_demo_command(heartbeat_args, state_root, now), "initial heartbeat")

      @stdout.puts
      @stdout.puts "1. demo-alpha claims #{repo}##{target} and starts a 60-second heartbeat"
      @stdout.puts "   $ agent-coord #{claim_args.join(' ')}"
      @stdout.puts "   claimed #{repo}##{target} by demo-alpha"
      @stdout.puts "   $ agent-coord #{heartbeat_args.join(' ')}"
    end

    def run_demo_refusal(state_root, repo, target, now)
      args = ["claim", "--agent-id", "demo-beta", "--repo", repo, "--target", target]
      result = run_demo_command(args, state_root, now)
      unless result.code == EXIT_CLAIM_REFUSED && result.stderr.include?("held by demo-alpha; heartbeat live")
        raise OperationalError, "demo competing claim did not produce the expected live-holder refusal"
      end

      @stdout.puts
      @stdout.puts "2. demo-beta tries the same target while demo-alpha is live"
      @stdout.puts "   $ agent-coord #{args.join(' ')}"
      @stdout.puts "   #{result.stderr.strip}"
    end

    def run_demo_liveness_step(state_root, repo, target, now, expected_liveness)
      args = ["status", "--repo", repo, "--target", target, "--json"]
      result = run_demo_command(args, state_root, now)
      require_demo_success!(result, "#{expected_liveness} status")
      liveness = JSON.parse(result.stdout).fetch("heartbeats").first.fetch("liveness")
      unless liveness == expected_liveness
        raise OperationalError, "demo expected #{expected_liveness} heartbeat, got #{liveness}"
      end

      @stdout.puts
      step = { "stale" => 3, "dead" => 4 }.fetch(expected_liveness)
      @stdout.puts "#{step}. logical time advances; status reports the holder heartbeat"
      @stdout.puts "   $ agent-coord #{args.join(' ')}"
      @stdout.puts "   demo-alpha heartbeat #{liveness}"
    end

    def run_demo_takeover(state_root, repo, target, now)
      args = ["claim", "--agent-id", "demo-beta", "--repo", repo, "--target", target]
      require_demo_success!(run_demo_command(args, state_root, now), "dead-holder takeover")

      @stdout.puts
      @stdout.puts "5. demo-beta retries after the holder heartbeat is dead"
      @stdout.puts "   $ agent-coord #{args.join(' ')}"
      @stdout.puts "   takeover succeeded; holder is demo-beta"
    end

    def run_demo_command(argv, state_root, now)
      stdout = StringIO.new
      stderr = StringIO.new
      code = begin
        Runner.new(
          argv + ["--state-root", state_root],
          stdout: stdout,
          stderr: stderr,
          clock: DemoClock.new(now),
          backend_conflict_warnings: false
        ).run
      rescue Error => e
        stderr.puts e.message
        e.exit_code
      end
      DemoResult.new(code: code, stdout: stdout.string, stderr: stderr.string)
    end

    def require_demo_success!(result, step)
      return if result.code.zero?

      raise OperationalError, "demo #{step} failed: #{result.stderr.strip}"
    end

    def heartbeat(options)
      require_options(options, :agent_id)
      normalize_status_option!(options)
      ttl = positive_ttl(options[:ttl] || DEFAULT_HEARTBEAT_TTL)
      now = now_utc
      path = AgentCoord.heartbeat_path(options.fetch(:agent_id))
      store = build_store(options)
      payload = {
        "schema_version" => SCHEMA_VERSION,
        "agent_id" => options.fetch(:agent_id),
        "repo" => options[:repo],
        "target" => options[:target]&.to_s,
        "batch_id" => options[:batch_id],
        "branch" => options[:branch],
        "status" => options.fetch(:status),
        "updated_at" => timestamp(now),
        "expires_at" => timestamp(now + ttl)
      }.compact

      prior_record = nil
      upsert_json(store, path, message: "Heartbeat #{options[:agent_id]}") do |existing|
        prior_record = existing&.data
        preserved_payload(existing, heartbeat_preserved_fields(existing, options))
          .merge(payload)
          .merge(metadata_payload(options))
          .merge(environment_identity_payload(existing&.data))
          .merge(status_attribution_payload(options))
          .compact
      end
      record_phase_change_event(store, options, prior_record, now)
      @stdout.puts "heartbeat #{options[:agent_id]} #{timestamp(now)}"
      0
    ensure
      close_store(store)
    end

    def preserved_payload(existing, fields)
      status_metadata(existing&.data, fields)
    end

    def metadata_payload(options)
      METADATA_OPTION_FIELDS.each_with_object({}) do |field, metadata|
        option_name = field.to_sym
        metadata[field] = options[option_name] if options.key?(option_name) && !options[option_name].nil?
      end
    end

    # Write-time status vocabulary enforcement. Values that fold (case,
    # hyphen/underscore) or alias to the canonical vocabulary are coerced,
    # keeping the caller's original spelling in status_raw when it differs.
    # Unknown values warn on stderr and are preserved verbatim with a
    # status_raw copy so older emitters keep succeeding while consumers can
    # detect unrecognized vocabulary. Never changes the exit code.
    def normalize_status_option!(options)
      raw = options[:status]
      return if raw.nil?

      canonical = AgentCoord.canonical_status(raw)
      if canonical.nil?
        warn_unknown_status(raw)
        options[:status_raw] = raw
        return
      end

      options[:status_raw] = canonical == raw ? nil : raw
      options[:status] = canonical
    end

    def warn_unknown_status(raw)
      @stderr.puts "warning: status #{raw.inspect} is not in the canonical status vocabulary; " \
                   "preserving it verbatim with a status_raw copy. " \
                   "Canonical statuses: #{HEARTBEAT_STATUSES.join(', ')}."
    end

    # status_raw always reflects the current write: an explicit nil overrides
    # any status_raw preserved from a prior write and is then compacted away,
    # so a canonical write clears stale raw attribution.
    def status_attribution_payload(options)
      { "status_raw" => options[:status_raw] }
    end

    # Non-secret machine/session attribution resolved from the environment for
    # every coordination write. When the environment supplies no identity at
    # all, previously recorded attribution stays preserved by the metadata
    # preservation lists. When the environment resolves only half the tuple and
    # that half differs from the record's last recorded value, the stale other
    # half is explicitly cleared (nil then compacted away) so a record never
    # pairs a machine with a session resolved on another one, in either
    # direction.
    def environment_identity_payload(existing_data = nil)
      session_id, session_source = AgentCoord.environment_session_identity
      machine_id = AgentCoord.environment_machine_id
      payload = { "machine_id" => machine_id, "session_id" => session_id }.compact
      payload["session_source"] = session_source unless session_id.nil?
      if session_id.nil? && cross_machine_write?(machine_id, existing_data)
        payload["session_id"] = nil
        payload["session_source"] = nil
      end
      payload["machine_id"] = nil if machine_id.nil? && cross_session_write?(session_id, existing_data)
      payload
    end

    def cross_machine_write?(machine_id, existing_data)
      return false unless machine_id && existing_data.is_a?(Hash)

      existing_data["machine_id"] != machine_id
    end

    def cross_session_write?(session_id, existing_data)
      return false unless session_id && existing_data.is_a?(Hash)

      existing_data["session_id"] != session_id
    end

    def handoff_payload(options)
      return {} unless handoff_release?(options)

      HANDOFF_OPTION_FIELDS.each_with_object({ "release_mode" => "handoff" }) do |field, metadata|
        option_name = field.to_sym
        metadata[field] = options[option_name] if options.key?(option_name) && !options[option_name].nil?
      end
    end

    def handoff_release?(options)
      options.key?(:handoff_to) || options.key?(:handoff_note)
    end

    def without_handoff_payload(payload)
      payload.except(*HANDOFF_STATE_FIELDS)
    end

    def claim_preserved_fields(existing, options)
      return [] unless renewed_claim?(existing, options)

      CLAIM_PRESERVED_FIELDS
    end

    def renewed_claim?(existing, options)
      existing&.data.is_a?(Hash) &&
        active_claim_record?(existing.data) &&
        existing.data["agent_id"] == options[:agent_id] &&
        !claim_lane_changed?(existing, options)
    end

    def claim_timestamp(existing, options, now)
      return timestamp(now) unless renewed_claim?(existing, options)

      existing.data.fetch("claimed_at", timestamp(now))
    end

    def claim_lane_changed?(existing, options)
      changed_identity_fields(existing, options, "batch_id", "branch").any?
    end

    # A claim.acquired event marks a genuine acquisition or takeover, not a
    # same-holder TTL renewal. Suppress the event only when the prior record is a
    # still-active claim held by the same agent with an unchanged lane and
    # unchanged generation/instance identity; emit for a fresh claim, a released
    # or expired prior claim, a different holder, or a changed OR newly-added
    # generation/instance (e.g. a process restart that starts stamping identity).
    def claim_acquired_event?(existing, options)
      return true unless renewed_claim?(existing, options)

      reacquire_fields = %w[generation instance_id]
      changed_identity_fields(existing, options, *reacquire_fields).any? ||
        added_identity_fields(existing, options, *reacquire_fields).any?
    end

    def heartbeat_preserved_fields(existing, options)
      changed_fields = heartbeat_changed_fields(existing, options)
      return HEARTBEAT_PRESERVED_FIELDS if changed_fields.empty?

      heartbeat_target_fields_to_preserve(changed_fields)
    end

    # True when the current heartbeat targets a different lane than the record it
    # overwrote. Only explicitly supplied identity fields are compared: an omitted
    # field is preserved from the prior record and therefore never changes the
    # lane, while a supplied value that differs from (or newly sets) the prior
    # record's batch_id/repo/target marks a lane switch.
    def heartbeat_lane_changed?(options, prior_data)
      identity_fields(options, "batch_id", "repo", "target").any? do |field, value|
        prior_data[field].to_s != value.to_s
      end
    end

    def heartbeat_changed_fields(existing, options)
      return {} unless existing&.data.is_a?(Hash)

      changed_fields = changed_identity_fields(existing, options, "repo", "target", "batch_id", "branch")
                       .merge(added_identity_fields(existing, options, "repo", "target", "batch_id", "branch"))
      changed_fields["target"] = nil if options.key?(:repo) && !options.key?(:target) && existing.data.key?("target")
      changed_fields
    end

    def heartbeat_target_fields_to_preserve(changed_fields)
      fields = []
      fields << "repo" unless changed_fields.key?("repo")
      fields << "target" unless changed_fields.key?("target") || changed_fields.key?("repo")
      fields
    end

    def changed_identity_fields(existing, options, *fields)
      identity_fields(options, *fields).select do |field, value|
        existing.data.key?(field) && existing.data[field] != value
      end
    end

    def added_identity_fields(existing, options, *fields)
      identity_fields(options, *fields).reject do |field, _value|
        existing.data.key?(field)
      end
    end

    def identity_fields(options, *fields)
      fields.each_with_object({}) do |field, payload|
        value = options[field.to_sym]
        value = value.to_s if field == "target" && !value.nil?
        payload[field] = value unless value.nil?
      end
    end

    def register_batch(options)
      require_options(options, :file)
      manifest = load_batch_manifest(options.fetch(:file))
      raise Error, "batch manifest must be a JSON object" unless manifest.is_a?(Hash)

      batch_id = manifest["batch_id"] || options[:batch_id]
      raise Error, "batch manifest missing batch_id" if batch_id.to_s.empty?
      if options[:batch_id] && options[:batch_id] != batch_id.to_s
        raise Error, "--batch-id does not match batch manifest batch_id"
      end

      now = now_utc
      path = AgentCoord.batch_path(batch_id)
      payload = manifest.merge(
        "schema_version" => SCHEMA_VERSION,
        "batch_id" => batch_id.to_s,
        "registered_at" => manifest["registered_at"] || timestamp(now),
        "updated_at" => timestamp(now)
      )
      payload["launch_prompt"] = load_launch_prompt(options[:launch_prompt]) if options[:launch_prompt]
      validate_batch_manifest!(payload)

      store = build_store(options)
      existing = store.read_json(path)
      apply_batch_synthetic_metadata!(payload, options, existing)
      payload["registered_at"] = manifest["registered_at"] || existing&.data&.fetch("registered_at", nil) ||
                                 payload.fetch("registered_at")
      write_with_cas(store, path, payload, existing, "Register batch #{batch_id}")
      @stdout.puts "registered batch #{batch_id}"
      0
    rescue Conflict => e
      raise OperationalError, "batch registration write contention for #{batch_id}; #{e.message}"
    ensure
      close_store(store)
    end

    def apply_batch_synthetic_metadata!(payload, options, existing)
      %w[synthetic synthetic_kind].each do |field|
        option = field.to_sym
        if options.key?(option)
          payload[field] = options[option]
        elsif !payload.key?(field) && existing&.data&.key?(field)
          payload[field] = existing.data[field]
        end
      end
    end

    def record_event(options)
      require_options(options, :batch_id, :type)
      validate_record_event_options!(options)

      store = build_store(options)
      now = now_utc
      if options[:type] == "lane_closed"
        close_terminal_event(store, options, now, output: true)
        return 0
      end
      normalize_status_option!(options) if options[:status_given]
      write_event_record(store, options, now, output: true)
      0
    ensure
      close_store(store)
    end

    def write_event_record(store, options, now, output:)
      3.times do
        event_id = build_event_id(now)
        path = AgentCoord.event_path(options.fetch(:batch_id), event_id)
        payload = event_payload(options, event_id, now)
        begin
          store.write_json(path, payload, message: "Record event #{options[:batch_id]} #{event_id}", create: true)
          @stdout.puts "recorded event #{options[:batch_id]} #{event_id}" if output
          return 0
        rescue Conflict
          next
        end
      end
      raise OperationalError, "event id collision while recording event for #{options[:batch_id]}"
    end

    def close_terminal_event(store, options, now, output:)
      event_options = canonical_terminal_event_options(store, options)
      authoritative, created = reserve_terminal_event(store, event_options, now)
      batch_changed = complete_terminal_batch(store, authoritative, now)
      if created
        @stdout.puts "recorded event #{event_options[:batch_id]} #{authoritative.fetch('event_id')}" if output
      elsif batch_changed && output
        @stdout.puts "reconciled terminal closeout for #{event_options[:repo]}##{event_options[:target]}"
      elsif output
        @stdout.puts "lane already closed for #{event_options[:repo]}##{event_options[:target]}"
      end
      created || batch_changed
    end

    def reserve_terminal_event(store, options, now)
      event_id = stable_terminal_event_id(options.fetch(:lane))
      path = AgentCoord.event_path(options.fetch(:batch_id), event_id)
      requested = event_payload(options, event_id, now)
      store.write_json(path, requested, message: "Close lane #{options[:batch_id]} #{options[:lane]}", create: true)
      [requested, true]
    rescue Conflict
      existing = store.read_json(path)
      raise OperationalError, "terminal closeout reservation disappeared at #{path}" unless existing
      unless terminal_conflict_semantics(terminal_payload_semantics(existing.data)) ==
             terminal_conflict_semantics(terminal_payload_semantics(requested))
        raise Error, "conflicting terminal closeout for lane #{options[:lane]}; first closeout is authoritative"
      end

      [existing.data, false]
    end

    def stable_terminal_event_id(lane)
      "lane_closed-#{Digest::SHA256.hexdigest(lane)[0, 16]}"
    end

    # Auto-emitted lifecycle events. Each is best-effort and batch_id-gated: a
    # failed event write warns on stderr and returns without failing the
    # claim/release/heartbeat operation, and nothing is emitted when no batch_id
    # is known for the operation. They reuse the shared write_event_record path
    # so the records stay consistent with explicit `record-event` writes.
    def record_claim_acquired_event(store, claim_payload, now)
      batch_id = claim_payload["batch_id"]
      return if batch_id.to_s.empty?

      event_options = claim_acquired_event_options(claim_payload, batch_id)
      write_event_record(store, event_options, now, output: false)
    rescue Error, SystemCallError => e
      @stderr.puts "warning: claim.acquired event not recorded: #{e.message}"
    end

    def claim_acquired_event_options(claim_payload, batch_id)
      event_options = {
        batch_id: batch_id,
        type: "claim.acquired",
        agent_id: claim_payload["agent_id"],
        repo: claim_payload["repo"],
        target: claim_payload["target"],
        branch: claim_payload["branch"]
      }
      METADATA_OPTION_FIELDS.each do |field|
        value = claim_payload[field]
        event_options[field.to_sym] = value unless value.nil?
      end
      event_options
    end

    def record_release_event(store, release_payload, now)
      batch_id = release_payload["batch_id"]
      return if batch_id.to_s.empty?

      event_options = release_event_options(release_payload, batch_id)
      write_event_record(store, event_options, now, output: false)
    rescue Error, SystemCallError => e
      @stderr.puts "warning: claim.released event not recorded: #{e.message}"
    end

    def release_event_options(release_payload, batch_id)
      event_options = {
        batch_id: batch_id,
        type: "claim.released",
        agent_id: release_payload["agent_id"],
        repo: release_payload["repo"],
        target: release_payload["target"],
        branch: release_payload["branch"],
        status: release_payload["status"],
        status_given: true,
        message: release_payload["handoff_note"]
      }
      (METADATA_OPTION_FIELDS + HANDOFF_OPTION_FIELDS).each do |field|
        value = release_payload[field]
        event_options[field.to_sym] = value unless value.nil?
      end
      event_options
    end

    # Emits phase.changed only when the heartbeat carries a new phase that
    # differs from the phase on the record it overwrote. A first phase
    # assignment (no prior phase) is captured by claim.acquired instead, so it is
    # not treated as a transition here; repeated same-phase beats emit nothing.
    def record_phase_change_event(store, options, prior_record, now)
      new_phase = options[:phase]
      return if new_phase.nil?

      prior_data = prior_record.is_a?(Hash) ? prior_record : {}
      prior_phase = prior_data["phase"]
      return if prior_phase.to_s.empty? || prior_phase == new_phase
      # The heartbeat record is per-agent, so a beat can overwrite a record that
      # belonged to a different lane. Only a same-lane transition is a real phase
      # change; comparing across lanes would fabricate a bogus transition into the
      # new batch, so require the overwritten record's lane identity to match.
      return if heartbeat_lane_changed?(options, prior_data)

      batch_id = options[:batch_id] || prior_data["batch_id"]
      return if batch_id.to_s.empty?

      event_options = phase_change_event_options(options, batch_id, prior_phase, prior_data)
      write_event_record(store, event_options, now, output: false)
    rescue Error, SystemCallError => e
      @stderr.puts "warning: phase.changed event not recorded: #{e.message}"
    end

    def phase_change_event_options(options, batch_id, prior_phase, prior_data)
      event_options = {
        batch_id: batch_id,
        type: "phase.changed",
        agent_id: options[:agent_id],
        repo: options[:repo] || prior_data["repo"],
        target: options[:target] || prior_data["target"],
        branch: options[:branch] || prior_data["branch"],
        previous_phase: prior_phase,
        message: "phase #{prior_phase} -> #{options[:phase]}"
      }
      METADATA_OPTION_FIELDS.each do |field|
        value = options[field.to_sym]
        value = prior_data[field] if value.nil?
        event_options[field.to_sym] = value unless value.nil?
      end
      event_options
    end

    def validate_record_event_options!(options)
      AgentCoord.batch_path(options.fetch(:batch_id))
      AgentCoord.validate_segment!(options.fetch(:type), "event type")
      validate_terminal_options!(options, event: true) if options[:type] == "lane_closed"
      validate_typed_event_options!(options)
      return unless options.key?(:lane)

      lane = options[:lane].to_s
      raise Error, "--lane must not be empty" if lane.empty?
      raise Error, "event lane #{lane} cannot contain ':'" if malformed_lane_name?(lane)
    end

    # Per-type field enforcement for the typed operational-signal vocabulary
    # (issue #77): reject typed fields foreign to the declared type, then require
    # its own fields and validate their allowed values. Only the four typed names
    # are validated; any other --type value stays allowed and unvalidated, so
    # existing free-form record-event callers are unaffected.
    def validate_typed_event_options!(options)
      type = options[:type]
      return unless TYPED_EVENT_ALLOWED_FIELDS.key?(type)

      reject_foreign_typed_fields!(options, type)
      case type
      when "help_requested"
        require_options(options, :reason)
        validate_event_enum!(options, :reason, HELP_REQUESTED_REASONS)
      when "escalation_requested"
        require_nonblank_options(options, :from_route, :to_route, :evidence)
      when "error"
        require_options(options, :severity)
        require_nonblank_options(options, :category, :message)
        validate_event_enum!(options, :severity, ERROR_SEVERITIES)
      when "human_intervention"
        require_options(options, :kind)
        validate_event_enum!(options, :kind, HUMAN_INTERVENTION_KINDS)
      end
    end

    def reject_foreign_typed_fields!(options, type)
      allowed = TYPED_EVENT_ALLOWED_FIELDS.fetch(type)
      foreign = (TYPED_EVENT_PAYLOAD_FIELDS - allowed).reject { |field| options[field.to_sym].nil? }
      return if foreign.empty?

      raise Error, "--#{foreign.first.tr('_', '-')} is not valid for --type #{type}"
    end

    def validate_event_enum!(options, field, allowed)
      value = options[field]
      return if allowed.include?(value)

      raise Error, "--#{field.to_s.tr('_', '-')} must be one of: #{allowed.join(', ')}"
    end

    def require_nonblank_options(options, *names)
      names.each do |name|
        raise Error, "missing required --#{name.to_s.tr('_', '-')}" if options[name].to_s.strip.empty?
      end
    end

    def event_payload(options, event_id, now)
      payload = {
        "schema_version" => terminal_event?(options) ? LANE_CLOSED_SCHEMA_VERSION : SCHEMA_VERSION,
        "event_id" => event_id,
        "batch_id" => options.fetch(:batch_id).to_s,
        "type" => options.fetch(:type),
        "lane" => options[:lane],
        "agent_id" => options[:agent_id],
        "repo" => options[:repo],
        "target" => options[:target]&.to_s,
        "branch" => options[:branch],
        "message" => options[:message],
        "terminal" => options[:terminal],
        "pr_state" => options[:pr_state],
        "evidence_url" => options[:evidence_url],
        "workspace" => terminal_event?(options) ? options.fetch(:workspace, DEFAULT_WORKSPACE) : options[:workspace],
        "closed_by" => terminal_event?(options) ? closed_by_payload(options) : nil,
        "at" => timestamp(now)
      }
      payload["status"] = options[:status] if options[:status_given]
      payload["status_raw"] = options[:status_raw] if options[:status_given] && options[:status_raw]
      payload["previous_phase"] = options[:previous_phase] if options[:previous_phase]
      payload.merge(metadata_payload(options))
             .merge(handoff_payload(options))
             .merge(typed_event_payload(options))
             .merge(environment_identity_payload)
             .compact
    end

    # Present-only projection of the typed operational-signal payload fields
    # (issue #77). Absent fields are omitted so untyped events keep their exact
    # existing shape.
    def typed_event_payload(options)
      TYPED_EVENT_PAYLOAD_FIELDS.each_with_object({}) do |field, payload|
        value = options[field.to_sym]
        payload[field] = value unless value.nil?
      end
    end

    def terminal_event?(options)
      options[:type] == "lane_closed"
    end

    def terminal_release_payload(payload, options)
      return payload unless options[:terminal]

      payload.merge(
        "terminal" => options[:terminal],
        "pr_state" => options[:pr_state],
        "evidence_url" => options[:evidence_url],
        "workspace" => options[:workspace]
      ).compact
    end

    def validate_terminal_options!(options, event: false)
      terminal = options[:terminal]
      if terminal && !TERMINAL_STATES.include?(terminal)
        raise Error, "--terminal must be one of: #{TERMINAL_STATES.join(', ')}"
      end

      if event
        require_options(options, :terminal, :agent_id, :repo, :target)
      elsif terminal && handoff_release?(options)
        raise Error, "--terminal cannot be combined with --handoff-to or --handoff-note"
      end
      validate_terminal_contract_payload!(options) if terminal
    end

    def validate_terminal_contract_payload!(payload)
      AgentCoord.validate_repo!(terminal_payload_value(payload, "repo"), "terminal closeout")
      validate_terminal_nonempty_field!(payload, "workspace", default: DEFAULT_WORKSPACE)
      validate_terminal_nonempty_field!(payload, "host", default: "UNKNOWN")
      %w[branch pr_state].each { |field| validate_terminal_nonempty_field!(payload, field) }
      %w[pr_url evidence_url].each { |field| validate_terminal_uri_field!(payload, field) }
    end

    def validate_terminal_nonempty_field!(payload, field, default: nil)
      value = terminal_payload_value(payload, field)
      value = default if value.nil?
      return if value.nil? || !value.to_s.empty?

      raise Error, "--#{field.tr('_', '-')} must not be empty for terminal closeout"
    end

    def validate_terminal_uri_field!(payload, field)
      value = terminal_payload_value(payload, field)
      return if value.nil?

      uri = URI.parse(value)
      return if %w[http https].include?(uri.scheme) && !uri.host.to_s.empty? && !value.match?(/\s/)

      raise Error, "--#{field.tr('_', '-')} must be an HTTP(S) URL with a host"
    rescue URI::InvalidURIError
      raise Error, "--#{field.tr('_', '-')} must be an HTTP(S) URL with a host"
    end

    def closed_by_payload(options)
      {
        "agent_id" => options[:agent_id] || options.fetch("agent_id"),
        "machine" => AgentCoord.environment_machine_id || options[:host] || options["host"] || "UNKNOWN"
      }
    end

    # Reconstructs closed_by for records written before closed_by existed.
    # Reads only the record's own historical host — never the live environment
    # and never an env-stamped machine_id — so idempotent-replay-versus-conflict
    # comparisons describe the record, not the process replaying it.
    def closed_by_from_record(record)
      {
        "agent_id" => terminal_payload_value(record, "agent_id"),
        "machine" => terminal_payload_value(record, "host") || "UNKNOWN"
      }
    end

    def canonical_terminal_event_options(store, payload)
      batch_id = terminal_payload_value(payload, "batch_id")
      options = {
        batch_id: batch_id,
        type: "lane_closed",
        lane: terminal_payload_value(payload, "lane"),
        agent_id: terminal_payload_value(payload, "agent_id"),
        repo: terminal_payload_value(payload, "repo"),
        target: terminal_payload_value(payload, "target"),
        branch: terminal_payload_value(payload, "branch"),
        host: terminal_payload_value(payload, "host"),
        pr_url: terminal_payload_value(payload, "pr_url"),
        terminal: terminal_payload_value(payload, "terminal"),
        pr_state: terminal_payload_value(payload, "pr_state"),
        evidence_url: terminal_payload_value(payload, "evidence_url"),
        workspace: terminal_payload_value(payload, "workspace") || DEFAULT_WORKSPACE,
        synthetic: terminal_payload_value(payload, "synthetic"),
        synthetic_kind: terminal_payload_value(payload, "synthetic_kind")
      }.compact
      options[:lane] = lane_name(terminal_batch_lane(store, options))
      options
    end

    def close_terminal_release(store, existing, payload, now, options)
      validate_terminal_release_batch_id!(payload)
      event_options = canonical_terminal_event_options(store, payload)
      authoritative, created = reserve_terminal_event(store, event_options, now)
      reconciled_payload = authoritative_terminal_claim_payload(payload, authoritative)
      claim_changed = reconcile_terminal_claim(store, existing, reconciled_payload, options) == :changed
      batch_changed = complete_terminal_batch(store, authoritative, now)
      if created || claim_changed || batch_changed
        @stdout.puts "released #{options[:repo]}##{options[:target]} by #{options[:agent_id]}"
      else
        @stdout.puts "lane already closed for #{options[:repo]}##{options[:target]}"
      end
    end

    def authoritative_terminal_claim_payload(payload, event)
      result = payload.dup
      %w[terminal workspace closed_by pr_url pr_state evidence_url].each do |field|
        value = event[field]
        value.nil? ? result.delete(field) : result[field] = value
      end
      result
    end

    def reconcile_terminal_claim(store, existing, payload, options)
      if existing.data["status"] == "released" &&
         terminal_payload_semantics(existing.data) == terminal_payload_semantics(payload)
        return :unchanged
      end

      path = AgentCoord.claim_path(options.fetch(:repo), options.fetch(:target))
      store.write_json(path, payload, message: "Release #{options[:repo]}##{options[:target]}", sha: existing.sha)
      :changed
    rescue Conflict
      current = store.read_json(path)
      if current && current.data["status"] == "released" &&
         terminal_payload_semantics(current.data) == terminal_payload_semantics(payload)
        return :unchanged
      end

      raise
    end

    def validate_terminal_release_batch_id!(payload)
      return unless terminal_payload_value(payload, "batch_id").to_s.empty?

      raise Error, "terminal release requires a claim with batch_id"
    end

    def complete_terminal_batch(store, payload, now)
      batch_id = payload["batch_id"] || payload[:batch_id]
      batch_path = AgentCoord.batch_path(batch_id)
      3.times do
        existing = store.read_json(batch_path)
        raise Error, "batch #{batch_id} not found for terminal closeout" unless existing

        lane = terminal_batch_lane(store, payload, batch: existing.data)
        return false if terminal_lane_replay?(lane, payload)

        updated = terminal_batch_payload(store, existing.data, payload, now)
        begin
          store.write_json(batch_path, updated, message: "Close lane in batch #{batch_id}", sha: existing.sha)
          return true
        rescue Conflict
          next
        end
      end

      raise OperationalError, "batch #{batch_id} changed repeatedly during terminal closeout"
    end

    def terminal_batch_payload(store, batch, payload, now)
      updated = JSON.parse(JSON.generate(batch))
      lane = terminal_batch_lane(store, payload, batch: updated)
      terminal = payload["terminal"] || payload[:terminal]
      lane["status"] = terminal
      lane["terminal"] = terminal
      lane["closed_at"] ||= timestamp(now)
      lane["closed_by"] ||= payload["closed_by"] || closed_by_from_record(payload)
      lane["workspace"] ||= terminal_payload_value(payload, "workspace") || DEFAULT_WORKSPACE
      %w[pr_url pr_state evidence_url].each do |field|
        value = payload[field] || payload[field.to_sym]
        lane[field] = value unless value.nil?
      end
      lanes = Array(updated["lanes"])
      updated["status"] = "completed" if lanes.all? { |item| TERMINAL_STATES.include?(item["terminal"]) }
      updated["completed_at"] ||= timestamp(now) if updated["status"] == "completed"
      updated["updated_at"] = timestamp(now)
      updated
    end

    def terminal_lane_replay?(lane, payload)
      return false unless lane["terminal"]
      if terminal_conflict_semantics(terminal_lane_semantics(lane)) ==
         terminal_conflict_semantics(terminal_payload_semantics(payload))
        return true
      end

      raise Error, "conflicting terminal closeout for lane #{lane_name(lane)}; first closeout is authoritative"
    end

    def terminal_lane_semantics(lane)
      {
        "terminal" => lane["terminal"],
        "workspace" => lane["workspace"] || DEFAULT_WORKSPACE,
        "closed_by" => lane["closed_by"],
        "pr_url" => lane["pr_url"],
        "pr_state" => lane["pr_state"],
        "evidence_url" => lane["evidence_url"]
      }
    end

    def terminal_payload_semantics(payload)
      {
        "terminal" => terminal_payload_value(payload, "terminal"),
        "workspace" => terminal_payload_value(payload, "workspace") || DEFAULT_WORKSPACE,
        "closed_by" => terminal_payload_value(payload, "closed_by") || closed_by_from_record(payload),
        "pr_url" => terminal_payload_value(payload, "pr_url"),
        "pr_state" => terminal_payload_value(payload, "pr_state"),
        "evidence_url" => terminal_payload_value(payload, "evidence_url")
      }
    end

    # Conflict view of the closeout semantics. Machine attribution never
    # fences a terminal replay: the authoritative first closeout keeps its
    # recorded machine while AGENT_COORD_MACHINE_ID or --host may appear,
    # change, or disappear before a retry, so conflict detection compares the
    # closing agent and the closeout facts only. Claim reconciliation keeps
    # comparing full record semantics so a legacy claim missing closed_by is
    # still repaired from the authoritative event.
    def terminal_conflict_semantics(semantics)
      semantics.merge("closed_by" => terminal_closer_semantics(semantics["closed_by"]))
    end

    def terminal_closer_semantics(closed_by)
      closed_by.is_a?(Hash) ? closed_by.slice("agent_id") : closed_by
    end

    def terminal_batch_lane(store, payload, batch: nil)
      batch_id = terminal_payload_value(payload, "batch_id")
      batch ||= store.read_json(AgentCoord.batch_path(batch_id))&.data
      raise Error, "batch #{batch_id} not found for terminal closeout" unless batch

      validate_terminal_batch_repo!(batch, payload, batch_id)
      lane = matching_terminal_batch_lane(batch, payload, batch_id)
      validate_terminal_lane_identity!(store, batch, lane, payload)
      lane
    end

    def validate_terminal_batch_repo!(batch, payload, batch_id)
      return unless batch["repo"] && batch["repo"] != terminal_payload_value(payload, "repo")

      raise Error, "terminal closeout repo does not match batch #{batch_id}"
    end

    def matching_terminal_batch_lane(batch, payload, batch_id)
      requested_lane = terminal_payload_value(payload, "lane")
      target = terminal_payload_value(payload, "target").to_s
      matches = Array(batch["lanes"]).select do |lane|
        requested_lane ? lane_name(lane) == requested_lane : terminal_lane_targets(lane).include?(target)
      end
      raise Error, "terminal closeout does not match exactly one lane in batch #{batch_id}" unless matches.one?

      matches.first
    end

    def validate_terminal_lane_identity!(store, batch, lane, payload)
      target = terminal_payload_value(payload, "target").to_s
      unless terminal_lane_targets(lane).include?(target)
        raise Error, "terminal closeout target does not match lane #{lane_name(lane)}"
      end

      agent_id = terminal_payload_value(payload, "agent_id")
      static_owner = lane_owner(lane)
      return if static_owner != "UNKNOWN" && static_owner == agent_id
      if terminal_current_claimant?(store, payload) &&
         terminal_authorized_claimant?(store, batch, lane, payload)
        return
      end

      raise Error, "terminal closeout agent does not match lane #{lane_name(lane)}"
    end

    def terminal_current_claimant?(store, payload)
      repo = terminal_payload_value(payload, "repo")
      target = terminal_payload_value(payload, "target").to_s
      claim = store.read_json(AgentCoord.claim_path(repo, target))&.data
      return false unless claim.is_a?(Hash)

      # Identity, not status, defines the current claimant. Terminal replay and
      # reconciliation intentionally operate on the same holder's released
      # claim, while release itself still rejects a different current holder.
      {
        "repo" => repo,
        "target" => target,
        "batch_id" => terminal_payload_value(payload, "batch_id").to_s,
        "agent_id" => terminal_payload_value(payload, "agent_id")
      }.all? { |field, expected| claim[field] == expected }
    end

    def terminal_authorized_claimant?(store, batch, lane, payload)
      batch_id = terminal_payload_value(payload, "batch_id").to_s
      prefix = AgentCoord.event_batch_prefix(batch_id)
      records = store.list_json(prefix)
      if filtered_status_list?(store, prefix)
        raise OperationalError, "event trail for #{batch_id} is filtered by a scoped token"
      end

      lanes = Array(batch["lanes"])
      context = batch_audit_lane_context(
        lane,
        batch_id,
        batch_audit_owner_counts(lanes),
        batch_audit_target_counts(lanes)
      )
      events = records.map(&:data).select do |event|
        batch_audit_event_for_repo?(event, batch["repo"]) && batch_audit_event_for_lane?(event, context)
      end
      lineage = batch_audit_lineage(events, context)
      return false unless lineage.fetch(:ordered) && lineage.fetch(:ordinary_valid)

      terminal_events = events.select { |event| event["type"] == "lane_closed" }
      return false unless terminal_events.all? do |event|
        batch_audit_valid_lane_closed_event?(event, context, lineage)
      end
      return false if batch_audit_conflicting_terminal_events?(terminal_events)

      lineage.fetch(:authorized).include?(terminal_payload_value(payload, "agent_id"))
    end

    def batch_audit_lane_context(lane, batch_id, owner_counts, target_counts)
      targets = batch_audit_lane_targets(lane)
      owner = lane_owner(lane)
      BatchAuditLane.new(
        batch_id: batch_id.to_s,
        name: lane_name(lane),
        targets: targets,
        unique_targets: targets.select { |target| target_counts.fetch(target, 0) <= 1 },
        owner: owner,
        owner_unique: owner != "UNKNOWN" && owner_counts.fetch(owner, 0) <= 1
      )
    end

    def terminal_lane_targets(lane)
      Array(lane["targets"] || lane["target"]).map(&:to_s)
    end

    def terminal_payload_value(payload, field)
      payload[field] || payload[field.to_sym]
    end

    def build_event_id(now)
      "#{now.utc.strftime('%Y%m%dT%H%M%S.%6NZ')}-#{SecureRandom.hex(4)}"
    end

    # Operator-facing custody trail (issue #129). The event store already records
    # which machine and host touched each work item and when; `log` orders those
    # facts by timestamp and prints them, one line per event. It deliberately
    # derives no verdict: where a work item is now is simply the last line, and a
    # move is a change in the machine, host, or agent column. Read-only, and
    # defaulting to the local status state root like `status`.
    def render_log(options)
      options = options.merge(work_item: log_work_item_scope(options))
      validate_log_format!(options)
      validate_log_sync_scope!(options)

      log_options = options.dup
      store = build_store(log_options)
      rows = log_rows(store, options)
      log_note_archived(options)
      if options[:sync]
        # A partial listing would write a partial mirror that later reads as
        # complete -- the same hazard the narrowing options are rejected for.
        raise OperationalError, "refusing to sync an incomplete trail: #{log_incomplete_prefixes}" if @log_incomplete

        return log_sync(log_options, rows)
      end

      claims = log_claim_for(store, options, rows)
      emit_log(log_limited(rows, options), options, claims, matched: rows)
      0
    rescue JSON::ParserError, SystemCallError => e
      raise OperationalError, "state unreadable: #{e.message}"
    ensure
      close_store(store)
    end

    # The mirror is a complete durable copy, not a view. Appending a narrow sync
    # and then a broader one would place older events after newer ones, so the
    # file's last line would stop being the current state -- and --limit would
    # drop the rest for good once gc pruned the events behind it.
    def validate_log_sync_scope!(options)
      return unless options[:sync]

      # An empty flag value is unset on the read path, so it is unset here too.
      # --limit is the exception in the other direction: any limit narrows the
      # mirror, including zero, whereas only zero narrows an already-empty trail.
      narrowed = LOG_TRAIL_FILTERS.reject { |field| options[field].to_s.empty? }
                                  .map { |field| "--#{field.to_s.tr('_', '-')}" }
      narrowed << "a work item" if options[:work_item]
      return if narrowed.empty?

      raise Error, "--sync mirrors the complete trail and cannot be narrowed by #{narrowed.join(', ')}"
    end

    # --repo/--target are registered for every command, so they are accepted here
    # whether or not this command reads them. Honor them as an alternate spelling
    # of the positional rather than silently answering for the whole fleet.
    def log_work_item_scope(options)
      scoped = [options[:repo], options[:target]].compact
      return options[:work_item] if scoped.empty?
      raise Error, "give the work item either positionally or with --repo/--target, not both" if options[:work_item]
      raise Error, "--repo and --target must be given together" unless scoped.length == 2

      "#{options[:repo]}##{options[:target]}"
    end

    def log_rows(store, options)
      since = log_since_timestamp(options)
      rows = log_event_rows(store)
      rows = rows.reject { |row| row.fetch("synthetic") } unless options[:include_synthetic]
      # The trail the query is about, before the options that narrow the view of
      # it. This is the rule log_limited states for the claim, applied to the
      # archive note: --limit and --since trim what is shown, never the evidence
      # that decides a question. The note is evidence -- this work item's history
      # is compacted and expiring however few of its rows the caller asked to see.
      @log_scoped_rows = log_work_item_rows(rows, options)
      log_filtered(rows, options, since).sort_by { |row| [row.fetch("at_key"), row.fetch("event_id")] }
    end

    # Scoped by the work item and nothing else: --since, --machine, --host,
    # --type and --limit describe the view of a subject rather than the subject
    # itself. Matched through the same identity folding log_filtered uses, so a
    # bare repo#123 query still covers the repo#123:qa lane.
    def log_work_item_rows(rows, options)
      wanted = log_wanted_identity(options)
      return rows unless wanted

      rows.select { |row| log_identity_match?(row.fetch("identity"), wanted) }
    end

    # --limit trims the trail that is shown, never the evidence that decides
    # whether a claim still stands: dropping a release because a newer event on
    # another alias filled the window would report a stale lease as live custody.
    def log_limited(rows, options)
      options[:limit] ? rows.last(options[:limit]) : rows
    end

    def log_filtered(rows, options, since)
      wanted = log_wanted_identity(options)
      rows.select do |row|
        (wanted.nil? || log_identity_match?(row.fetch("identity"), wanted)) &&
          log_matches?(row, "machine", options[:machine]) &&
          log_matches?(row, "host", options[:host]) &&
          log_matches?(row, "type", options[:type]) &&
          (since.nil? || row.fetch("at_key") >= since)
      end
    end

    # The scalar column filters. The work item is not one of them: it is matched on
    # parsed identity in log_filtered, because one item's records carry several
    # spellings and a string compare would answer with only the queried one.
    def log_matches?(row, field, wanted)
      return true if wanted.nil? || wanted.to_s.empty?

      # The host column holds a family, so the flag value is normalized the same
      # way -- otherwise --host claude-code matches nothing, even though that is
      # the spelling the records actually carry and the flag's help advertises.
      wanted = log_host_family(wanted) if field == "host"
      row.fetch(field).casecmp?(wanted.to_s)
    end

    # Compare on work-item identity rather than the literal string: the store
    # holds one item as `319`, `issue:319`, and `pr:319`, and matching literally
    # answers with whichever third of its history shares the queried spelling.
    # A query that names a lane keeps its narrower meaning; a query that does not
    # covers the item and every lane under it.
    #
    # Both sides are parsed from raw repo/target rather than from the rendered
    # work item, which substitutes a "?" placeholder for a missing value -- text
    # meant for a reader, never for deciding identity.
    #
    # Both arguments are already-parsed [repo, base, lane] identities. Accepting a
    # raw string here too would re-split the query once per row compared, which is
    # the cost log_identity exists to pay exactly once.
    # The identity the query names, or nil when it named none. Read once and
    # shared, so the rows a filter keeps and the envelopes the archive note
    # scopes to cannot disagree about what was asked for.
    def log_wanted_identity(options)
      value = options[:work_item].to_s
      return nil if value.empty?

      log_identity(*log_split_work_item(value))
    end

    def log_identity_match?(candidate, wanted, lane_exact: false)
      return false unless candidate.fetch(0).casecmp?(wanted.fetch(0))
      return false unless candidate.fetch(1) == wanted.fetch(1)
      return wanted.fetch(2) == candidate.fetch(2) if lane_exact

      wanted.fetch(2).nil? || wanted.fetch(2) == candidate.fetch(2)
    end

    # [repo, base, lane]. Parsed once per query and once per record, never per
    # comparison: a long trail would otherwise re-split the same query string for
    # every row it is matched against.
    def log_identity(repo, target)
      base, lane = AgentCoord.work_item_parts(target)
      [repo.to_s, base, lane]
    end

    # Targets contain colons, repos do not contain "#", so the last "#" is the
    # boundary.
    def log_split_work_item(value)
      repo, _, target = value.to_s.rpartition("#")
      [repo, target]
    end

    def log_row(data)
      {
        "at" => log_present(data["at"]),
        "at_key" => log_at_key(data["at"]),
        "machine" => log_present(data["machine_id"] || log_closed_by(data, "machine")),
        "host" => log_host_family(data["host"]),
        "work_item" => log_work_item(data),
        "identity" => log_identity(data["repo"].to_s.strip, data["target"].to_s.strip),
        "target" => data["target"].to_s.strip,
        "type" => log_present(data["type"]),
        "phase" => log_present(data["phase"] || data["new_phase"] || data["terminal"] || data["status"]),
        "agent_id" => log_present(data["agent_id"] || log_closed_by(data, "agent_id")),
        "batch_id" => log_present(data["batch_id"]),
        "detail" => log_detail(data),
        "host_raw" => log_present(data["host"]),
        "event_id" => log_present(data["event_id"]),
        "synthetic" => data["synthetic"] ? true : false,
        "synthetic_kind" => log_present(data["synthetic_kind"])
      }
    end

    # Degrade the way status does rather than hard-failing: a scoped token or an
    # older backend must not turn a read-only query into a crash. Every degraded
    # path says so on stderr, because a silently short trail reads exactly like a
    # complete one.
    def log_event_entries(store)
      log_listing(store, "events") { |reason| "warning: events #{reason}; this trail may be incomplete" }
    end

    # gc compacts a completed lane's events into archive/events and deletes the
    # hot copies, so reading only the live prefix answered "no events" for
    # precisely the work most likely to be asked about after the fact -- and
    # said it in the same words it uses for work that never happened. The
    # archived payloads are the same event records log_row already consumes, so
    # they are folded back in by default rather than behind a flag: a continuous
    # custody trail is what this command promises, and the silence was the defect.
    def log_event_rows(store)
      seen = {}
      rows = log_event_entries(store).map do |entry|
        row = log_row(entry.data)
        # The row itself, not a marker: an archived duplicate of this event needs
        # somewhere to record the envelope it came from, and the row that is
        # reported is the only thing the note can still see.
        seen[log_event_dedup_key(entry.data)] = row
        row
      end
      rows + log_archived_event_rows(store, seen)
    end

    # Compaction writes the archive envelope before deleting its sources, so a
    # run interrupted between the two leaves one event readable from both places.
    # The live copy wins. Ordering is left to log_rows, which already sorts the
    # merged set by instant, so archived and live events for one work item
    # interleave rather than arriving in two blocks.
    def log_archived_event_rows(store, seen)
      log_archived_event_entries(store).flat_map do |entry|
        # Records first. log_archived_event_data is what rejects a record this
        # version cannot read, and the ledger entry reaches into the same
        # envelope, so building it ahead of that check let a record that is not
        # an object end the command with a raw TypeError.
        read = log_archived_event_data(entry)
        # nil is an entry nothing can be trusted about, not even its clock.
        # Anything else is registered even when it yielded no legible record:
        # the envelope exists and is expiring, and dropping it from the ledger
        # took its delete_after out of the note along with its rows.
        next [] unless read

        records, malformed = read
        log_archive_record_envelope(entry, records, malformed)
        next [] if records.empty?

        records.filter_map do |data|
          identity = log_event_dedup_key(data)
          twin = seen[identity]
          next log_archive_twin(twin) if twin

          row = log_row(data).merge("archived" => true, "archive_held" => true)
          seen[identity] = row
          row
        end
      end
    end

    # The live copy wins the row, but the event is in the archive all the same
    # and on the same clock, so the row records that it is held there. Only a
    # flag: everything the note needs about the envelope is in the ledger, which
    # is what stopped this from having to carry -- and guard against overwriting
    # -- a whole provenance blob. Returns nil so filter_map drops the duplicate.
    def log_archive_twin(row)
      row["archive_held"] = true
      nil
    end

    # The key two records are the same event under -- not to be confused with
    # log_identity, which folds the spellings of one work item. This one answers
    # "have I already reported this event", nothing about work items.
    #
    # The batch and the event id together, because event_id is not unique across
    # the store: a terminal event takes its id from the lane name alone (see
    # stable_terminal_event_id), so two batches that each register a lane named
    # "qa" write the same event_id under different batch paths. Deduplicating on
    # the bare id let a live event in one batch suppress an archived event in
    # another -- reporting no events for a work item whose history is sitting in
    # the archive, which is the failure this read exists to remove. The real
    # duplicate this still has to collapse, one event readable from both events/
    # and archive/events/ after an interrupted compaction, carries both halves.
    #
    # Both halves are required rather than assumed. event_payload does stamp them
    # together, but that is one producer's behavior, not a rule the store
    # enforces: a hand-migrated record, a future producer, or a record written
    # after event ids but before batch stamping would key as [nil, event_id] and
    # collide across contexts exactly the way the bare id did. A record missing
    # either half falls back to the whole record instead.
    #
    # That fallback also covers the roughly one in ten recorded events that
    # predate event ids; collapsing those onto one missing-id key would drop real
    # history as a false duplicate. It needs no batch scope of its own, since the
    # record it keys on already carries batch_id when the event has one. The
    # residual collision it cannot narrow is two records identical in every
    # recorded field -- same batch, instant, type, work item, machine, and agent,
    # or none of them stamped at all. Those two render as the same line, so the
    # trail loses a repeat rather than a fact.
    def log_event_dedup_key(data)
      event_id = data["event_id"]
      batch_id = data["batch_id"]
      return data unless log_identity_part?(event_id) && log_identity_part?(batch_id)

      [batch_id, event_id]
    end

    def log_identity_part?(value)
      value.is_a?(String) && !value.empty?
    end

    # Only families whose payload is an event, and only from the archived events
    # prefix. An archived claim or heartbeat is a different record living under
    # archive/claims or archive/heartbeats, and folding one in would report it as
    # an event it never was. An unrecognized family is reported rather than
    # skipped -- silently dropping archived history is the bug being fixed.
    # A record that is not a JSON object has no family at all. Truncated JSON
    # already degrades through the listing, but valid JSON holding an array or a
    # scalar reached this far, and the http backend does not shape-check the
    # payload it hands back, so it takes the same reported-not-skipped path.
    def log_archived_event_data(entry)
      data = entry.data
      case data.is_a?(Hash) ? data["record_family"] : nil
      when "compacted_events" then log_compacted_records(entry, data)
      when "archived_record" then log_archived_record(entry, data)
      else
        log_archive_incomplete(entry, "unknown archived record family")
        nil
      end
    end

    # A compacted envelope describes a generation: source_paths is what gc
    # consumed and records is the subset it kept, so the two have to agree before
    # either can be trusted. An absent or non-array source_paths used to pass
    # through Array(), which yields 0 for nil and an arbitrary count for a hash,
    # and the note then reported no compaction loss for an envelope whose source
    # metadata was unreadable. Retaining more records than were consumed is
    # likewise impossible, since compaction keeps a subset.
    #
    # One sentence per envelope: the defects are ordered from the most
    # fundamental, and only the first is reported, so a doubly corrupt record
    # does not print twice. Legible records are still returned in every case --
    # a corrupt envelope header does not make the events inside it wrong, and
    # dropping them would be the silent loss this read exists to remove.
    def log_compacted_records(entry, data)
      records = data["records"]
      legible = records.is_a?(Array) ? records.grep(Hash) : []
      defect = log_compaction_defect(records, data["source_paths"])
      if defect
        log_archive_incomplete(entry, defect)
        return [legible, true]
      end

      log_archive_report_expiry(entry, data)
      [legible, false]
    end

    # The retention clock is the one warning that says this history is going to
    # disappear, so filtering an unreadable one out of the comparison and saying
    # nothing left the trail reading complete while it expired. It is reported
    # instead, and marks the trail incomplete so --sync refuses -- but it is not
    # treated as making the envelope unreadable, because a bad clock says nothing
    # about the records or the source paths beside it. Reached only when nothing
    # else was wrong, so an envelope still gets one sentence.
    def log_archive_report_expiry(entry, data)
      return if log_archive_expiry?(data["delete_after"].to_s)

      log_archive_incomplete(entry, "unreadable archive expiry")
    end

    def log_compaction_defect(records, sources)
      return "malformed archived record body" unless records.is_a?(Array)
      return "malformed archived source paths" unless sources.is_a?(Array)
      return "malformed archived source paths" unless sources.all? { |path| log_archive_path?(path) }
      return "duplicate archived source paths" unless sources.uniq.length == sources.length
      # Past this point log_archive_source_list? holds, so the ledger records
      # exactly the paths counted here.
      # gc retains at least the first and last event of every generation it
      # compacts (see gc_compacted_entries), so retaining nothing while naming
      # consumed sources is corruption rather than an empty generation. Both
      # empty is degenerate but not self-contradictory and is left alone.
      return log_archive_empty_defect(sources) if records.empty?

      # Compared on the records that can actually be read. Counting the raw array
      # called a mixed envelope impossible -- "3 retained records exceed 2 source
      # paths" -- when what happened was that two of its three were unreadable,
      # which is the next rung and the one the operator needs.
      legible = records.grep(Hash)
      if legible.length > sources.length
        return "#{legible.length} retained records exceed #{log_archive_count(sources.length, 'source path')}"
      end

      dropped = records.length - legible.length
      log_archive_count(dropped, "unreadable archived record") if dropped.positive?
    end

    # Both empty is degenerate but not self-contradictory: the envelope consumed
    # nothing and retained nothing, so there is nothing to report.
    def log_archive_empty_defect(sources)
      return nil if sources.empty?

      "no retained records for #{log_archive_count(sources.length, 'source path')}"
    end

    # One archived event rather than a generation, so there is one source_path
    # rather than a list -- but it is still the path this entry consumed, and the
    # note counts it, so an absent or unusable one leaves the arithmetic short
    # rather than merely uninformative. Laddered like the compacted case so a
    # doubly corrupt entry still prints one sentence.
    def log_archived_record(entry, data)
      defect = log_archived_record_defect(data)
      if defect
        log_archive_incomplete(entry, defect)
        return [[], true]
      end

      log_archive_report_expiry(entry, data)
      [[data["data"]], false]
    end

    def log_archived_record_defect(data)
      return log_archive_count(1, "unreadable archived record") unless data["data"].is_a?(Hash)
      return "malformed archived source paths" unless log_archive_path?(data["source_path"])

      nil
    end

    # A path is only a path if it is a non-empty string. nil, an empty string, a
    # number, or a nested object are all values the dropped-source arithmetic
    # cannot count, and counting them anyway is what let a retained record cancel
    # a source that really was omitted.
    def log_archive_path?(value)
      value.is_a?(String) && !value.strip.empty?
    end

    def log_archive_count(count, noun)
      "#{count} #{noun}#{'s' unless count == 1}"
    end

    # The path and the error text both come from the backend -- over HTTP the
    # path is whatever the server put in its listing response -- so they are
    # scrubbed before reaching a terminal, the same way the note scrubs the
    # delete_after it prints. An archive record is not a trusted source of
    # escape sequences.
    def log_archive_incomplete(entry, reason)
      log_note_incomplete(LOG_ARCHIVED_EVENTS_PREFIX,
                          log_scrub("warning: #{reason} at #{entry.path}; this trail may be incomplete"))
    end

    # Provenance for the note, not for the rendered row. It is keyed by archive
    # path so one envelope's dropped-source count is counted once rather than
    # once per row it contributed: a compacted envelope lists every source path
    # it consumed but retains only the first, last, terminal, and phase-changing
    # events, so a restored trail can be shorter than the one gc swallowed.
    # Every envelope the read consulted, recorded as it is read rather than
    # reconstructed afterwards from whichever rows survived. Rows are the wrong
    # carrier for an envelope-level fact: deduplication, the synthetic filter,
    # --since, --machine and --limit each remove rows, and each removal used to
    # take an envelope's delete_after and dropped-source count out of the note
    # with it. A ledger entry outlives all of them, so the note is a function of
    # what was read and what was asked, not of what happened to be displayed.
    #
    # records is kept so the note can scope itself to the queried work item --
    # the note must describe the item asked about, never another lane's clock --
    # and synthetic is the envelope's own flag, which gc sets only when every
    # entry it consumed was synthetic. A mixed generation therefore stays
    # reportable even when the default filter removes all of its rows, because
    # its source count still proves a real event was consumed.
    #
    # Only an array-valued source_paths is recorded. Array() would turn a hash
    # into an arbitrary number of pairs and nil into zero, either of which
    # reports a confident count for an envelope whose source metadata
    # log_compaction_defect has just warned is unreadable.
    def log_archive_record_envelope(entry, records, malformed)
      data = entry.data
      (@log_archive_ledger ||= []) << {
        "malformed" => malformed,
        "path" => entry.path,
        "delete_after" => data["delete_after"].to_s,
        "sources" => log_archive_sources(data),
        "identities" => records.map { |record| log_event_dedup_key(record) },
        "records" => records,
        "synthetic" => data["synthetic"] == true
      }
    end

    # archived_record names the one path it consumed as a singular source_path,
    # where compacted_events carries an array. Recording no sources for it while
    # still counting its identity as retained made the two cancel: a compacted
    # envelope that genuinely dropped a source reported none as soon as an
    # archived_record sat beside it in the same scope.
    def log_archive_sources(data)
      sources = data["source_paths"]
      # Only a validated list reaches the ledger. log_compaction_defect and
      # log_archived_record_defect have already reported anything rejected here,
      # so leaving it out understates the loss rather than inventing a count,
      # and the trail is marked incomplete either way.
      return log_archive_source_list?(sources) ? sources : [] if sources.is_a?(Array)

      source = data["source_path"]
      log_archive_path?(source) ? [source] : []
    end

    # A usable list of consumed paths: every entry a real path, and no entry
    # twice, since one path names one consumed event.
    def log_archive_source_list?(sources)
      sources.uniq.length == sources.length && sources.all? { |path| log_archive_path?(path) }
    end

    # Scoped by the work item the query names, not by which rows survived
    # display. A wholly synthetic generation is excluded under the default
    # policy the same way its rows are.
    def log_archive_ledger(options)
      wanted = log_wanted_identity(options)
      Array(@log_archive_ledger).select { |envelope| log_archive_envelope_scoped?(envelope, options, wanted) }
    end

    # Scoped on the records themselves, the same way rows are. gc sets an
    # envelope's own synthetic flag only when every entry it consumed was
    # synthetic, but a foreign or corrupted envelope can carry that flag over a
    # record whose own flag is false -- and that record's row survives the
    # default filter, because rows read each record's flag. Scoping the ledger
    # by the envelope instead dropped the provenance of a row that was still
    # being reported, so the event printed with no retention or expiry note and
    # --sync accepted the trail as complete.
    #
    # The envelope's flag is the fallback only where there is no record to ask:
    # nothing legible came out of it, so there is also no work item to match,
    # and only an unscoped query can claim it.
    def log_archive_envelope_scoped?(envelope, options, wanted)
      return false unless log_archive_envelope_visible?(envelope, options)

      records = envelope.fetch("records")
      # Nothing legible came out of it, so there is no work item to match and
      # only an unscoped query can claim it.
      return wanted.nil? if records.empty?

      records.any? { |record| log_archive_record_scoped?(record, wanted) }
    end

    # Hidden only when the envelope is synthetic by both measures: gc's own
    # judgement, which it records only when every entry it consumed was
    # synthetic, and every record it retained saying so as well. Either one alone
    # still leaves real information here, and the two cases are mirror images.
    #
    # An envelope flag of false means a real event was consumed even if none was
    # retained, so its source count still proves a real loss. A record whose own
    # flag is false has its row reported -- rows read each record's flag, not the
    # envelope's -- so its provenance has to be reported beside it, or the event
    # prints with no retention or expiry note and --sync takes the trail as
    # complete. gc produces neither combination; foreign or corrupted state does,
    # and having decided to read such envelopes, reading them inconsistently with
    # the rows is worse than not reading them at all.
    def log_archive_envelope_visible?(envelope, options)
      return true if options[:include_synthetic]
      return true unless envelope.fetch("synthetic")

      envelope.fetch("records").any? { |record| !record["synthetic"] }
    end

    # Matched on identity rather than on the recorded spelling: the same folding
    # log_filtered applies to rows, so an envelope holding issue:123 events is in
    # scope for a bare #123 query, and a #123 query covers its :qa lane.
    def log_archive_record_scoped?(record, wanted)
      return true if wanted.nil?

      identity = log_identity(record["repo"].to_s.strip, record["target"].to_s.strip)
      log_identity_match?(identity, wanted)
    end

    # Additive by construction: reading the archive can add rows or a warning,
    # and must never turn a trail that reads today into a failure. So every
    # archive read failure degrades, including the ones log_listing re-raises --
    # an archive directory that is unreadable, or holds a record that will not
    # parse or that this process cannot open, is not a reason to stop reporting
    # the live events beside it. SystemCallError is named because the local store
    # reads each record outside the listing's own guard, so a record file the
    # process cannot open arrives here as a bare Errno, not an OperationalError.
    #
    # The breadth is deliberate, so do not narrow this rescue to match the two
    # shapes log_listing can classify. listing_degradation only recognizes
    # :forbidden and :unsupported; a malformed pagination response, a 500, or any
    # other backend defect falls outside both, and from here they are all the
    # same fact -- the archive did not answer -- layered onto a query that
    # already has an answer without it.
    #
    # Degrading is not the same as swallowing. Every path through here warns on
    # stderr on every invocation and marks the trail incomplete, and an
    # incomplete trail makes --sync refuse with exit 2 and write nothing, which
    # is the operation where completeness actually matters. (The marker reaches
    # the operator through those two channels; it is not yet a field in --json
    # output.)
    #
    # The asymmetry with the live events prefix, which fails hard on the same
    # listing errors, is intended at this level: an unreadable events prefix
    # means the query has no answer at all, so failing is the honest result
    # there, while an unreadable archive only means the answer is shorter. The
    # record-level asymmetry is not intended and is tracked in issue #176.
    # A backend with no archive prefix cannot be hiding archived events, because
    # it cannot have stored any: the worker change that made archive/events
    # listable is the same one that made it writable. STATE_PATH gained its
    # archive arm and STATE_PREFIX gained ARCHIVE_PREFIX in one commit, both
    # built from the same RECORD_PATH and ACTIVE_PREFIX constants, and validPath
    # gates PUT and DELETE as well as GET -- so a backend that rejects the
    # listing rejected gc's writes too. Reporting that as an incomplete trail
    # made --sync refuse forever on older backends, and this command's own
    # documentation asks operators to run it before every gc.
    def log_archived_event_entries(store)
      log_listing(store, LOG_ARCHIVED_EVENTS_PREFIX) do |reason|
        next "warning: archived events #{reason}; nothing can have been archived there" if
          reason == LOG_UNSUPPORTED_REASON

        "warning: archived events #{reason}; this trail may be incomplete"
      end
    rescue OperationalError, JSON::ParserError, SystemCallError => e
      log_note_incomplete(
        LOG_ARCHIVED_EVENTS_PREFIX,
        log_scrub("warning: archived events unreadable (#{e.message}); this trail may be incomplete")
      )
      []
    end

    # Provenance goes to stderr rather than into the trail. An archived event is
    # the same event it always was, so its row stays byte-identical: text, tsv,
    # and --json are read by other tools, and --sync dedupes on the exact tsv
    # line, so a decorated archived row would mirror as a second copy of an event
    # the file already holds. What the rows cannot show is that part of this
    # history now sits on a delete_after clock, and that compaction did not
    # retain every source event it consumed.
    def log_note_archived(options)
      envelopes = log_archive_ledger(options)
      return if envelopes.empty?

      dropped = log_archive_dropped(envelopes)
      expires = log_archive_soonest_expiry(envelopes)
      parts = log_archive_coverage(Array(@log_scoped_rows))
      if dropped.positive?
        verb = dropped == 1 ? "was" : "were"
        parts << "#{log_archive_count(dropped, 'source event')} #{verb} dropped by compaction"
      end
      # Silence here would be the defect this read exists to remove: a confident
      # loss count computed from the legible remainder, with no sign that some of
      # the evidence could not be read at all.
      unreadable = envelopes.count { |envelope| envelope.fetch("malformed") }
      if unreadable.positive?
        parts << "compaction loss unknown for #{log_archive_count(unreadable, 'unreadable envelope')}"
      end
      parts << "archive deleted after #{expires}" if expires
      parts << "mirror it with log --sync" unless options[:sync]
      @stderr.puts log_scrub(parts.join("; "))
    end

    # Unique source paths against unique retained identities. Two envelopes left
    # overlapping by an interrupted compaction can name the same consumed source
    # and each omit it, so differencing them separately counted one lost event
    # twice; taking both sides as sets counts it once and makes the total
    # independent of listing order.
    # Only envelopes we could read. An envelope already reported as malformed
    # cannot also yield a trustworthy loss count: its retained identities come
    # from the records that parsed, while its source paths count every event it
    # consumed, so differencing the two claims a loss for records that are merely
    # unreadable. A count computed from data we have just told the operator we
    # could not read is worse than no count, so it is left out and said so.
    def log_archive_dropped(envelopes)
      countable = envelopes.reject { |envelope| envelope.fetch("malformed") }
      consumed = countable.flat_map { |envelope| envelope.fetch("sources") }.uniq
      retained = countable.flat_map { |envelope| envelope.fetch("identities") }.uniq
      [consumed.length - retained.length, 0].max
    end

    # Counted over the trail the query is about, so --limit and --since cannot
    # decide whether the clock gets reported. Three cases, because they are three
    # different facts: nothing of this trail survives but the archive still holds
    # a compacted record of it; every archived event was also readable live, so
    # nothing here came from the archive; or some rows were read from the archive
    # and others merely duplicate what it holds. That last distinction is worth
    # keeping -- a row read from the archive disappears when delete_after passes,
    # while a live duplicate outlives it until gc finishes deleting its source --
    # but counting only the first hid the rest of what is on the clock.
    def log_archive_coverage(rows)
      archived = rows.count { |row| row["archived"] }
      held = rows.count { |row| row["archive_held"] }
      return ["note: the archive holds a compacted record for this trail"] if held.zero?
      return ["note: #{held} of #{rows.length} events are also held in the archive"] if archived.zero?

      clauses = ["note: #{archived} of #{rows.length} events read from the archive"]
      clauses << "#{held - archived} more held there too" if held > archived
      clauses
    end

    # The soonest clock, ordered on the parsed instant like every other
    # comparison here, so an offset timestamp cannot sort ahead of a Z one. A
    # value that is not a timestamp is not a clock, so it is dropped rather than
    # compared: log_at_key floors an unparseable string to -Infinity, which let
    # one unreadable delete_after sort first and hide the real date the rest of
    # the archive is deleted on.
    def log_archive_soonest_expiry(envelopes)
      dated = envelopes.filter_map do |envelope|
        value = envelope.fetch("delete_after")
        [value, log_at_key(value)] if log_archive_expiry?(value)
      end
      dated.min_by { |_value, key| key }&.first
    end

    def log_archive_expiry?(value)
      log_at_key(value) != -Float::INFINITY
    end

    # One listing path for both families: warn on a partial or degraded read,
    # remember that it happened, and hand back whatever was legible.
    #
    # Two degradations that are not the same fact. A forbidden prefix may hold
    # records this token cannot see, so the answer is short and must be reported
    # as such. A prefix the backend does not implement holds nothing, so nothing
    # is missing -- and treating that as an incomplete trail is what stopped
    # --sync writing a mirror at all on such a backend.
    def log_listing(store, prefix)
      entries = store.list_json(prefix)
      log_note_incomplete(prefix, yield("filtered by scoped token")) if filtered_status_list?(store, prefix)
      entries
    rescue OperationalError => e
      degradation = listing_degradation(e, prefix)
      raise unless degradation

      reason = degradation == :forbidden ? "not readable by scoped token" : LOG_UNSUPPORTED_REASON
      message = yield(reason)
      if degradation == :unsupported && unsupported_prefix_is_empty?(prefix)
        @stderr.puts(message)
      else
        log_note_incomplete(prefix, message)
      end
      []
    end

    # Read off the prefix rather than asked of the caller, so the rule holds for
    # every archive prefix by construction and a later reader of archive/claims
    # or archive/heartbeats cannot reintroduce the bug by forgetting to opt in.
    #
    # An archive prefix the backend does not implement cannot be hiding anything,
    # because it cannot have been written either: the worker change that made
    # archive listable is the same one that made it writable. STATE_PATH gained
    # its archive arm and STATE_PREFIX gained ARCHIVE_PREFIX in one commit, both
    # built from the same RECORD_PATH and ACTIVE_PREFIX constants, and validPath
    # gates PUT and DELETE as well as GET, so a backend that rejects the listing
    # rejected gc's writes too.
    #
    # The live prefixes are deliberately excluded. For events and claims an
    # unimplemented prefix is a missing answer rather than an empty one, because
    # that is where the answer comes from in the first place.
    def unsupported_prefix_is_empty?(prefix)
      prefix == "archive" || prefix.start_with?("archive/")
    end

    # Every prefix that degraded, not the last one to degrade. The trail is read
    # from two listings now, so a scalar named whichever wrote last -- telling an
    # operator whose live events were unreadable to go look at the archive.
    def log_note_incomplete(prefix, message)
      @log_incomplete ||= []
      @log_incomplete << prefix unless @log_incomplete.include?(prefix)
      @stderr.puts message
    end

    # Read order, so the prefix an operator reads first is the one read first.
    def log_incomplete_prefixes
      Array(@log_incomplete).join(", ")
    end

    # Order on a parsed instant, never on the rendered string. Lexical comparison
    # breaks once a timestamp carries an offset or fractional seconds, and the
    # unknown marker "?" sorts after every digit, which would float an undated
    # legacy event to the end and make it read as the current state. Undated
    # events precede everything stamped, and no window includes them.
    def log_at_key(value)
      Time.iso8601(value.to_s).to_r
    rescue ArgumentError, TypeError
      -Float::INFINITY
    end

    # Missing identity is reported as unknown rather than inferred. Roughly a
    # tenth of the recorded events predate machine stamping, and guessing which
    # machine ran them would make the trail confidently wrong.
    def log_present(value)
      text = value.to_s.strip
      text.empty? ? LOG_UNKNOWN : text
    end

    # Hosts are recorded with many spellings (codex, codex-subagent,
    # codex-desktop, codex-collaboration@its, claude-code). Collapse them onto
    # the codex/claude families that lib/agent_coordination/host_adapters.rb
    # already uses, and keep the raw value in the tsv column beside it.
    def log_host_family(value)
      text = value.to_s.strip.downcase
      return LOG_UNKNOWN if text.empty?
      return "codex" if text.start_with?("codex")
      return "claude" if text.start_with?("claude")

      text
    end

    # A contract-compliant v2 lane_closed supplies its identity only under
    # closed_by (see contracts/fixtures/v2/lane_closed.json), so the closer would
    # otherwise render unknown on exactly the event that ends a lane.
    def log_closed_by(data, field)
      closed_by = data["closed_by"]
      closed_by.is_a?(Hash) ? closed_by[field] : nil
    end

    def log_work_item(data)
      repo = data["repo"].to_s.strip
      target = data["target"].to_s.strip
      return "-" if repo.empty? && target.empty?

      "#{repo.empty? ? LOG_UNKNOWN : repo}##{target.empty? ? LOG_UNKNOWN : target}"
    end

    def log_detail(data)
      case data["type"]
      when "phase.changed" then log_phase_detail(data)
      when "claim.released", "handoff" then log_handoff_detail(data)
      when "escalation_requested" then "#{log_present(data['from_route'])} -> #{log_present(data['to_route'])}"
      when "error" then log_joined(data["severity"], data["category"], data["message"])
      when "help_requested" then log_joined(data["reason"], data["message"])
      when "human_intervention" then log_joined(data["kind"], data["message"])
      else data["message"].to_s
      end.to_s.strip.tr("\t\n", "  ")
    end

    def log_joined(*values)
      values.map(&:to_s).reject(&:empty?).join(" ")
    end

    def log_phase_detail(data)
      from = data["old_phase"] || data["previous_phase"]
      to = data["phase"] || data["new_phase"]
      return data["message"].to_s if from.nil? || to.nil?

      "#{from} -> #{to}"
    end

    def log_handoff_detail(data)
      destination = data["handoff_to"]
      note = data["handoff_note"] || data["message"]
      return note.to_s if destination.to_s.strip.empty?

      log_joined("-> #{destination}", note)
    end

    def validate_log_format!(options)
      raise Error, "--format must be text or tsv" unless ["", "text", "tsv"].include?(options[:format].to_s)
      return unless options[:json] && !options[:format].to_s.empty?

      raise Error, "--json and --format are mutually exclusive"
    end

    # `matched` is required rather than defaulting to `rows`: `rows` here is the
    # --limit-trimmed display slice, and silently falling back to it would rebuild
    # provenance from the limited set -- the exact bug log_limited exists to avoid.
    def emit_log(rows, options, claims, matched:)
      format = options[:format].to_s
      records = claims.map { |claim| claim.fetch("record") }
      if options[:json]
        events = rows.map { |row| log_scrub_values(row.slice(*LOG_TSV_FIELDS)) }
        # Provenance describes the search, so it is built from every matched row.
        # A display limit that shrank it would understate which spellings answered.
        payload = { "work_item" => log_work_item_summary(options, matched, claims),
                    "trail" => log_trail_state,
                    "events" => events, "claim" => records.last }.compact
        # Oldest first, like the trail above it, so the last thing printed or listed
        # is the current one. `claim` stays the newest for consumers that read one;
        # `claims` carries every holder so a concurrent alias claim is never
        # dropped from the answer.
        payload["claims"] = records unless records.empty?
        @stdout.puts JSON.pretty_generate(payload)
      elsif format == "tsv"
        # tsv is a data stream, so notes go to stderr rather than inventing a row
        # a consumer would have to parse around.
        rows.each { |row| @stdout.puts log_tsv_line(row) }
        log_report_trailer(options, claims, rows, @stderr)
      else
        log_report_rows(rows)
        log_report_trailer(options, claims, rows, @stdout)
      end
    end

    # Which spellings actually answered the query. An operator auditing "was this
    # ever worked" needs to see that `issue:319` and `pr:319` were folded in, and
    # an empty list is the explicit "searched, matched nothing" that a bare empty
    # events array cannot say on its own.
    def log_work_item_summary(options, rows, claims = [])
      wanted = options[:work_item].to_s
      return nil if wanted.empty?

      repo, target = log_split_work_item(wanted)
      # A live claim with no events is a supported answer, so its target counts as
      # a match; reporting the claim while reporting that nothing matched would
      # contradict itself. Targets come from the raw records the rows already
      # carry, not from re-splitting the rendered work item.
      matched = (rows.map { |row| row.fetch("target") } + claims.map { |claim| claim.fetch("target") }).uniq.sort
      { "repo" => repo, "target" => target, "matched_targets" => matched }
    end

    # stderr already warns, but a --json consumer never sees it: without this a
    # trail cut short by a scoped token is byte-identical to a complete empty one.
    def log_trail_state
      @log_incomplete ? "incomplete" : "complete"
    end

    def log_report_rows(rows)
      return if rows.empty?

      scrubbed = rows.map { |row| log_text_scrubbed(log_text_row(row)) }
      widths = log_text_widths(scrubbed)
      scrubbed.each { |row| @stdout.puts log_text_line(row, widths) }
    end

    # A claim reaches here only when it is the latest thing known about the work
    # item, so it always belongs last: it is the answer to "where is it now".
    def log_report_trailer(options, claims, rows, stream)
      stream.puts "no events for #{options[:work_item] || 'the current filters'}" if rows.empty?
      # One line per holder, oldest first: with two live alias claims, printing
      # only the newest would read as sole custody, and printing them newest-first
      # would contradict the trail's own last-line-is-current reading.
      claims.each { |claim| stream.puts log_claim_note_line(claim.fetch("record")) }
    end

    # Columns are sized to the rows actually being rendered so a single-work-item
    # trace stays tight while a mixed feed still lines up. `detail` is free text
    # and carries no width, which is why it is always last.
    def log_text_scrubbed(row)
      (LOG_TEXT_COLUMNS + ["detail"]).to_h { |field| [field, log_scrub(row.fetch(field))] }
    end

    def log_text_widths(rows)
      LOG_TEXT_COLUMNS.to_h { |field| [field, rows.map { |row| row.fetch(field).length }.max] }
    end

    def log_text_line(row, widths)
      columns = LOG_TEXT_COLUMNS.map { |field| row.fetch(field).ljust(widths.fetch(field)) }
      columns.push(row.fetch("detail")).join("  ").rstrip
    end

    # A work item can hold a claim while having no event trail, because claims
    # predating auto-emit were overwritten in place rather than appended. A bare
    # "no events" would hide live custody, so the claim record is reported with
    # its own provenance rather than being folded into the trail as an event.
    # A claim can be newer than the last event, because `claim` permits omitting
    # --batch-id and no lifecycle event is emitted without a batch. Reporting it
    # only on an empty trail would answer "where is it now" with the last thing
    # that happened to leave a trace, while a live claim sat unmentioned.
    def log_claim_for(store, options, rows)
      claims = log_claim_lookup(store, options)
      # Freshness is judged against the claim's own lane only. A lane holds a
      # separate lease, so an event on `issue:319:qa` says nothing about whether
      # the parent's custody still stands, and letting it decide would drop a live
      # holder from the answer.
      claims.reject { |claim| log_claim_superseded?(claim, rows) }
    end

    # Only the claim's own key can supersede it. Aliases are separate leases, so an
    # event on `pr:1` says nothing about whether the lease on `1` still stands, and
    # letting it decide would drop a live holder. This is also what the literal
    # match did before identity folding: a claim was only ever weighed against
    # events recorded under its own spelling.
    def log_claim_superseded?(claim, rows)
      key = claim.fetch("target").downcase
      latest = rows.select { |row| row.fetch("target").downcase == key }.last
      latest && log_at_key(claim.fetch("record").fetch("updated_at")) < latest.fetch("at_key")
    end

    def log_claim_lookup(store, options)
      wanted = options[:work_item].to_s
      return [] if wanted.empty?
      # A filter emptying the trail is a different answer from having no trail;
      # the claim is not evaluated against those filters, so reporting it here
      # would answer a question the operator did not ask.
      return [] if LOG_TRAIL_FILTERS.any? { |field| log_narrowing_option?(options, field) }

      claims = log_listing(store, "claims") do |reason|
        "warning: claims #{reason}; a claim for this work item would not be reported"
      end
      wanted_identity = log_identity(*log_split_work_item(wanted))
      matches = claims.select do |candidate|
        next false if candidate.data["synthetic"] && !options[:include_synthetic]

        log_identity_match?(log_claim_identity(candidate), wanted_identity, lane_exact: true)
      end
      # Two records can mean two different things, and the difference is the exact
      # claim key. One key written under two casings is a single lease recorded
      # twice, so the newest describes where the work is and the older is stale
      # noise. Two distinct keys are two leases: `claim` writes raw target paths,
      # so `9832` and `pr:9832` are independently claimable and the fleet holds
      # such pairs live under different agents -- collapsing those would conceal
      # exactly the double-claim an operator most needs to see. Lanes are matched
      # exactly rather than rolled up, because a lane holds its own lease too.
      matches.group_by { |candidate| log_claim_key(candidate) }
             .values
             .map { |variants| variants.max_by { |candidate| log_at_key(candidate.data["updated_at"]) } }
             .sort_by { |candidate| log_at_key(candidate.data["updated_at"]) }
             .map do |candidate|
               { "record" => log_claim_record(candidate.data, now_utc, log_claim_target(candidate)),
                 "target" => log_claim_target(candidate),
                 "identity" => log_claim_identity(candidate) }
             end
    end

    # The exact lease key, case-folded. Not the work-item identity: that folds
    # aliases, which are separate leases.
    def log_claim_key(entry)
      [log_claim_repo(entry).downcase, log_claim_target(entry).downcase]
    end

    def log_claim_identity(entry)
      log_identity(log_claim_repo(entry), log_claim_target(entry))
    end

    # Claims written before repo/target became explicit payload fields carry them
    # only in the path, which is why claim_status_hash falls back to it. Reading
    # the payload alone would leave such a claim unmatchable.
    def log_claim_repo(entry)
      (entry.data["repo"] || AgentCoord.repo_from_claim_path(entry.path)).to_s.strip
    end

    def log_claim_target(entry)
      (entry.data["target"] || AgentCoord.target_from_path(entry.path)).to_s.strip
    end

    # Built from claim fields directly rather than through log_row, whose "phase"
    # falls back to "status" for events -- which printed a claim whose status is
    # active as "phase active".
    # --limit only narrows a trail that had rows to drop; on an already-empty
    # trail a positive limit removed nothing, so it must not suppress the claim.
    def log_narrowing_option?(options, field)
      return options[field]&.zero? if field == :limit

      # Matches the column filters and the work-item match in log_filtered: an
      # empty value is the absence of a filter, so the two halves of one query
      # cannot disagree about whether it was narrowed.
      !options[field].to_s.empty?
    end

    # Structured so a --json consumer reads the claim's fields instead of
    # re-parsing the sentence the text renderer builds from them.
    def log_claim_record(data, now, target)
      {
        "status" => log_present(data["status"]),
        "machine" => log_present(data["machine_id"]),
        "host" => log_host_family(data["host"]),
        "agent_id" => log_present(data["agent_id"]),
        "phase" => log_phase_or_dash(data["phase"]),
        "updated_at" => log_present(data["updated_at"]),
        "expires_at" => log_present(data["expires_at"]),
        # Two holders are only actionable if each names the lease it holds: the
        # exact target is what a release or handoff has to address.
        "target" => log_present(target)
      }.transform_values { |value| log_scrub(value) }
       .merge(
         "lease_elapsed" => log_claim_lease_elapsed?(data, now),
         "synthetic" => data["synthetic"] ? true : false,
         "synthetic_kind" => log_scrub(log_present(data["synthetic_kind"]))
       )
    end

    # The fleet carries claims left active with a lease long past, so a claim
    # cannot be reported as current custody on recency alone. It is still shown --
    # a stale record is worth knowing about -- and the elapsed lease is reported
    # as the fact it is. Whether custody truly ended also depends on the holder's
    # heartbeat; deciding that here would be the state inference this command
    # exists to avoid, so the reader is given the lease time instead of a verdict.
    def log_claim_lease_elapsed?(data, now)
      expires = data["expires_at"].to_s
      return false if expires.empty?

      log_at_key(expires) < now.to_r
    end

    def log_claim_note_line(claim)
      parts = ["claim", claim.fetch("status")]
      parts << "[synthetic]" if claim.fetch("synthetic")
      parts.push(claim.fetch("machine"), claim.fetch("host"), claim.fetch("agent_id"),
                 claim.fetch("target"), "phase", claim.fetch("phase"),
                 "updated", claim.fetch("updated_at"))
      parts.push("lease elapsed", claim.fetch("expires_at")) if claim.fetch("lease_elapsed")
      parts.join(" ")
    end

    def log_phase_or_dash(value)
      value.to_s.strip.empty? ? "-" : value.to_s.strip
    end

    # Any field can carry operator- or agent-supplied text, so all of them are
    # scrubbed. An embedded tab would invent a column and an embedded newline
    # would split one event across two rows, silently corrupting the mirror.
    def log_tsv_line(row)
      LOG_TSV_FIELDS.map { |field| log_scrub(row.fetch(field)) }.join("\t")
    end

    # Text output stays compact, so provenance rides in the detail column there.
    def log_text_row(row)
      return row unless row.fetch("synthetic")

      row.merge("detail" => log_joined("[synthetic]", row.fetch("detail")))
    end

    # Only strings carry control characters; booleans must survive as booleans so
    # a --json consumer does not get "true" where it expects true.
    def log_scrub_values(row)
      row.transform_values { |value| value.is_a?(String) ? log_scrub(value) : value }
    end

    def log_scrub(value)
      value.to_s.gsub(/[\t\r\n]+/, " ").gsub(LOG_CONTROL_CHARACTERS, "")
    end

    # `--sync` mirrors the event store into a plain tab-separated file so grep
    # answers the same questions offline and instantly. It appends only lines the
    # file has not already seen, which keeps the local trail durable after `gc`
    # prunes hot events from the backend.
    def log_sync(options, rows)
      path = log_sync_path(options)
      log_sync_write(path, rows, options)
    rescue SystemCallError => e
      raise OperationalError, "log mirror unwritable: #{e.message}"
    end

    def log_sync_write(path, rows, options)
      FileUtils.mkdir_p(File.dirname(path))
      fresh = log_sync_append(path, rows.map { |row| log_tsv_line(row) })
      if options[:json]
        @stdout.puts JSON.pretty_generate({ "synced" => fresh.length, "path" => path })
      else
        @stdout.puts "synced #{fresh.length} new #{fresh.length == 1 ? 'event' : 'events'} to #{path}"
      end
      0
    end

    # Dedup and append under one exclusive lock. Two writers that each read before
    # either appended would both decide the same rows were new and write them
    # twice, and an append-only mirror has no later pass to clean that up.
    # A later sync can still discover an older event -- a concurrent writer, or a
    # backfill -- so the merged set is rewritten in timestamp order rather than
    # appended blindly. Nothing already recorded is ever dropped, and the rewrite
    # happens under the same exclusive lock as the read.
    def log_sync_append(path, lines)
      File.open("#{path}#{LOG_SYNC_LOCK_SUFFIX}", File::RDWR | File::CREAT, 0o600) do |lock|
        lock.flock(File::LOCK_EX)
        existing = log_sync_existing(path)
        seen = existing.to_h { |line| [line, true] }
        fresh = lines.reject { |line| seen.key?(line) }
        log_sync_replace(path, log_sync_ordered(existing + fresh)) unless fresh.empty?
        fresh
      end
    end

    def log_sync_existing(path)
      return [] unless File.exist?(path)

      File.readlines(path, chomp: true, encoding: "UTF-8").reject(&:empty?)
    end

    # Written beside the mirror so the rename stays on one filesystem, flushed to
    # disk before it is published, and moved into place in a single step. No
    # partial file is ever visible at the mirror's path.
    def log_sync_replace(path, lines)
      temp = "#{path}.tmp-#{Process.pid}-#{SecureRandom.hex(8)}"
      inherited = File.exist?(path) ? File.stat(path).mode & 0o777 : nil
      mode = inherited || 0o666
      # EXCL with an unpredictable name, so a symlink planted at the temporary
      # path cannot be followed and its target overwritten before the rename.
      File.open(temp, File::WRONLY | File::CREAT | File::EXCL, mode, encoding: "UTF-8") do |file|
        lines.each { |line| file.puts(line) }
        file.flush
        file.fsync
      end
      # CREAT applies the umask, which is what a new mirror should follow. Only an
      # existing file's mode is reasserted, since preserving that is the point.
      File.chmod(inherited, temp) if inherited
      File.rename(temp, path)
      AgentCoord.fsync_parent_directory(path)
    ensure
      FileUtils.rm_f(temp) if temp && File.exist?(temp)
    end

    # Ties break on event id exactly as log_rows does, so a grep of the mirror and
    # a `log` invocation cannot disagree about what happened last.
    def log_sync_ordered(lines)
      lines.sort_by.with_index do |line, index|
        fields = line.split("\t")
        [log_at_key(fields.first), fields[LOG_TSV_FIELDS.index("event_id")].to_s, index]
      end
    end

    def log_sync_path(options)
      File.join(options[:state_root] || default_status_state_root || default_local_state_root, LOG_SYNC_FILENAME)
    end

    def log_since_timestamp(options)
      value = options[:since]
      return nil if value.to_s.strip.empty?

      match = /\A(\d+)([mhdw])\z/.match(value.to_s.strip)
      return (now_utc - (Integer(match[1], 10) * LOG_SINCE_UNITS.fetch(match[2]))).to_r if match

      begin
        Time.iso8601(value.to_s.strip).to_r
      rescue ArgumentError
        raise Error, "--since expects a duration like 3d or an ISO8601 timestamp, got #{value.inspect}"
      end
    end

    def render_status(options)
      store = build_store(options)
      now = now_utc
      payload =
        case status_scope(options)
        when :target
          target_status_payload(store, options, now)
        when :batch
          batch_status_payload(store, options, now)
        else
          broad_status_payload(store, now)
        end
      if options[:include_archived]
        raise Error, "--include-archived is only valid for unscoped status" unless status_scope(options) == :all

        payload["archive"] = store.list_json("archive").map { |entry| archive_status_hash(entry) }
      end

      if options[:json]
        @stdout.puts JSON.pretty_generate(payload)
      else
        render_status_text(payload)
      end
      0
    rescue JSON::ParserError => e
      raise OperationalError, "state unreadable: #{e.message}"
    ensure
      close_store(store)
    end

    # batch-audit reports, per registered lane, which expected lifecycle events
    # are missing so batch-closeout workflows can fail-closed on an incomplete
    # telemetry trail. "Telemetry-complete" per lane: at least one
    # claim.acquired event AND a terminal signal (claim.released OR lane_closed);
    # either missing marks the lane incomplete (a lane with no events at all is
    # incomplete with both signals missing). Read-only, defaulting to the local
    # status state root like `status`. Exit: 0 complete, 1 incomplete (gaps), 2
    # UNKNOWN (unregistered/unreadable batch).
    def batch_audit(options)
      require_options(options, :batch_id)
      store = build_store(options)
      report = batch_audit_report(store, options.fetch(:batch_id))
      emit_batch_audit_report(report, options)
      BATCH_AUDIT_EXIT_CODES.fetch(report.fetch("verdict"))
    ensure
      close_store(store)
    end

    def batch_audit_report(store, batch_id)
      batch_entry = store.read_json(AgentCoord.batch_path(batch_id))
      return batch_audit_unknown_report(batch_id, "batch #{batch_id} is not registered") if batch_entry.nil?
      unless batch_entry.data.is_a?(Hash)
        return batch_audit_unknown_report(batch_id, "batch #{batch_id} state is not an object")
      end

      lanes = Array(batch_entry.data["lanes"])
      return batch_audit_unknown_report(batch_id, "batch #{batch_id} registers no lanes") if lanes.empty?

      event_prefix = AgentCoord.event_batch_prefix(batch_id)
      event_records = store.list_json(event_prefix)
      if filtered_status_list?(store, event_prefix)
        return batch_audit_unknown_report(batch_id, "event trail for #{batch_id} is filtered by a scoped token")
      end

      events = event_records.map(&:data)
      batch_context = { id: batch_id.to_s, repo: batch_entry.data["repo"] }
      owner_counts = batch_audit_owner_counts(lanes)
      target_counts = batch_audit_target_counts(lanes)
      reports = lanes.map do |lane|
        batch_audit_lane_report(lane, events, owner_counts, target_counts, batch_context)
      end
      {
        "batch_id" => batch_id,
        "verdict" => reports.all? { |lane| lane.fetch("complete") } ? "complete" : "incomplete",
        "lanes" => reports
      }
    rescue OperationalError, JSON::ParserError, PathValidationError => e
      batch_audit_unknown_report(batch_id, "coordination state unreadable: #{e.message}")
    end

    def batch_audit_unknown_report(batch_id, reason)
      { "batch_id" => batch_id, "verdict" => "unknown", "reason" => reason, "lanes" => [] }
    end

    # Non-empty target strings declared by a lane. Mirrors validate_batch_lane!'s
    # reject-empties so a stray "" never becomes an attribution key that would
    # match target-less events.
    def batch_audit_lane_targets(lane)
      Array(lane["targets"] || lane["target"]).compact.map(&:to_s).reject(&:empty?)
    end

    # Count how many lanes each non-UNKNOWN owner appears on, so owner-only
    # attribution can be gated to owners that unambiguously identify one lane.
    # register-batch enforces unique lane names but not unique owners.
    def batch_audit_owner_counts(lanes)
      lanes.each_with_object(Hash.new(0)) do |lane, counts|
        next unless lane.is_a?(Hash)

        owner = lane_owner(lane)
        counts[owner] += 1 unless owner == "UNKNOWN"
      end
    end

    # Count how many lanes each target appears on. register-batch enforces unique
    # lane names but not unique targets, so a shared target is ambiguous and must
    # not attribute an event to more than one lane.
    def batch_audit_target_counts(lanes)
      lanes.each_with_object(Hash.new(0)) do |lane, counts|
        next unless lane.is_a?(Hash)

        batch_audit_lane_targets(lane).uniq.each { |target| counts[target] += 1 }
      end
    end

    # A non-Hash lane entry (legacy or hand-edited state such as `[null]`) cannot
    # be verified, so it is reported incomplete rather than allowed to crash;
    # this preserves the never-false-complete guarantee.
    def batch_audit_lane_report(lane, events, owner_counts, target_counts, batch_context)
      return batch_audit_malformed_lane_report unless lane.is_a?(Hash)

      name = lane_name(lane)
      owner = lane_owner(lane)
      targets = batch_audit_lane_targets(lane)
      context = batch_audit_lane_context(
        lane,
        batch_context.fetch(:id),
        owner_counts,
        target_counts
      )
      lane_events = events.select do |event|
        batch_audit_event_for_repo?(event, batch_context[:repo]) && batch_audit_event_for_lane?(event, context)
      end
      missing = batch_audit_missing_signals(lane_events, context)
      {
        "name" => name,
        "owner" => owner,
        "targets" => targets,
        "event_count" => lane_events.length,
        "missing" => missing,
        "complete" => missing.empty?,
        "malformed" => false
      }
    end

    def batch_audit_malformed_lane_report
      {
        "name" => "UNKNOWN",
        "owner" => "UNKNOWN",
        "targets" => [],
        "event_count" => 0,
        "missing" => ["claim.acquired", "terminal"],
        "complete" => false,
        "malformed" => true
      }
    end

    def batch_audit_missing_signals(lane_events, lane)
      types = lane_events.map { |event| event["type"] }
      lineage = batch_audit_lineage(lane_events, lane)
      missing = []
      missing << "claim.acquired" unless types.include?("claim.acquired")
      missing << "terminal" unless batch_audit_valid_terminal_signal?(lane_events, lane, lineage)
      missing << "lifecycle" unless lineage.fetch(:ordinary_valid)
      missing
    end

    def batch_audit_lineage(lane_events, lane)
      authorized = lane.owner == "UNKNOWN" ? [] : [lane.owner]
      event_authorized = {}.compare_by_identity
      result = { authorized: authorized, event_authorized: event_authorized, ordinary_valid: true, ordered: true }
      ordered = batch_audit_ordered_lineage_events(lane_events)
      return result.merge(ordinary_valid: false, ordered: false) unless ordered

      ordered.each do |event|
        type = event["type"]
        if type == "claim.acquired"
          valid = batch_audit_valid_claimant_admission?(event, lane)
          authorized << event["agent_id"] if valid && !authorized.include?(event["agent_id"])
          result[:ordinary_valid] &&= valid
          event_authorized[event] = valid
        elsif BATCH_AUDIT_ORDINARY_LIFECYCLE_TYPES.include?(type)
          valid = batch_audit_valid_ordinary_lifecycle_event?(event, lane, type, authorized)
          result[:ordinary_valid] &&= valid
          event_authorized[event] = valid
        else
          closed_by = event["closed_by"]
          closer = closed_by["agent_id"] if closed_by.is_a?(Hash)
          event_authorized[event] = authorized.include?(closer)
        end
      end
      result
    end

    def batch_audit_ordered_lineage_events(lane_events)
      relevant = lane_events.select do |event|
        event.is_a?(Hash) &&
          (BATCH_AUDIT_ORDINARY_LIFECYCLE_TYPES.include?(event["type"]) || event["type"] == "lane_closed")
      end
      keyed = relevant.map do |event|
        return nil unless batch_audit_fact_string?(event["event_id"]) && gc_valid_datetime?(event["at"])

        [[Time.iso8601(event["at"]).utc, event["event_id"]], event]
      end
      return nil unless keyed.map(&:first).uniq.length == keyed.length

      keyed.sort_by(&:first).map(&:last)
    end

    def batch_audit_valid_claimant_admission?(event, lane)
      return false unless batch_audit_valid_ordinary_identity_facts?(event, lane)
      return false unless batch_audit_valid_ordinary_payload?(event, "claim.acquired")
      return true if event["agent_id"] == lane.owner
      return false if lane.owner == "UNKNOWN"
      return false unless lane.targets.include?(event["target"])

      event.key?("lane") ? event["lane"] == lane.name : lane.unique_targets.include?(event["target"])
    end

    def batch_audit_valid_ordinary_lifecycle_event?(event, lane, type, authorized)
      batch_audit_valid_ordinary_identity?(event, lane, authorized) &&
        batch_audit_valid_ordinary_payload?(event, type)
    end

    def batch_audit_valid_ordinary_identity?(event, lane, authorized)
      batch_audit_valid_ordinary_identity_facts?(event, lane) &&
        authorized.include?(event["agent_id"])
    end

    def batch_audit_valid_ordinary_identity_facts?(event, lane)
      return false unless event["schema_version"] == SCHEMA_VERSION
      return false unless BATCH_AUDIT_ORDINARY_REQUIRED_FACT_FIELDS.all? do |field|
        batch_audit_fact_string?(event[field])
      end
      return false unless BATCH_AUDIT_ORDINARY_OPTIONAL_IDENTITY_FIELDS.all? do |field|
        !event.key?(field) || batch_audit_fact_string?(event[field])
      end
      return false unless event["batch_id"] == lane.batch_id
      return false if event.key?("lane") && event["lane"] != lane.name
      return false if event.key?("target") && !lane.targets.include?(event["target"])

      gc_valid_datetime?(event["at"])
    end

    def batch_audit_valid_ordinary_payload?(event, type)
      case type
      when "claim.acquired"
        !event.key?("status") || event["status"] == "active"
      when "claim.released"
        !event.key?("status") || event["status"] == "released"
      when "phase.changed"
        batch_audit_valid_phase_change?(event)
      end
    end

    def batch_audit_valid_phase_change?(event)
      return false unless batch_audit_fact_string?(event["phase"])
      return false if event.key?("status") && !batch_audit_fact_string?(event["status"])

      historical = event.key?("old_phase") || event.key?("new_phase")
      published = event.key?("previous_phase")
      return false unless historical || published

      if historical
        return false unless %w[old_phase new_phase].all? { |field| batch_audit_fact_string?(event[field]) }
        return false if event["old_phase"] == event["new_phase"] || event["new_phase"] != event["phase"]
      end
      return false if published && (!batch_audit_fact_string?(event["previous_phase"]) ||
                                    event["previous_phase"] == event["phase"])

      true
    end

    def batch_audit_valid_terminal_signal?(lane_events, lane, lineage)
      terminal_events = lane_events.select { |event| event["type"] == "lane_closed" }
      if terminal_events.empty?
        return lane_events.any? do |event|
          event["type"] == "claim.released" && lineage.fetch(:event_authorized).fetch(event, false)
        end
      end
      return false unless terminal_events.all? do |event|
        batch_audit_valid_lane_closed_event?(event, lane, lineage)
      end
      return false if batch_audit_conflicting_terminal_events?(terminal_events)

      true
    end

    def batch_audit_valid_lane_closed_event?(event, lane, lineage)
      batch_audit_valid_terminal_contract?(event) &&
        batch_audit_valid_terminal_attribution?(event, lane, lineage)
    end

    def batch_audit_valid_terminal_contract?(event)
      return false unless gc_terminal_event?(event)
      return false unless BATCH_AUDIT_TERMINAL_REQUIRED_FACT_FIELDS.all? do |field|
        batch_audit_fact_string?(event[field])
      end
      return false unless BATCH_AUDIT_TERMINAL_OPTIONAL_FACT_FIELDS.all? do |field|
        !event.key?(field) || batch_audit_fact_string?(event[field])
      end

      closed_by = event["closed_by"]
      closed_by.values.all? { |value| batch_audit_fact_string?(value) }
    end

    def batch_audit_valid_terminal_attribution?(event, lane, lineage)
      return false if event.key?("batch_id") && event["batch_id"] != lane.batch_id
      return false if event.key?("lane") && event["lane"] != lane.name
      return false unless lane.targets.include?(event["target"])

      closer = event.dig("closed_by", "agent_id")
      return false unless lineage.fetch(:event_authorized).fetch(event, false)
      return false if event.key?("agent_id") && event["agent_id"] != closer

      true
    end

    def batch_audit_fact_string?(value)
      value.is_a?(String) && !value.strip.empty? && !value.strip.casecmp?("UNKNOWN")
    end

    def batch_audit_conflicting_terminal_events?(terminal_events)
      terminal_events.map do |event|
        terminal_conflict_semantics(terminal_payload_semantics(event))
      end.uniq.length > 1
    end

    # Repo gate applied before any lane-attribution key, so it constrains all three
    # paths uniformly. A batch manifest declares an optional repo and lanes carry no
    # per-lane repo; batch ids are reused across repos with colliding target numbers,
    # so a same-batch-id claim/release/lane_closed recorded under a different --repo
    # must never attribute to this batch. When the batch declares no repo, every
    # event passes (unchanged behavior). An event whose repo is absent is excluded
    # once the batch declares a repo, matching the terminal-closeout repo check.
    def batch_audit_event_for_repo?(event, batch_repo)
      return true if batch_repo.to_s.empty?

      event.is_a?(Hash) && event["repo"].to_s == batch_repo.to_s
    end

    # Classify an event to a lane. The explicit lane-name match is always trusted
    # (lane names are unique, and lane_closed/typed events may carry an explicit
    # `lane`). A target match attributes only when the target is unique in the batch
    # (register-batch does not enforce unique targets/owners). The owner (agent_id)
    # fallback attributes only when the owner is the batch's unique owner AND the
    # event's target belongs to this lane (or the event carries no target): a unique
    # owner doing other work under the same batch-id/repo must not complete this lane.
    # The batch repo gate (batch_audit_event_for_repo?) is applied by the caller first.
    def batch_audit_event_for_lane?(event, lane)
      return false unless event.is_a?(Hash)
      return true if lane.name != "UNKNOWN" && !lane.name.to_s.empty? && event["lane"].to_s == lane.name.to_s
      return true if lane.unique_targets.include?(event["target"].to_s)

      batch_audit_owner_attributes?(event, lane)
    end

    # Owner fallback: a unique lane owner attributes an event only when the event's
    # target is in the lane's declared targets, or the event carries no target.
    def batch_audit_owner_attributes?(event, lane)
      return false unless lane.owner_unique && event["agent_id"].to_s == lane.owner.to_s

      target = event["target"].to_s
      target.empty? || lane.targets.include?(target)
    end

    def emit_batch_audit_report(report, options)
      if options[:json]
        @stdout.puts JSON.pretty_generate(report)
      else
        render_batch_audit_text(report)
      end
    end

    def render_batch_audit_text(report)
      @stdout.puts "batch-audit #{report.fetch('batch_id')} #{report.fetch('verdict')}"
      if report.fetch("verdict") == "unknown"
        @stdout.puts "- #{report.fetch('reason')}"
        return
      end
      lanes = report.fetch("lanes")
      return @stdout.puts "- no lanes registered" if lanes.empty?

      lanes.each { |lane| render_batch_audit_lane(lane) }
    end

    def render_batch_audit_lane(lane)
      state = if lane.fetch("complete")
                "complete"
              else
                "incomplete missing #{lane.fetch('missing').join(', ')}"
              end
      @stdout.puts "- lane #{lane.fetch('name')} owner #{lane.fetch('owner')} #{state}"
    end

    def status_scope(options)
      target_scoped = options[:repo] || options[:target]
      batch_scoped = options[:batch_id]

      raise Error, "--batch-id cannot be combined with --repo or --target" if batch_scoped && target_scoped

      if target_scoped
        require_options(options, :repo, :target)
        :target
      elsif batch_scoped
        :batch
      else
        :all
      end
    end

    def broad_status_payload(store, now)
      section_notes = {}
      grouped = JSON_PREFIXES.to_h { |prefix| [prefix, status_list_entries(store, prefix, section_notes)] }
      heartbeats_by_id = heartbeats_by_agent(grouped.fetch("heartbeats"))
      lane_states = build_lane_states(grouped.fetch("batches"), heartbeats_by_id)
      malformed_names = malformed_batch_lane_names(grouped.fetch("batches"))
      section_notes["lanes"] = "malformed lane names: #{malformed_names.join(', ')}" unless malformed_names.empty?
      event_entries = status_event_entries(store, "events", section_notes)

      status_payload(
        scope: { "kind" => "all" },
        section_notes: section_notes,
        claim_entries: grouped.fetch("claims"),
        heartbeat_entries: grouped.fetch("heartbeats"),
        batch_entries: grouped.fetch("batches"),
        event_entries: event_entries,
        heartbeats_by_agent: heartbeats_by_id,
        lane_states: lane_states,
        now: now
      )
    end

    def target_status_payload(store, options, now)
      repo = options.fetch(:repo)
      target = options.fetch(:target)
      claim_entries, claim_notes, queried_holder = target_claim_entries(store, repo, target)
      heartbeat_entries, holder_notes = target_holder_heartbeats(store, claim_entries, queried_holder)
      # Claims and heartbeats are cleared on release and expiry, so this scope
      # alone cannot distinguish "never worked" from "worked and finished". Name
      # the command that can, rather than leaving the operator with two empty
      # sections that read like an answer.
      unchecked = "not checked in target scope; run `agent-coord log` for this target's history"
      section_notes = { "batches" => unchecked, "events" => unchecked }
      section_notes["claims"] = claim_notes.join("; ") unless claim_notes.empty?
      section_notes["heartbeats"] = holder_notes.join("; ") unless holder_notes.empty?

      status_payload(
        scope: {
          "kind" => "target",
          "repo" => repo,
          # The spelling the operator asked about, never a folded one: aliases
          # decide which records answer, not what question was asked.
          "target" => target.to_s
        },
        section_notes: section_notes,
        claim_entries: claim_entries,
        heartbeat_entries: heartbeat_entries,
        batch_entries: nil,
        event_entries: nil,
        heartbeats_by_agent: heartbeats_by_agent(heartbeat_entries),
        lane_states: {},
        now: now
      )
    end

    # `claim` writes the raw target, so one work item is independently claimable
    # under every spelling of itself -- the fleet holds `9832` and `pr:9832` live
    # under different agents. Since #145 `log` folds those spellings onto one
    # identity, so resolving this scope through the single literal path would
    # report "unclaimed" for an item `log` reports as claimed, in the same second.
    #
    # The two kinds of read here fail differently on purpose. The queried spelling
    # is the question the operator asked, so it keeps the semantics it has always
    # had: a corrupt or forbidden record there is still a hard error. An alias is
    # a spelling the operator did not ask about, and letting an unrelated stale or
    # half-written sibling abort a query the healthy record answers perfectly turns
    # a good answer into exit 2 -- which a plan-pr-batch probe reads as "custody
    # unknown" and stops on. Those degrade to a note instead.
    #
    # A note rather than a silent skip, and this is the load-bearing half: an
    # operator who sees "none" plus a degraded note must not read it as "definitely
    # unclaimed". Dropping the failed candidate quietly would produce exactly the
    # answer this whole scope exists to prevent -- reporting unclaimed while a read
    # failed -- so the note names the path and says a claim there would not have
    # been reported. Exit stays 0, matching how status_list_entries already
    # degrades a forbidden listing and what the README says degraded notes mean.
    def target_claim_entries(store, repo, target)
      queried, *aliases = target_claim_candidate_paths(repo, target)
      notes = []
      queried_entry = store.read_json(queried)
      if queried_entry && !queried_entry.data.is_a?(Hash)
        raise OperationalError, "state record is not a claim object: #{queried}"
      end

      entries = [queried_entry]
      aliases.each { |path| entries << target_alias_claim(store, path, notes) }
      # The holder of the queried claim, if it answered. Its heartbeat is a read
      # that existed before alias resolution and keeps the failure it had then.
      [target_collapsed_claims(entries.compact), notes, entries.first&.data&.fetch("agent_id", nil).to_s]
    end

    # Narrow on purpose. A malformed record and a scope that cannot reach this one
    # path are both "this candidate cannot answer"; anything else -- a dead
    # backend, an unsupported route -- is still a failure of the whole query and
    # must not be reported as an absent claim.
    def target_alias_claim(store, path, notes)
      entry = store.read_json(path)
      # Valid JSON that is not an object cannot be a claim, and reading a field off
      # it raises -- which would let an unrelated malformed sibling take down a
      # query the queried spelling answered perfectly.
      return entry if entry.nil? || entry.data.is_a?(Hash)

      notes << target_alias_note(path, "not a claim record")
      nil
    rescue Errno::ENOENT
      # A lock-free read can race a release after its existence check. At the
      # alias boundary, that is the same answer as an ordinary missing record.
      nil
    rescue JSON::ParserError
      notes << target_alias_note(path, "unreadable")
      nil
    rescue Errno::EACCES
      notes << target_alias_note(path, "not readable")
      nil
    rescue Errno::ENAMETOOLONG
      notes << target_alias_note(path, "path too long")
      nil
    rescue OperationalError => e
      reason = unreachable_alias_reason(e, path)
      raise unless reason

      notes << target_alias_note(path, reason)
      nil
    end

    def target_alias_note(path, reason)
      "#{path} #{reason}; a claim there would not be reported"
    end

    # Every way a single candidate path can be unable to answer, across backends:
    # a scoped token's 403 from the HTTP backend, and the local store refusing a
    # record it will not open or that is not a record at all. Exact record-path
    # read scopes are part of the authorization contract (docs/backend-design.md),
    # so a token can legitimately reach the queried claim and none of its siblings;
    # a wrong-mode or symlinked file in a state directory is the same condition
    # arrived at by accident.
    #
    # Enumerated by the exact message each raise site produces, never by a
    # substring or a class. A 500, a 401, a `route_not_found`, a truncated body, a
    # dead backend -- none of those are one candidate's problem, and reporting any
    # of them as an absent claim would be the silent wrong answer this scope
    # exists to prevent.
    def unreachable_alias_reason(error, path)
      forbidden = /\Ahttp backend read #{Regexp.escape(path)} failed: 403 forbidden\z/
      directory = File.dirname(path)
      case error.message
      when forbidden then "not readable by scoped token"
      when "state record is not readable: #{path}",
           "state record path is not readable or searchable: #{path}"
        "not readable"
      when "state layout invalid: #{path} is a symlink" then "is a symlink"
      when "state layout invalid: #{path} is not a regular file" then "is not a regular file"
      when "state layout invalid: #{directory} is a symlink" then "is in a symlinked directory"
      when "state layout invalid: #{directory} is not a directory" then "is not in a directory"
      end
    end

    # Two candidate paths can name one *file*: a case-insensitive checkout resolves
    # `ISSUE:319.json` and `issue:319.json` to the same record, and reporting that
    # one lease once per spelling that reached it would invent a second holder.
    #
    # The test is the lease the record names -- its repo, target, and holder --
    # rather than the whole payload. The two point reads are not one atomic read,
    # so a renew landing between them returns the same lease with a later
    # `updated_at`, and comparing payloads whole would render that one lease as two
    # holders: a false positive in the exact signal this scope exists to raise.
    # Those three fields do not move under a renew.
    #
    # Nor is it a case-folded key. Two files are two independently claimable
    # leases, and `claim` writes the target into the record from the same value it
    # puts in the path, so their payload targets differ and both are kept --
    # including two casings of one spelling on a case-sensitive store, and
    # including one agent holding both. Folding those together would discard a live
    # second holder, which is the concurrent double custody this scope exists to
    # surface, thrown away by the code meant to tidy the output. Keying on what the
    # record says about itself also decides the question without needing to know
    # whether this filesystem folds case, which nothing here can observe.
    #
    # Residual, and inherent to reading one record twice without a snapshot: a
    # takeover landing between the two reads returns two different holders for one
    # file, and both are reported. That state is genuinely ambiguous at the moment
    # it is read, and showing both holders is the safer direction.
    #
    # A record that does not name its own lease cannot be matched to another read
    # of itself, so it keys on its own path and never collapses. Two such records
    # collapsing would hide a holder, which is the worse error of the two.
    #
    # `log` still folds casing across its listing, so for two live leases under two
    # casings it reports one holder where this reports both. A lease is a file, so
    # `status` is the correct answer there and the divergence is deliberate; do not
    # restore the collapse to hide it.
    #
    # `uniq` keeps the first record of a lease -- the operator's own spelling --
    # and leaves every distinct lease in candidate order.
    def target_collapsed_claims(entries)
      entries.uniq { |entry| target_lease_key(entry) }
    end

    def target_lease_key(entry)
      data = entry.data
      return entry.path if data["target"].to_s.empty? || data["agent_id"].to_s.empty?

      [data["repo"], data["target"], data["agent_id"]]
    end

    # This stays a closed set of point reads rather than a claims listing:
    # plan-pr-batch probes target-scoped status through `agent-coord-bounded
    # --timeout 20` before assigning work, so a listing would make every planning
    # probe scan the whole fleet. At most four claim reads -- three for a
    # canonically spelled number, two for a slug, one for a target whose prefix is
    # part of its base -- whatever the fleet holds.
    #
    # The order is both the read order and the render order: the operator's own
    # spelling first, then the family in a fixed order. Ordering by claim
    # timestamp instead would let clock skew between two holders reshuffle the
    # answer between runs that read identical state.
    def target_claim_candidate_paths(repo, target)
      # The queried spelling resolves first and unrescued: it is the one the
      # operator asked about, so a segment it cannot form must still raise the
      # error it raises today rather than being silently dropped as a candidate.
      # Generated spellings can expose a segment-invalid leading dot when folding
      # off a decorative prefix. Such a spelling cannot be claimed, so omit it;
      # the queried spelling above remains unrescued.
      paths = [AgentCoord.claim_path(repo, target)]
      target_alias_spellings(target).each do |spelling|
        begin
          path = AgentCoord.claim_path(repo, spelling)
        rescue PathValidationError
          next
        end
        paths << path unless paths.include?(path)
      end
      paths
    end

    # Every spelling `claim` could have written for the work item this target
    # names, in canonical case: exactly the set work_item_parts folds onto this
    # target's (base, lane) identity, so `status` resolves what `log` matches by
    # construction rather than by a second enumeration that can drift from it.
    #
    # Generated, then verified against that identity, because generating alone is
    # not safe: the bare spelling is rebuilt as base + ":" + lane, and when folding
    # leaves a base that is itself a kind word the rebuilt string parses as a
    # *different* item. `adhoc:issue:319` is the `319` lane of an item called
    # `issue`, but "issue:319" reads back as issue 319 -- so without the check this
    # scope would report a holder of issue 319 as holding a work item they have
    # never touched, the inverse of the divergence it exists to fix. The check is
    # general on purpose: an enumeration of the shapes that misbehave would miss
    # the next one. Any target-identity shape list, here or in a test, needs a
    # target whose folded base is a kind word, because that is the family where
    # reconstruction re-parses.
    #
    # The round trip also subsumes which kinds may decorate: a prefix that does not
    # decorate this base stays part of the base when re-read -- `adhoc:319` reads
    # back as the item `adhoc:319`, not as the `319` this target names -- and fails
    # the check. So `issue:`/`pr:` attach to a number, `adhoc:` to a slug, and a
    # prefix that was already kept (`issue:foo`, `adhoc:319`) names only itself,
    # all from one rule rather than a restatement of #145's.
    #
    # Casing is identity to `log`, which matches through work_item_parts and
    # downcases, but a claim path is literal, so the canonical spelling of what was
    # typed is always among the candidates: an operator typing `Issue:320` must
    # find the `issue:320` the fleet actually holds. That is the tractable half.
    # The other half is not: a claim *written* under an arbitrary casing cannot be
    # found by a closed point-read set, because the casings are unbounded --
    # `--target 319` will not find a claim stored as `Issue:319`. README states
    # that limit.
    #
    # A lane suffix rides along on every spelling rather than being folded off. A
    # lane holds its own lease, so `319:qa` is not `319` -- but `issue:319:qa` and
    # `319:qa` are the same lane of the same item, and missing that would hide a
    # live lane holder exactly the way the bare item's aliases hid one.
    def target_alias_spellings(target)
      identity = AgentCoord.work_item_parts(target)
      base, lane = identity
      suffix = lane.nil? ? "" : ":#{lane}"
      spellings = ["#{base}#{suffix}", *WORK_ITEM_KINDS.map { |kind| "#{kind}:#{base}#{suffix}" }]
      spellings.select { |spelling| AgentCoord.work_item_parts(spelling) == identity }
    end

    # One heartbeat read per distinct holder, not per claim: two spellings held by
    # one agent are one agent, so a second read would spend a round trip to render
    # the same row twice.
    def target_holder_heartbeats(store, claim_entries, queried_holder)
      cache = {}
      entries = []
      notes = []
      claim_entries.each do |claim|
        holder = claim.data["agent_id"].to_s
        heartbeat = target_holder_heartbeat(store, holder, cache, queried_holder)
        if valid_status_heartbeat?(heartbeat)
          entries << heartbeat unless entries.include?(heartbeat)
        else
          notes << target_holder_note(claim, holder, heartbeat, qualified: claim_entries.length > 1)
        end
      end
      [entries, notes]
    end

    # The same asymmetry as the claim reads, one level down. The queried claim's
    # holder heartbeat is a read that existed before alias resolution, so an
    # unreadable one still fails the query exactly as it always did. A holder
    # reached only because an alias claim answered is a read this scope added, and
    # letting it abort turns an answer the records themselves gave into exit 2 --
    # the same stale-sibling breakage, one level down.
    #
    # It degrades onto the existing marker rather than a new one, so it renders
    # through the note the operator already knows: the holder could not be read.
    # That trades away the distinction between a malformed heartbeat and an
    # unreachable one, which the claims note keeps; the holder's identity is the
    # part an operator acts on. The failure is cached so a holder with two leases
    # is still read once.
    def target_holder_heartbeat(store, holder, cache, queried_holder)
      read_cached_status_heartbeat(store, holder, cache)
    rescue Errno::ENOENT
      raise if holder == queried_holder

      cache[holder] = nil
    rescue Errno::EACCES, Errno::ENAMETOOLONG
      raise if holder == queried_holder

      cache[holder] = :invalid
    rescue OperationalError => e
      raise if holder == queried_holder
      raise unless unreachable_alias_reason(e, AgentCoord.heartbeat_path(holder))

      cache[holder] = :invalid
    end

    # The wording is unchanged for a single claim, which was the only case until
    # aliases could produce two. With two holders the bare phrase would not say
    # which one it describes, so each note names its lease and its holder -- the
    # exact pair a release or handoff has to address.
    def target_holder_note(claim, holder, heartbeat, qualified:)
      note = case heartbeat
             when :invalid then "holder heartbeat unreadable"
             when :mismatched then "holder heartbeat mismatched"
             else holder.empty? ? "claim holder not set" : "holder heartbeat not found"
             end
      return note unless qualified

      target = claim.data.fetch("target", AgentCoord.target_from_path(claim.path))
      holder.empty? ? "#{note} for #{target}" : "#{note} for #{target} (#{holder})"
    end

    # rubocop:disable Metrics/AbcSize, Metrics/BlockLength, Metrics/CyclomaticComplexity, Metrics/MethodLength, Metrics/PerceivedComplexity
    def batch_status_payload(store, options, now)
      heartbeat_entries_by_agent = {}
      batch_entry = store.read_json(AgentCoord.batch_path(options.fetch(:batch_id)))
      batch_entries = [batch_entry].compact
      lane_states = {}
      section_notes = { "claims" => "not checked in batch scope" }
      event_entries =
        status_event_entries(store, AgentCoord.event_batch_prefix(options.fetch(:batch_id)), section_notes)
      malformed_dependency_refs = []
      unresolved_dependency_refs = []
      malformed_lane_names = []

      if batch_entry
        batch_id = batch_entry.data.fetch("batch_id", AgentCoord.target_from_path(batch_entry.path))
        lanes = Array(batch_entry.data["lanes"])
        lanes.each do |lane|
          name = lane_name(lane)
          if malformed_lane_name?(name)
            malformed_lane_names << name
            next
          end

          heartbeat = read_cached_status_heartbeat(store, lane_owner(lane), heartbeat_entries_by_agent)
          lane_states["#{batch_id}:#{name}"] = lane_status(lane, status_heartbeat_data(heartbeat))
        end

        dependency_refs = lanes.flat_map { |lane| lane_dependencies(lane) }.uniq
        dependency_refs.each do |dependency|
          next if lane_states.key?(dependency)

          candidates = dependency_lane_ref_candidates(dependency)
          if candidates.empty?
            malformed_dependency_refs << dependency
            next
          end

          malformed_dependency_ref = false
          candidates.each do |dependency_batch_id, dependency_lane_name|
            dependency_batch_path = batch_path_for_status(dependency_batch_id)
            malformed_dependency_ref = true unless dependency_batch_path
            next unless dependency_batch_path

            dependency_batch = store.read_json(dependency_batch_path)
            next unless dependency_batch

            dependency_lane = Array(dependency_batch.data["lanes"]).find do |lane|
              name = lane_name(lane)
              !malformed_lane_name?(name) && name == dependency_lane_name
            end
            unless dependency_lane
              malformed_dependency_ref = true
              next
            end

            heartbeat = read_cached_status_heartbeat(store, lane_owner(dependency_lane), heartbeat_entries_by_agent)
            lane_states[dependency] = lane_status(dependency_lane, status_heartbeat_data(heartbeat))
            break
          end
          malformed_dependency_refs << dependency if malformed_dependency_ref && !lane_states.key?(dependency)
          unresolved_dependency_refs << dependency if !malformed_dependency_ref && !lane_states.key?(dependency)
        end

        heartbeat_notes = []
        unreadable_heartbeat_owners = heartbeat_entries_by_agent.select { |_, entry| entry == :invalid }.keys
        mismatched_heartbeat_owners = heartbeat_entries_by_agent.select { |_, entry| entry == :mismatched }.keys
        missing_heartbeat_owners = heartbeat_entries_by_agent.select { |_, entry| entry.nil? }.keys
        unless unreadable_heartbeat_owners.empty?
          heartbeat_notes << "lane-owner heartbeats unreadable: #{unreadable_heartbeat_owners.join(', ')}"
        end
        unless mismatched_heartbeat_owners.empty?
          heartbeat_notes << "lane-owner heartbeats mismatched: #{mismatched_heartbeat_owners.join(', ')}"
        end
        unless missing_heartbeat_owners.empty?
          heartbeat_notes << "lane-owner heartbeats not found: #{missing_heartbeat_owners.join(', ')}"
        end
        section_notes["heartbeats"] = heartbeat_notes.join("; ") unless heartbeat_notes.empty?
        unless malformed_lane_names.empty?
          section_notes["lanes"] =
            "malformed lane names: #{malformed_lane_names.join(', ')}"
        end
        unless malformed_dependency_refs.empty?
          section_notes["dependencies"] =
            "malformed dependency refs: #{malformed_dependency_refs.join(', ')}"
        end
        unless unresolved_dependency_refs.empty?
          section_notes["unresolved_dependencies"] =
            "unresolved dependency refs: #{unresolved_dependency_refs.join(', ')}"
        end
      else
        section_notes["batches"] = "batch not found"
      end

      status_payload(
        scope: { "kind" => "batch", "batch_id" => options.fetch(:batch_id).to_s },
        section_notes: section_notes,
        claim_entries: [],
        heartbeat_entries: heartbeat_entries_by_agent.values.select { |entry| valid_status_heartbeat?(entry) },
        batch_entries: batch_entries,
        event_entries: event_entries,
        heartbeats_by_agent: heartbeat_entries_by_agent,
        lane_states: lane_states,
        now: now
      )
    end
    # rubocop:enable Metrics/AbcSize, Metrics/BlockLength, Metrics/CyclomaticComplexity, Metrics/MethodLength, Metrics/PerceivedComplexity

    # rubocop:disable Metrics/ParameterLists
    def status_payload(scope:, section_notes:, claim_entries:, heartbeat_entries:, batch_entries:,
                       event_entries:, heartbeats_by_agent:, lane_states:, now:)
      {
        "version" => VERSION,
        "scope" => scope,
        "degraded" => section_notes.values.uniq,
        "section_notes" => section_notes,
        "claims" => claim_entries.map { |entry| claim_status_hash(entry) },
        "heartbeats" => heartbeat_entries.map { |entry| heartbeat_status_hash(entry, now) },
        # nil is "this section was not read"; [] is "read, and there is nothing".
        # Collapsing the two lets an unchecked scope answer a question it never
        # asked -- see the section note for which command can answer it.
        "batches" => batch_entries&.map { |entry| batch_status_hash(entry, heartbeats_by_agent, lane_states, now) },
        "events" => event_entries&.map { |entry| event_status_hash(entry) }
      }
    end
    # rubocop:enable Metrics/ParameterLists

    def render_status_text(payload)
      @stdout.puts "claims"
      if payload.fetch("claims").empty?
        @stdout.puts "- #{status_section_note(payload, 'claims') || 'none'}"
      else
        payload.fetch("claims").each do |claim|
          @stdout.puts [
            "- #{claim.fetch('repo')}##{claim.fetch('target')}",
            claim.fetch("status"),
            claim.fetch("agent_id"),
            "branch #{claim.fetch('branch')}",
            "expires #{claim.fetch('expires_at')}"
          ].join(" ")
        end
      end

      @stdout.puts "heartbeats"
      if payload.fetch("heartbeats").empty?
        @stdout.puts "- #{status_section_note(payload, 'heartbeats') || 'none'}"
      else
        payload.fetch("heartbeats").each do |heartbeat|
          @stdout.puts "- #{heartbeat.fetch('agent_id')} " \
                       "#{heartbeat.fetch('status')} " \
                       "#{heartbeat.fetch('liveness')} " \
                       "#{heartbeat.fetch('target')} updated #{heartbeat.fetch('updated_at')}"
        end
      end

      @stdout.puts "batches"
      if payload.fetch("batches").to_a.empty?
        @stdout.puts "- #{status_section_note(payload, 'batches') || 'none'}"
      else
        payload.fetch("batches").each do |batch|
          render_batch_status_hash(batch)
        end
      end

      render_status_events(payload)
      render_status_archive(payload)

      degraded = payload.fetch("degraded", [])
      return if degraded.empty?

      @stdout.puts "degraded"
      degraded.each { |note| @stdout.puts "- #{note}" }
    end

    def archive_status_hash(entry)
      data = entry.data
      {
        "path" => entry.path,
        "record_family" => data.fetch("record_family", "unknown"),
        "source_path" => data["source_path"],
        "source_paths" => data["source_paths"],
        "reason" => data.fetch("reason", "unknown"),
        "synthetic" => data.fetch("synthetic", false),
        "archived_at" => data.fetch("archived_at", "UNKNOWN"),
        "delete_after" => data.fetch("delete_after", "UNKNOWN")
      }.compact
    end

    def render_status_archive(payload)
      return unless payload.key?("archive")

      @stdout.puts "archive"
      if payload.fetch("archive").empty?
        @stdout.puts "- none"
      else
        payload.fetch("archive").each do |record|
          source = record["source_path"] || Array(record["source_paths"]).join(",")
          @stdout.puts "- #{record.fetch('path')} #{record.fetch('record_family')} source #{source} " \
                       "delete_after #{record.fetch('delete_after')}"
        end
      end
    end

    def status_section_note(payload, section)
      payload.dig("section_notes", section)
    end

    def claim_status_hash(entry)
      data = entry.data
      {
        "path" => entry.path,
        "repo" => data.fetch("repo", AgentCoord.repo_from_claim_path(entry.path)),
        "target" => data.fetch("target", AgentCoord.target_from_path(entry.path)),
        "status" => data.fetch("status", "unknown"),
        "agent_id" => data.fetch("agent_id", "UNKNOWN"),
        "branch" => data.fetch("branch", "UNKNOWN"),
        "expires_at" => data.fetch("expires_at", "UNKNOWN")
      }.merge(status_metadata(data, STATUS_CLAIM_METADATA_FIELDS))
    end

    def heartbeat_status_hash(entry, now)
      data = entry.data
      target = [data["repo"], data["target"]].compact.join("#")
      target = "-" if target.empty?
      {
        "path" => entry.path,
        "agent_id" => data.fetch("agent_id", AgentCoord.target_from_path(entry.path)),
        "status" => data.fetch("status", "unknown"),
        "liveness" => heartbeat_liveness(data, now),
        "target" => target,
        "updated_at" => data.fetch("updated_at", "UNKNOWN")
      }.merge(status_metadata(data, STATUS_HEARTBEAT_METADATA_FIELDS))
    end

    def batch_status_hash(entry, heartbeats_by_agent, lane_states, now)
      batch = entry.data
      batch_id = batch.fetch("batch_id", AgentCoord.target_from_path(entry.path))
      lanes = Array(batch["lanes"]).map do |lane|
        name = lane_name(lane)
        owner = lane_owner(lane)
        heartbeat = heartbeats_by_agent[owner]
        heartbeat_data = status_heartbeat_data(heartbeat)
        status = lane_status(lane, heartbeat_data)
        liveness = status_heartbeat_liveness(heartbeat, now)
        deps = lane_dependencies(lane)
        blocked_on = deps.reject { |dependency| dependency_met?(dependency, lane_states) }

        {
          "name" => name,
          "owner" => owner,
          "targets" => Array(lane["targets"] || lane["target"]).compact.map(&:to_s),
          "status" => status,
          "liveness" => liveness,
          "deps" => deps,
          "blocked_on" => blocked_on
        }.merge(status_metadata(lane, STATUS_LANE_METADATA_FIELDS))
      end

      {
        "path" => entry.path,
        "batch_id" => batch_id,
        "lanes" => lanes
      }.merge(status_metadata(batch, STATUS_BATCH_METADATA_FIELDS))
    end

    def event_status_hash(entry)
      data = entry.data
      {
        "path" => entry.path,
        "batch_id" => data.fetch("batch_id", AgentCoord.event_batch_from_path(entry.path)),
        "type" => data.fetch("type", "unknown"),
        "at" => data.fetch("at", "UNKNOWN")
      }.merge(status_metadata(data, STATUS_EVENT_METADATA_FIELDS))
    end

    def status_metadata(data, fields)
      return {} unless data.is_a?(Hash)

      fields.each_with_object({}) do |field, metadata|
        metadata[field] = data[field] if data.key?(field) && !data[field].nil?
      end
    end

    def render_batch_status_hash(batch)
      @stdout.puts "- #{batch.fetch('batch_id')}"
      if batch.fetch("lanes").empty?
        @stdout.puts "  - lanes -"
        return
      end

      batch.fetch("lanes").each do |lane|
        @stdout.puts "  - lane #{lane.fetch('name')} owner #{lane.fetch('owner')} " \
                     "targets #{format_list(lane.fetch('targets'))} " \
                     "status #{lane.fetch('status')} #{lane.fetch('liveness')} " \
                     "deps #{format_list(lane.fetch('deps'))} blocked_on #{format_list(lane.fetch('blocked_on'))}"
      end
    end

    def render_event_status_hash(event)
      details = [
        "- #{event.fetch('batch_id')}",
        event.fetch("lane", "-"),
        event.fetch("type"),
        event.fetch("phase", event.fetch("status", "-")),
        "by #{event.fetch('agent_id', '-')}",
        "at #{event.fetch('at')}"
      ]
      message = event["message"].to_s
      details << message unless message.empty?
      @stdout.puts details.join(" ")
    end

    def render_status_events(payload)
      @stdout.puts "events"
      if payload.fetch("events").to_a.empty?
        @stdout.puts "- #{status_section_note(payload, 'events') || 'none'}"
      else
        payload.fetch("events").each do |event|
          render_event_status_hash(event)
        end
      end
    end

    def status_list_entries(store, prefix, section_notes)
      entries = store.list_json(prefix)
      section_notes[prefix] = "#{prefix} filtered by scoped token" if filtered_status_list?(store, prefix)
      entries
    rescue OperationalError => e
      # Deliberately narrower than status_event_entries: these sections have no
      # "unsupported by backend" note, so an old backend must still surface.
      raise unless listing_degradation(e, prefix) == :forbidden

      section_notes[prefix] = "#{prefix} not readable by scoped token"
      []
    end

    def status_event_entries(store, prefix, section_notes)
      entries = store.list_json(prefix).sort_by { |entry| [entry.data["at"].to_s, entry.path] }
      section_notes["events"] = "events filtered by scoped token" if filtered_status_list?(store, prefix)
      entries
    rescue OperationalError => e
      degradation = listing_degradation(e, prefix)
      raise unless degradation

      section_notes["events"] =
        if degradation == :forbidden
          "events not readable by scoped token"
        else
          "event state not supported by backend"
        end
      []
    end

    # Classifies the two listing failures a read-only command may degrade through
    # rather than crash: a scoped token forbidden from the prefix, and a backend
    # too old to serve it. Anything else is a real failure and must propagate.
    def listing_degradation(error, prefix)
      return :forbidden if scoped_http_forbidden_listing?(error, prefix)
      return :unsupported if unsupported_resource_listing?(error)

      nil
    end

    def filtered_status_list?(store, prefix)
      store.respond_to?(:filtered_list?) && store.filtered_list?(prefix)
    end

    def scoped_http_forbidden_listing?(error, prefix)
      error.message.match?(/\Ahttp backend list #{Regexp.escape(prefix)} failed: 403 forbidden\z/)
    end

    def unsupported_resource_listing?(error)
      # Broadly detects older backends until the protocol has a version handshake.
      error.message.match?(/invalid_(prefix|path)|route_not_found/)
    end

    def read_status_heartbeat(store, agent_id)
      return nil if agent_id.to_s.empty? || agent_id == "UNKNOWN"

      path = AgentCoord.heartbeat_path(agent_id)
      entry = store.read_json(path)
      return nil unless entry
      return :invalid unless entry.data.is_a?(Hash)

      payload_agent_id = entry.data.fetch("agent_id", AgentCoord.target_from_path(entry.path)).to_s
      return :mismatched unless payload_agent_id == agent_id

      entry
    rescue JSON::ParserError
      :invalid
    rescue PathValidationError
      nil
    end

    def read_cached_status_heartbeat(store, agent_id, cache)
      if agent_id.to_s.empty? || agent_id == "UNKNOWN"
        cache[agent_id] = nil unless agent_id.to_s.empty?
        return nil
      end
      return cache[agent_id] if cache.key?(agent_id)

      cache[agent_id] = read_status_heartbeat(store, agent_id)
    end

    def valid_status_heartbeat?(entry)
      entry && !%i[invalid mismatched].include?(entry)
    end

    def status_heartbeat_data(entry)
      return entry if entry.is_a?(Hash)

      valid_status_heartbeat?(entry) ? entry.data : nil
    end

    def status_heartbeat_liveness(entry, now)
      case entry
      when :invalid
        "unreadable"
      when :mismatched
        "mismatched"
      when Hash
        heartbeat_liveness(entry, now)
      else
        valid_status_heartbeat?(entry) ? heartbeat_liveness(entry.data, now) : "no-heartbeat"
      end
    end

    def dependency_lane_ref_candidates(ref)
      value = ref.to_s
      separator = value.rindex(":")
      return [] unless separator

      batch_id = value[0...separator]
      lane = value[(separator + 1)..]
      return [] if batch_id.to_s.empty? || lane.to_s.empty?

      [[batch_id, lane]]
    end

    def batch_path_for_status(batch_id)
      AgentCoord.batch_path(batch_id)
    rescue PathValidationError
      nil
    end

    def heartbeats_by_agent(entries)
      entries.to_h do |entry|
        data = entry.data
        [data.fetch("agent_id", AgentCoord.target_from_path(entry.path)), data]
      end
    end

    def build_lane_states(batches, heartbeats_by_agent)
      batches.each_with_object({}) do |entry, states|
        batch = entry.data
        batch_id = batch.fetch("batch_id", AgentCoord.target_from_path(entry.path))
        Array(batch["lanes"]).each do |lane|
          name = lane_name(lane)
          next if malformed_lane_name?(name)

          owner = lane_owner(lane)
          heartbeat = heartbeats_by_agent[owner]
          states["#{batch_id}:#{name}"] = lane_status(lane, heartbeat)
        end
      end
    end

    def malformed_batch_lane_names(batches)
      batches.flat_map do |entry|
        Array(entry.data["lanes"]).filter_map do |lane|
          name = lane_name(lane)
          name if malformed_lane_name?(name)
        end
      end
    end

    def lane_name(lane)
      lane["name"] || lane["id"] || "UNKNOWN"
    end

    def malformed_lane_name?(name)
      name.to_s.include?(":")
    end

    def lane_owner(lane)
      owner = lane["owner"] || lane["agent_id"]
      owner.to_s.empty? ? "UNKNOWN" : owner
    end

    def lane_status(lane, heartbeat)
      lane["terminal"] || heartbeat&.fetch("status", nil) || lane["status"] || "unknown"
    end

    def lane_dependencies(lane)
      Array(lane["depends_on"]).compact.map(&:to_s)
    end

    def dependency_met?(dependency, lane_states)
      DEPENDENCY_DONE_STATUSES.include?(lane_states.fetch(dependency, nil).to_s)
    end

    def format_list(values)
      compact_values = Array(values).compact.map(&:to_s).reject(&:empty?)
      compact_values.empty? ? "-" : compact_values.join(",")
    end

    def format_scope_list(values)
      values.include?("") ? "all-state" : format_list(values)
    end

    # validate_config_api_url! and HttpStore#parse_base_url both accept a URL
    # that carries userinfo, so a configured or command-line API URL can hold a
    # password. Every warning and report goes to stderr/stdout, which CI logs
    # and service logs capture verbatim, so the credential is stripped before
    # any URL is interpolated into output. Redaction rather than rejection: the
    # userinfo is inert (HttpStore authenticates with a Bearer token and only
    # ever hands Net::HTTP the host and port), so refusing such URLs would break
    # working configurations to fix a disclosure that stripping already closes.
    # The scheme, host, port, and path survive, which is all diagnostics need.
    def redact_url_userinfo(value)
      AgentCoord.redact_url_userinfo(value)
    end

    def build_store(options)
      return LocalStore.new(options.fetch(:state_root)) if options[:state_root]

      if options[:api_url]
        token = resolved_http_token(options.fetch(:api_url))
        warn_unbound_process_token(options.fetch(:api_url), options)

        return HttpStore.new(base_url: options[:api_url], token: token)
      end

      raise OperationalError, missing_backend_message if options[:backend].to_s.empty?

      GitHubStore.new(backend: options.fetch(:backend), ref: options.fetch(:ref))
    end

    def configured_api_token?
      AgentCoord.config_value_set?(@process_config&.fetch("AGENT_COORD_API_TOKEN", nil)) ||
        AgentCoord.config_value_set?(@user_config&.fetch("AGENT_COORD_API_TOKEN", nil))
    end

    def resolved_http_token(selected_url)
      # Presence is decided with the shared predicate -- a wholly blank token is
      # unset, exactly as read_token_from_stdin already refuses one -- but a real
      # token is returned verbatim, because whitespace inside it is significant.
      process_token = @process_config&.fetch("AGENT_COORD_API_TOKEN", nil)
      return process_token if AgentCoord.config_value_set?(process_token)

      saved_token = @user_config&.fetch("AGENT_COORD_API_TOKEN", nil)
      saved_url = @user_config&.fetch("AGENT_COORD_API_URL", nil)
      return saved_token if AgentCoord.config_value_set?(saved_token) && selected_url == saved_url
      unless AgentCoord.config_value_set?(saved_token)
        raise OperationalError, "AGENT_COORD_API_TOKEN is required when using the HTTP backend"
      end

      raise OperationalError,
            "process-scoped AGENT_COORD_API_TOKEN is required when the selected API URL differs from user config"
    end

    # A saved token is only ever used with the URL it was saved beside, but a
    # process-scoped token wins for every selected URL. That pairing is invisible
    # when the URL comes from the canonical config file or the command line, so a
    # stale exported token can reach an unrelated deployment while the correctly
    # bound saved token sits unused. Surface it; the precedence is unchanged, no
    # token value is ever printed, and the URL is redacted so userinfo embedded
    # in the selected URL cannot leak into stderr.
    def warn_unbound_process_token(selected_url, options)
      return unless AgentCoord.config_value_set?(@process_config&.fetch("AGENT_COORD_API_TOKEN", nil))
      return if selected_url == @process_config&.fetch("AGENT_COORD_API_URL", nil)

      emit_backend_conflict_warning(
        "warning: process-scoped AGENT_COORD_API_TOKEN is being used with " \
        "#{redact_url_userinfo(selected_url)}, which it was not set alongside; " \
        "the process token takes precedence over any saved token.", options:
      )
    end

    def close_store(store)
      store.close if store.respond_to?(:close)
    end

    def missing_backend_message
      "no coordination backend configured; set AGENT_COORD_API_URL and AGENT_COORD_API_TOKEN " \
        "for the HTTP backend, set AGENT_COORD_STATE_ROOT for local state, or pass --backend " \
        "or AGENT_COORD_BACKEND to explicitly use the legacy GitHub backend"
    end

    def default_status_state_root
      configured_root = ENV.fetch(STATUS_STATE_ROOT_ENV, nil)
      return configured_root if AgentCoord.config_value_set?(configured_root)

      source_root = AgentCoord.source_root
      AgentCoord.state_root?(source_root) ? source_root : nil
    end

    def default_local_state_root
      state_home = ENV.fetch("XDG_STATE_HOME", nil)
      state_home = nil unless Pathname.new(state_home.to_s).absolute?
      return File.join(File.expand_path(state_home), "agent-coordination") if state_home

      home = home_directory
      raise OperationalError, local_state_home_error unless Pathname.new(home.to_s).absolute?

      File.join(File.expand_path(home), ".local", "state", "agent-coordination")
    rescue ArgumentError
      raise OperationalError, local_state_home_error
    end

    def home_directory
      Dir.home
    end

    def local_state_home_error
      "cannot determine local state root; set XDG_STATE_HOME or HOME to an absolute path, or pass --state-root"
    end

    def write_with_cas(store, path, payload, existing, message)
      if existing
        store.write_json(path, payload, message: message, sha: existing.sha)
      else
        store.write_json(path, payload, message: message, create: true)
      end
    end

    def upsert_json(store, path, message:)
      2.times do
        existing = store.read_json(path)
        next_payload = yield(existing)
        store.write_json(path, next_payload, message: message, sha: existing&.sha, create: existing.nil?)
        return
      rescue Conflict
        next
      end
      raise Conflict, "state changed while writing #{path}"
    end

    def active_claim_record?(claim)
      claim["status"] == "active"
    end

    def claim_holder_state(store, claim, now)
      holder = claim["agent_id"].to_s
      heartbeat = holder.empty? ? nil : read_holder_heartbeat(store, holder)
      return fallback_holder_state(claim, now, "invalid") if heartbeat == :invalid

      liveness = heartbeat && heartbeat_liveness(heartbeat.data, now)

      return { liveness: liveness } if %w[live stale dead].include?(liveness)

      fallback_holder_state(claim, now, heartbeat ? "unknown" : "missing")
    end

    def fallback_holder_state(claim, now, liveness)
      {
        liveness: liveness,
        fallback_live: claim_fallback_live?(claim, now),
        fallback_expires_at: claim["expires_at"]
      }
    end

    def read_holder_heartbeat(store, holder)
      store.read_json(AgentCoord.heartbeat_path(holder))
    rescue OperationalError
      raise
    rescue JSON::ParserError
      :invalid
    rescue Error
      nil
    end

    def takeover_allowed?(holder_state)
      return false if %w[live stale].include?(holder_state.fetch(:liveness))
      return true if holder_state.fetch(:liveness) == "dead"

      !holder_state.fetch(:fallback_live)
    end

    def claim_refusal_message(options, claim, holder_state)
      holder = claim.fetch("agent_id", "UNKNOWN")
      liveness = holder_state.fetch(:liveness)
      details =
        if %w[live stale].include?(liveness)
          "heartbeat #{liveness}"
        else
          "heartbeat #{liveness}; fallback claim expires at #{holder_state.fetch(:fallback_expires_at, 'UNKNOWN')}"
        end
      "active claim for #{options[:repo]}##{options[:target]} held by #{holder}; #{details}"
    end

    def claim_fallback_live?(claim, now)
      parse_time(claim["expires_at"]) > now
    rescue ArgumentError, TypeError
      false
    end

    def heartbeat_liveness(heartbeat, now)
      updated_at = parse_time(heartbeat.fetch("updated_at"))
      expires_at = parse_time(heartbeat.fetch("expires_at"))
      ttl = expires_at - updated_at
      return "dead" unless ttl.positive?
      return "live" if now < expires_at
      return "stale" if now < updated_at + (HEARTBEAT_DEAD_AFTER_TTL_MULTIPLIER * ttl)

      "dead"
    rescue ArgumentError, KeyError, TypeError
      "unknown"
    end

    def load_batch_manifest(path)
      JSON.parse(File.read(path, encoding: "UTF-8"))
    rescue JSON::ParserError => e
      raise Error, "batch manifest JSON invalid: #{e.message}"
    rescue SystemCallError => e
      raise OperationalError, "batch manifest unreadable: #{e.message}"
    end

    def load_launch_prompt(path)
      prompt = path == "-" ? $stdin.read : File.binread(path)
      prompt = prompt.dup.force_encoding(Encoding::UTF_8)
      raise Error, "launch prompt must be valid UTF-8" unless prompt.valid_encoding?

      prompt
    rescue SystemCallError => e
      raise OperationalError, "launch prompt unreadable: #{e.message}"
    end

    def validate_batch_manifest!(manifest)
      raise Error, "batch manifest must be a JSON object" unless manifest.is_a?(Hash)

      batch_id = manifest["batch_id"].to_s
      raise Error, "batch manifest missing batch_id" if batch_id.empty?

      AgentCoord.batch_path(batch_id)
      AgentCoord.validate_repo!(manifest["repo"], "batch") if manifest["repo"]
      lanes = manifest["lanes"]
      raise Error, "batch manifest lanes must be an array" unless lanes.is_a?(Array)
      raise Error, "batch manifest lanes must not be empty" if lanes.empty?

      seen_names = {}
      lanes.each_with_index do |lane, index|
        name = validate_batch_lane!(lane, index + 1)
        raise Error, "batch lane #{name} is duplicated" if seen_names[name]

        seen_names[name] = true
      end
    end

    def validate_batch_lane!(lane, position)
      raise Error, "batch lane #{position} must be a JSON object" unless lane.is_a?(Hash)

      name = batch_lane_name_for_validation(lane, position)
      raise Error, "batch lane #{name} cannot contain ':'" if malformed_lane_name?(name)

      owner = batch_lane_owner_for_validation(lane, name)
      AgentCoord.validate_segment!(owner, "lane owner")
      targets = Array(lane["targets"] || lane["target"]).compact.map(&:to_s).reject(&:empty?)
      raise Error, "batch lane #{name} missing targets" if targets.empty?

      targets.each { |target| AgentCoord.validate_segment!(target, "lane target") }
      lane_dependencies(lane).each do |dependency|
        next if dependency_lane_ref_candidates(dependency).any? do |dependency_batch_id, dependency_lane_name|
          batch_path_for_status(dependency_batch_id) && !dependency_lane_name.to_s.empty?
        end

        raise Error, "batch lane #{name} has invalid dependency ref: #{dependency}"
      end
      name
    end

    def batch_lane_name_for_validation(lane, position)
      name = lane.key?("name") ? lane["name"] : lane["id"]
      raise Error, "batch lane #{position} missing name" if name.nil?
      raise Error, "batch lane #{position} name must be a string" unless name.is_a?(String)
      raise Error, "batch lane #{position} missing name" if name.empty?

      name
    end

    def batch_lane_owner_for_validation(lane, name)
      owner = lane.key?("owner") ? lane["owner"] : lane["agent_id"]
      raise Error, "batch lane #{name} missing owner" if owner.nil?
      raise Error, "batch lane #{name} owner must be a string" unless owner.is_a?(String)
      raise Error, "batch lane #{name} missing owner" if owner.empty?

      owner
    end

    def require_options(options, *names)
      names.each do |name|
        raise Error, "missing required --#{name.to_s.tr('_', '-')}" if options[name].to_s.empty?
      end
    end

    def positive_ttl(ttl)
      raise Error, "--ttl must be positive" unless ttl.to_i.positive?

      ttl.to_i
    end

    def now_utc
      @clock.now.utc
    end

    def timestamp(time)
      time.utc.iso8601
    end

    def parse_time(value)
      Time.iso8601(value).utc
    end

    def config_payload(options = {})
      {
        "version" => VERSION,
        "schema_version" => SCHEMA_VERSION,
        "lane_closed_schema_version" => LANE_CLOSED_SCHEMA_VERSION,
        "archive_schema_version" => ARCHIVE_SCHEMA_VERSION,
        "default_backend" => DEFAULT_BACKEND,
        "default_ref" => DEFAULT_REF,
        "default_claim_ttl_seconds" => DEFAULT_CLAIM_TTL,
        "default_heartbeat_ttl_seconds" => DEFAULT_HEARTBEAT_TTL,
        "heartbeat_dead_after_ttl_multiplier" => HEARTBEAT_DEAD_AFTER_TTL_MULTIPLIER,
        "retention_policy" => {
          "hot_days" => DEFAULT_HOT_DAYS,
          "archive_days" => DEFAULT_ARCHIVE_DAYS,
          "synthetic_hot_days" => DEFAULT_SYNTHETIC_HOT_DAYS
        },
        "dependency_terminal_statuses" => DEPENDENCY_DONE_STATUSES,
        "heartbeat_status_vocabulary" => {
          "working" => HEARTBEAT_WORKING_STATUSES,
          "terminal" => HEARTBEAT_TERMINAL_STATUSES,
          "aliases" => HEARTBEAT_STATUS_ALIASES
        },
        "exit_codes" => EXIT_CODES,
        "coordination" => coordination_config_payload(options)
      }
    end

    def coordination_config_payload(options)
      backend, configured, source = selected_coordination_backend(options)
      policy, policy_source = effective_policy
      validate_policy!(policy, policy_source)
      {
        "policy" => policy,
        "configured" => configured,
        "backend" => backend,
        "source" => {
          "backend" => source,
          "policy" => policy_source
        },
        # config show is intentionally non-networking. Consumers must use
        # doctor before treating a configured backend as available.
        "available" => nil
      }
    end

    # config show reports what resolution would actually do. Each explicit CLI
    # selector now carries a non-empty value or the command never got this far,
    # so every one of them is a real selection and none of them can fall through
    # to the implicit local default the way an empty --backend used to.
    #
    # Configured selectors must be tested with the same predicate
    # resolve_backend_env applies, or reporting and resolution disagree about
    # the same file. A bare `.to_s.empty?` here reported a canonical
    # AGENT_COORD_API_URL='   ' as `backend: http, configured: true` while
    # resolution stripped it and fell through to another selector or the
    # implicit local backend, so a workflow enforcing `required` coordination
    # from `config show --json` accepted a configuration whose commands write to
    # implicit local state -- the exact failure this reporting exists to catch.
    def selected_coordination_backend(options)
      return ["local", true, "cli"] if options[:state_root_cli]
      return ["http", true, "cli"] if options[:api_url_cli]
      return ["github", true, "cli"] if options[:backend_cli]

      selectors = effective_backend_selector_set
      source = selectors.fetch(:source)
      return ["http", true, source] if AgentCoord.config_value_set?(selectors.fetch(:api_url))
      return ["local", true, source] if AgentCoord.config_value_set?(selectors.fetch(:state_root))
      return ["github", true, source] if AgentCoord.config_value_set?(selectors.fetch(:backend))

      ["local", false, "default"]
    end

    def effective_backend_selector_set
      process_values = {
        api_url: @process_config&.fetch("AGENT_COORD_API_URL", nil),
        state_root: @process_config&.fetch("AGENT_COORD_STATE_ROOT", nil),
        backend: @process_config&.fetch("AGENT_COORD_BACKEND", nil)
      }
      return process_values.merge(source: "process_env") if process_selects_backend?

      {
        api_url: @user_config&.fetch("AGENT_COORD_API_URL", nil),
        state_root: @user_config&.fetch("AGENT_COORD_STATE_ROOT", nil),
        backend: @user_config&.fetch("AGENT_COORD_BACKEND", nil),
        source: "user_config"
      }
    end

    def emit_payload(payload, options)
      if options[:json]
        @stdout.puts JSON.pretty_generate(payload)
      else
        yield
      end
    end

    def check_command!(*args)
      stdout, stderr, status = AgentCoord.capture3_utf8(*args)
      return if status.success?

      message = [stderr, stdout].reject(&:empty?).map { |stream| AgentCoord.utf8_diagnostic(stream) }.join("\n")
      raise OperationalError, "#{args.join(' ')} failed: #{message}"
    rescue SystemCallError => e
      raise OperationalError, "#{args.join(' ')} failed: #{e.message}"
    end

    def check_state_readable!(store)
      section_notes = {}
      STATE_PREFIXES.each do |prefix|
        store.list_json(prefix)
        section_notes[prefix] = "#{prefix} filtered by scoped token" if filtered_status_list?(store, prefix)
      rescue OperationalError => e
        raise unless scoped_http_forbidden_listing?(e, prefix)

        section_notes[prefix] = "#{prefix} not readable by scoped token"
      end
      section_notes
    end

    def install_link(source, destination)
      raise OperationalError, "bootstrap source missing: #{source}" unless File.exist?(source)

      FileUtils.ln_sf(source, destination)
    end

    def install_command(source, destination, status_state_root:)
      return install_link(source, destination) unless status_state_root

      install_wrapper(source, destination, status_state_root)
    end

    def install_wrapper(source, destination, status_state_root)
      raise OperationalError, "bootstrap source missing: #{source}" unless File.exist?(source)

      FileUtils.rm_f(destination)
      File.write(
        destination,
        <<~SH
          #!/bin/sh
          export #{STATUS_STATE_ROOT_ENV}=#{Shellwords.escape(status_state_root)}
          exec #{Shellwords.escape(source)} "$@"
        SH
      )
      FileUtils.chmod(0o755, destination)
    end

    def remove_legacy_alias(destination)
      return false unless File.symlink?(destination) || File.exist?(destination)

      legacy_source = File.expand_path("agent_coord", __dir__)
      if File.symlink?(destination)
        link_target = File.readlink(destination)
        link_target = File.expand_path(link_target, File.dirname(destination)) unless link_target.start_with?("/")
        return false unless link_target == legacy_source

        FileUtils.rm_f(destination)
        return true
      end

      return false unless File.file?(destination)

      content = File.binread(destination, 16 * 1024)
      escaped_legacy_source = Shellwords.escape(legacy_source)
      return false unless content.start_with?("#!/bin/sh".b) &&
                          (content.include?(legacy_source.b) || content.include?(escaped_legacy_source.b))

      FileUtils.rm_f(destination)
      true
    rescue SystemCallError
      false
    end

    def default_profile_path
      shell = File.basename(ENV.fetch("SHELL", ""))
      shell == "zsh" ? File.join(Dir.home, ".zshrc") : File.join(Dir.home, ".bashrc")
    end

    # This only reads the profile to check whether `line` is already present, and
    # never writes the read result back, so the comparison is done in bytes
    # rather than as text. A shell rc file is not guaranteed valid UTF-8 the way
    # state JSON is, so a plain text read can fail on invalid bytes -- but `line`
    # is not guaranteed to be a clean UTF-8 string either: Shellwords.escape on a
    # non-ASCII install_dir (from ARGV, itself ASCII-8BIT-tagged under some
    # locales) yields an ASCII-8BIT `line`, and comparing that against a
    # UTF-8-tagged `existing` never matches even when the bytes are identical --
    # so bootstrap would silently duplicate the PATH line on every rerun instead
    # of detecting it was already there. Reading with File.binread and comparing
    # against `line.b` puts both sides in ASCII-8BIT, which has no invalid byte
    # sequences, so #strip/#lines can never raise regardless of locale, and the
    # match is a plain byte comparison regardless of what encoding `line`
    # happened to end up in. Nothing is written back, and the appended line is
    # still the original `line`, so the user's profile bytes are untouched.
    def ensure_profile_path(profile, install_dir)
      FileUtils.mkdir_p(File.dirname(profile))
      # Shellwords.escape emits one backslash per character for a UTF-8-tagged
      # string but one per byte for a binary one, and install_dir comes from
      # ARGV, which Ruby tags with the locale encoding. Pin the encoding first
      # so the generated line is the same bytes under every locale.
      canonical_dir = install_dir.dup.force_encoding(Encoding::UTF_8)
      canonical_dir = install_dir.b unless canonical_dir.valid_encoding?
      line = "export PATH=#{Shellwords.escape(canonical_dir)}:\"$PATH\"".b
      # Read and compare as bytes: ASCII-8BIT has no invalid byte sequences, so
      # #strip and #lines cannot raise however the profile is encoded, and the
      # match does not depend on either side carrying a usable encoding tag.
      existing = File.exist?(profile) ? File.binread(profile) : ""
      return if existing.lines.any? { |existing_line| existing_line.strip == line }

      File.open(profile, "a") do |file|
        file.puts
        file.puts "# agent-coord bootstrap"
        file.puts line
      end
    end
  end

  class LocalStore
    def initialize(root)
      @root = File.expand_path(root)
    end

    def verify_root!
      verify_readable_root!
      raise OperationalError, "state root is not writable: #{@root}" unless File.writable?(@root)
    end

    def verify_readable_root!
      raise OperationalError, "state root does not exist: #{@root}" unless File.exist?(@root)
      raise OperationalError, "state root is not a directory: #{@root}" unless Dir.exist?(@root)
      return if File.readable?(@root) && File.executable?(@root)

      raise OperationalError, "state root is not readable: #{@root}"
    end

    # State records are JSON, which is UTF-8 by definition, so every read and
    # write in this store names that encoding instead of inheriting
    # Encoding.default_external. Under a non-UTF-8 locale the default is
    # US-ASCII, and one record holding a non-ASCII byte would otherwise fail
    # JSON.parse with Encoding::InvalidByteSequenceError and take down every
    # command that walks the store.
    def read_json(path)
      file = readable_record_file(path)
      return nil unless file

      StoredJson.new(path: path, data: JSON.parse(File.read(file, encoding: "UTF-8")), sha: file_sha(file))
    end

    # LocalStore keeps GitHubStore's keyword interface; only GitHubStore uses message.
    def write_json(path, data, message:, sha: nil, create: false) # rubocop:disable Lint/UnusedMethodArgument
      file = expanded_path(path)
      FileUtils.mkdir_p(File.dirname(file))
      with_file_lock(file) do
        raise Conflict, "state already exists at #{path}" if create && File.exist?(file)
        raise Conflict, "state changed at #{path}" if sha && (!File.exist?(file) || file_sha(file) != sha)

        atomic_write_json(file, data)
      end
    end

    def list_json(prefix)
      directory = readable_list_directory(prefix)
      return [] unless directory

      list_json_files(directory, prefix).map do |file|
        path = file.delete_prefix("#{@root}/")
        StoredJson.new(path: path, data: JSON.parse(File.read(file, encoding: "UTF-8")), sha: file_sha(file))
      end
    end

    def delete_json(path, message:, sha:) # rubocop:disable Lint/UnusedMethodArgument
      file = expanded_path(path)
      with_file_lock(file) do
        raise Conflict, "state changed at #{path}" unless File.exist?(file) && file_sha(file) == sha

        File.delete(file)
        fsync_parent_directory(file)
      end
    end

    def verify_layout!(prefixes)
      prefixes.each do |prefix|
        directory = expanded_path(prefix)
        # Empty local roots are valid because writes create prefix directories on demand.
        entry = lstat_if_present(directory)
        next unless entry
        next if entry.directory?

        raise OperationalError, "state layout invalid: #{prefix} is not a directory"
      end
    end

    private

    def readable_record_file(path)
      file = expanded_path(path)
      root_entry = configured_root_entry_if_present
      return unless root_entry

      current = @root
      validate_record_directory!(current, root_entry, path)
      segments = path.split("/")[0...-1]
      index = 0
      while index < segments.length
        current = File.join(current, segments.fetch(index))
        entry = lstat_if_present(current)
        return unless entry

        validate_record_directory!(current, entry, path)
        index += 1
      end

      entry = lstat_if_present(file)
      return unless entry
      raise OperationalError, "state layout invalid: #{state_relative_path(file)} is a symlink" if entry.symlink?
      unless entry.file?
        raise OperationalError, "state layout invalid: #{state_relative_path(file)} is not a regular file"
      end
      return file if File.readable?(file)

      raise OperationalError, "state record is not readable: #{path}"
    end

    def validate_record_directory!(directory, entry, path)
      raise OperationalError, "state layout invalid: #{state_relative_path(directory)} is a symlink" if entry.symlink?
      unless entry.directory?
        raise OperationalError, "state layout invalid: #{state_relative_path(directory)} is not a directory"
      end
      return if File.readable?(directory) && File.executable?(directory)

      raise OperationalError, "state record path is not readable or searchable: #{path}"
    end

    def readable_list_directory(prefix)
      target = expanded_path(prefix)
      return unless configured_root_entry_if_present

      directory = @root
      segments = prefix.split("/")
      index = 0
      while index < segments.length
        validate_list_directory!(directory, prefix)

        directory = File.join(directory, segments.fetch(index))
        entry = lstat_if_present(directory)
        return unless entry
        raise OperationalError, "state layout invalid: #{state_relative_path(directory)} is a symlink" if entry.symlink?
        raise OperationalError, "state layout invalid: #{prefix} is not a directory" unless entry.directory?

        index += 1
      end
      validate_list_directory!(target, prefix)
      target
    end

    def list_json_files(directory, prefix)
      pending = [directory]
      files = []
      until pending.empty?
        current = pending.pop
        validate_list_directory!(current, prefix)
        Dir.children(current).each do |name|
          next if name.start_with?(".")

          path = File.join(current, name)
          entry = File.lstat(path)
          if entry.symlink?
            raise OperationalError, "state layout invalid: #{state_relative_path(path)} is a symlink"
          elsif entry.directory?
            pending << path
          elsif entry.file? && name.end_with?(".json")
            files << path
          end
        end
      end
      files.sort
    rescue SystemCallError => e
      raise OperationalError, "state prefix is not readable or searchable: #{prefix} (#{e.message})"
    end

    def validate_list_directory!(directory, prefix)
      # The explicitly configured root defines the trust boundary and has
      # historically been allowed to be a symlink. Descendants remain lstat'd
      # so a link inside that boundary cannot redirect a scan outside it.
      entry = directory == @root ? File.stat(directory) : File.lstat(directory)
      unless entry.directory?
        raise OperationalError, "state layout invalid: #{state_relative_path(directory)} is not a directory"
      end
      return if File.readable?(directory) && File.executable?(directory)

      raise OperationalError, "state prefix is not readable or searchable: #{state_relative_path(directory)}"
    rescue Errno::ENOENT
      raise OperationalError, "state prefix disappeared while reading: #{prefix}"
    end

    def lstat_if_present(path)
      File.lstat(path)
    rescue Errno::ENOENT
      nil
    end

    def configured_root_entry_if_present
      File.stat(@root)
    rescue Errno::ENOENT
      nil
    rescue SystemCallError => e
      raise OperationalError, "state root is not accessible: #{@root} (#{e.message})"
    end

    def state_relative_path(path)
      path == @root ? "." : path.delete_prefix("#{@root}/")
    end

    def atomic_write_json(file, data)
      temporary = File.join(File.dirname(file), ".#{File.basename(file)}.tmp-#{Process.pid}-#{SecureRandom.hex(8)}")
      mode = File.exist?(file) ? File.stat(file).mode & 0o777 : 0o666
      File.open(temporary, File::WRONLY | File::CREAT | File::EXCL, mode, encoding: "UTF-8") do |output|
        output.chmod(mode) if File.exist?(file)
        output.write("#{JSON.pretty_generate(data)}\n")
        output.flush
        output.fsync
      end
      File.rename(temporary, file)
      fsync_parent_directory(file)
    ensure
      FileUtils.rm_f(temporary) if temporary
    end

    # Passes its own fsync_directory so the shared rule applies while the actual
    # syscall stays overridable: the suite subclasses LocalStore and replaces
    # that method to observe the fsync and to inject failures.
    def fsync_parent_directory(file)
      AgentCoord.fsync_parent_directory(file) { |directory| fsync_directory(directory) }
    end

    def fsync_directory(directory)
      AgentCoord.fsync_directory(directory)
    end

    def expanded_path(path)
      AgentCoord.safe_path!(path)
      expanded = File.expand_path(path, @root)
      raise Error, "state path escapes root: #{path}" unless expanded == @root || expanded.start_with?("#{@root}/")

      expanded
    end

    def with_file_lock(file)
      File.open("#{file}.lock", File::RDWR | File::CREAT, 0o600) do |lock|
        lock.flock(File::LOCK_EX)
        yield
      end
    end

    def file_sha(file)
      Digest::SHA256.file(file).hexdigest
    end
  end

  class GitHubStore
    def initialize(backend:, ref:)
      AgentCoord.validate_repo!(backend, "backend")
      @backend = backend
      @ref = ref
      @json_cache = {}
    end

    def read_json(path)
      AgentCoord.safe_path!(path)
      return @json_cache[path] if @json_cache.key?(path)

      result = gh_api("repos/#{@backend}/contents/#{path}?ref=#{@ref}")
      if result.not_found?
        verify_ref_readable!
        @json_cache[path] = nil
        return nil
      end
      raise OperationalError, result.error_message unless result.success?

      response = JSON.parse(result.stdout)
      content = Base64.decode64(response.fetch("content"))
      @json_cache[path] = StoredJson.new(path: path, data: JSON.parse(content), sha: response.fetch("sha"))
    end

    def write_json(path, data, message:, sha: nil, create: false)
      AgentCoord.safe_path!(path)
      args = [
        "-X", "PUT",
        "repos/#{@backend}/contents/#{path}",
        "-f", "message=#{message}",
        "-f", "branch=#{@ref}",
        "-f", "content=#{Base64.strict_encode64("#{JSON.pretty_generate(data)}\n")}"
      ]
      args.push("-f", "sha=#{sha}") if sha
      result = gh_api(*args)
      if result.conflict?
        invalidate_read_cache(path)
        reason = create ? "state already exists at #{path}" : "state changed at #{path}"
        raise Conflict, reason
      end
      raise OperationalError, result.error_message unless result.success?

      invalidate_read_cache(path)
    end

    def list_json(prefix)
      AgentCoord.safe_path!(prefix)
      tree_nodes.filter_map do |node|
        path = node["path"]
        next unless node["type"] == "blob" && path&.start_with?("#{prefix}/") && path.end_with?(".json")

        read_json(path)
      end
    end

    def delete_json(path, message:, sha:)
      AgentCoord.safe_path!(path)
      result = gh_api(
        "-X", "DELETE",
        "repos/#{@backend}/contents/#{path}",
        "-f", "message=#{message}",
        "-f", "branch=#{@ref}",
        "-f", "sha=#{sha}"
      )
      if result.conflict?
        invalidate_read_cache(path)
        raise Conflict, "state changed at #{path}"
      end
      raise OperationalError, result.error_message unless result.success?

      invalidate_read_cache(path)
    end

    def verify_readable!
      tree_nodes
    end

    def verify_not_archived!
      result = gh_api("repos/#{@backend}")
      unless result.success?
        raise OperationalError,
              "backend repository #{@backend} metadata is not readable: #{result.error_message}"
      end

      metadata = JSON.parse(result.stdout)
      unless metadata.is_a?(Hash) && metadata.key?("archived")
        raise OperationalError, "backend repository #{@backend} metadata does not report archived state"
      end
      return unless metadata.fetch("archived")

      raise OperationalError,
            "legacy GitHub backend #{@backend} is archived and read-only; configure AGENT_COORD_API_URL and " \
            "AGENT_COORD_API_TOKEN for the HTTP backend, or choose an active writable GitHub backend"
    end

    def verify_layout!(prefixes)
      nodes = tree_nodes
      prefixes.each do |prefix|
        next unless nodes.any? { |node| node["path"] == prefix && node["type"] != "tree" }

        raise OperationalError, "state layout invalid: #{prefix} is not a directory"
      end
    end

    private

    def verify_ref_readable!
      return if @ref_readable

      result = gh_api("repos/#{@backend}/git/trees/#{@ref}")
      unless result.success?
        raise OperationalError,
              "backend ref #{@backend}@#{@ref} is not readable: #{result.error_message}"
      end

      @ref_readable = true
    end

    def tree_nodes
      return @tree_nodes if defined?(@tree_nodes)

      result = gh_api("repos/#{@backend}/git/trees/#{@ref}?recursive=1")
      unless result.success?
        raise OperationalError,
              "backend ref #{@backend}@#{@ref} is not readable: #{result.error_message}"
      end

      @ref_readable = true
      @tree_nodes = JSON.parse(result.stdout).fetch("tree", [])
    end

    def invalidate_read_cache(path)
      @json_cache.delete(path)
      # Must remove the ivar so tree_nodes re-fetches after a successful write.
      remove_instance_variable(:@tree_nodes) if defined?(@tree_nodes)
    end

    def gh_api(*args)
      stdout, stderr, status = AgentCoord.capture3_utf8("gh", "api", *args)
      GhResult.new(stdout: stdout, stderr: stderr, status: status)
    rescue SystemCallError => e
      raise OperationalError, "gh api #{args.join(' ')} failed: #{e.message}"
    end
  end

  class HttpStore
    OPEN_TIMEOUT = 5
    READ_TIMEOUT = 10
    # DNS hostnames are case-insensitive but URI#hostname preserves the
    # caller's casing, so compare against this allowlist downcased.
    LOOPBACK_HOSTS = %w[localhost 127.0.0.1 ::1].freeze
    # URI.parse accepts any integer port, but a TCP port is 16-bit. An
    # out-of-range port is a typo that must fail closed here rather than
    # reach a resolver, which may reject it or silently truncate it.
    VALID_PORT_RANGE = (1..65_535)
    PERCENT_ENCODE_UNSAFE = /[^A-Za-z0-9._~-]/
    RETRYABLE_REUSED_CONNECTION_ERRORS = [EOFError, Errno::ECONNRESET, Errno::EPIPE].freeze

    def initialize(base_url:, token:)
      uri = parse_base_url(base_url)
      @base = uri.to_s.chomp("/")
      @token = token
      @http = nil
      @list_filtered = {}
    end

    def read_json(path)
      AgentCoord.safe_path!(path)
      response = request(Net::HTTP::Get, state_path(path))
      if response.code == "404"
        body = parsed_json_object(response, "read #{path}")
        return nil if body["error"] == "not_found"

        raise OperationalError, http_error("read #{path}", response)
      end
      raise OperationalError, http_error("read #{path}", response) unless response.code == "200"

      body = parsed_json_object(response, "read #{path}")
      StoredJson.new(path: path, data: fetch_field(body, "data", "read #{path}"),
                     sha: fetch_field(body, "version", "read #{path}").to_s)
    end

    def list_json(prefix)
      AgentCoord.safe_path!(prefix)
      entries = []
      cursor = nil
      seen_cursors = {}
      @list_filtered[prefix] = false

      loop do
        response = request(Net::HTTP::Get, state_list_path(prefix, cursor))
        raise OperationalError, http_error("list #{prefix}", response) unless response.code == "200"

        body = parsed_json_object(response, "list #{prefix}")
        @list_filtered[prefix] = true if body["filtered"] == true
        entries.concat(parse_list_entries(body, prefix))
        cursor = next_list_cursor(body, prefix)
        break unless cursor

        if seen_cursors[cursor]
          message = "http backend list #{prefix} returned malformed response: repeated next_cursor"
          raise OperationalError, message
        end

        seen_cursors[cursor] = true
      end

      entries
    end

    def filtered_list?(prefix)
      @list_filtered.fetch(prefix, false)
    end

    # message is accepted for interface parity; the HTTP backend has no commit messages.
    def write_json(path, data, message:, sha: nil, create: false) # rubocop:disable Lint/UnusedMethodArgument
      AgentCoord.safe_path!(path)
      raise Error, "write_json requires sha or create" if sha.nil? && !create

      headers = sha ? { "If-Match" => sha } : { "If-None-Match" => "*" }
      response = request(Net::HTTP::Put, state_path(path), body: { "data" => data }, headers: headers)
      case response.code
      when "200", "201" then nil
      when "409"
        raise Conflict, (create ? "state already exists at #{path}" : "state changed at #{path}")
      else
        raise OperationalError, http_error("write #{path}", response)
      end
    end

    # message is accepted for interface parity; the HTTP backend has no commit messages.
    def delete_json(path, message:, sha:) # rubocop:disable Lint/UnusedMethodArgument
      AgentCoord.safe_path!(path)
      response = request(Net::HTTP::Delete, state_path(path), headers: { "If-Match" => sha })
      case response.code
      when "200", "204" then nil
      when "409" then raise Conflict, "state changed at #{path}"
      else
        raise OperationalError, http_error("delete #{path}", response)
      end
    end

    def verify_readable!(prefix = JSON_PREFIXES.first)
      AgentCoord.safe_path!(prefix)
      if AgentCoord.state_record_path?(prefix)
        read_json(prefix)
      else
        response = request(Net::HTTP::Get, "/v1/state?prefix=#{escape_component(prefix)}")
        raise OperationalError, http_error("verify readable", response) unless response.code == "200"
      end
    end

    def verify_layout!(_prefixes)
      response = request(Net::HTTP::Get, "/v1/health")
      raise OperationalError, http_error("health", response) unless response.code == "200"
    end

    def whoami
      response = request(Net::HTTP::Get, "/v1/whoami")
      return nil if response.code == "404"

      raise OperationalError, http_error("whoami", response) unless response.code == "200"

      body = parsed_json_object(response, "whoami")
      {
        "machine" => fetch_field(body, "machine", "whoami").to_s,
        "read_prefixes" => Array(fetch_field(body, "read_prefixes", "whoami")),
        "write_prefixes" => Array(fetch_field(body, "write_prefixes", "whoami"))
      }
    end

    def close
      close_http_session
    end

    private

    def parse_base_url(base_url)
      uri = URI.parse(base_url.to_s)
      unless %w[http https].include?(uri.scheme) && !uri.host.to_s.empty?
        raise OperationalError, "invalid HTTP backend URL: expected http(s) URL with host"
      end
      if uri.query || uri.fragment
        raise OperationalError, "invalid HTTP backend URL: must not include a query or fragment"
      end
      unless VALID_PORT_RANGE.cover?(uri.port)
        raise OperationalError, "invalid HTTP backend URL: port must be between 1 and 65535"
      end
      if uri.scheme == "http" && !LOOPBACK_HOSTS.include?(uri.hostname.to_s.downcase)
        raise OperationalError, "HTTP backend URL must use https unless it points at localhost"
      end

      uri
    rescue URI::InvalidURIError
      # URI's exception embeds the rejected input. That value is untrusted and
      # may contain malformed userinfo that no finite URL-shaped regex can
      # reliably redact, so diagnostics describe the failure without echoing it.
      raise OperationalError, "invalid HTTP backend URL: malformed URL"
    end

    def state_path(path)
      "/v1/state/#{escape_component(path)}"
    end

    def escape_component(value)
      URI::DEFAULT_PARSER.escape(value.to_s, PERCENT_ENCODE_UNSAFE)
    end

    def state_list_path(prefix, cursor)
      query = { "prefix" => prefix }
      query["cursor"] = cursor if cursor
      "/v1/state?#{URI.encode_www_form(query)}"
    end

    def parse_list_entries(body, prefix)
      entries = fetch_field(body, "entries", "list #{prefix}")
      unless entries.is_a?(Array)
        raise OperationalError, "http backend list #{prefix} returned malformed response: entries is not an array"
      end

      entries.map do |entry|
        unless entry.is_a?(Hash)
          raise OperationalError, "http backend list #{prefix} returned malformed response: entry is not an object"
        end

        StoredJson.new(path: fetch_field(entry, "path", "list #{prefix}"),
                       data: fetch_field(entry, "data", "list #{prefix}"),
                       sha: fetch_field(entry, "version", "list #{prefix}").to_s)
      end
    end

    def next_list_cursor(body, prefix)
      return nil unless body.key?("next_cursor") && !body["next_cursor"].nil?

      cursor = body["next_cursor"]
      unless cursor.is_a?(String)
        raise OperationalError, "http backend list #{prefix} returned malformed response: next_cursor is not a string"
      end
      return nil if cursor.empty?

      cursor
    end

    def parsed_json_object(response, action)
      body = JSON.parse(response.body)
      return body if body.is_a?(Hash)

      raise OperationalError, "http backend #{action} returned malformed response: expected object"
    rescue JSON::ParserError, TypeError => e
      raise OperationalError, "http backend #{action} returned malformed JSON: #{e.message}"
    end

    def fetch_field(body, field, action)
      body.fetch(field)
    rescue KeyError, NoMethodError
      raise OperationalError, "http backend #{action} returned malformed response: missing #{field}"
    end

    def request(klass, request_path, body: nil, headers: {})
      uri = URI.parse("#{@base}#{request_path}")
      attempts = 0

      begin
        http_session(uri).request(build_http_request(klass, uri, body, headers))
      rescue *RETRYABLE_REUSED_CONNECTION_ERRORS => e
        close_http_session
        attempts += 1
        retry if attempts == 1 && klass == Net::HTTP::Get

        raise e
      end
    rescue URI::InvalidURIError, SocketError, SystemCallError, Timeout::Error, IOError, OpenSSL::SSL::SSLError => e
      close_http_session
      raise OperationalError, "http backend unreachable: #{AgentCoord.redact_userinfo_in_text(e.message)}"
    end

    def build_http_request(klass, uri, body, headers)
      http_request = klass.new(uri)
      http_request["Authorization"] = "Bearer #{@token}"
      headers.each { |name, value| http_request[name] = value }
      if body
        http_request["Content-Type"] = "application/json"
        http_request.body = JSON.generate(body)
      end
      http_request
    end

    def http_session(uri)
      return @http if @http&.active?

      close_http_session
      @http = Net::HTTP.start(
        uri.host,
        uri.port,
        use_ssl: uri.scheme == "https",
        open_timeout: OPEN_TIMEOUT,
        read_timeout: READ_TIMEOUT
      )
      @http.max_retries = 0 if @http.respond_to?(:max_retries=)
      @http
    end

    def close_http_session
      @http&.finish if @http&.active?
    rescue StandardError
      nil
    ensure
      @http = nil
    end

    def http_error(action, response)
      detail = begin
        parsed = JSON.parse(response.body)
        parsed.is_a?(Hash) ? parsed.fetch("error", response.body) : response.body.to_s[0, 200]
      rescue JSON::ParserError, TypeError
        response.body.to_s[0, 200]
      end
      "http backend #{action} failed: #{response.code} #{detail}"
    end
  end

  GhResult = Struct.new(:stdout, :stderr, :status, keyword_init: true) do
    def success?
      status.success?
    end

    def not_found?
      !success? && error_message.match?(/404|not found/i)
    end

    def conflict?
      !success? && error_message.match?(/409|422|sha|already exists|conflict/i)
    end

    # Diagnostic text, not payload: scrubbed per stream so that neither the
    # predicates below nor a --json reporter can raise while describing a
    # failure. See AgentCoord.utf8_diagnostic.
    def error_message
      [stderr, stdout].reject(&:empty?).map { |stream| AgentCoord.utf8_diagnostic(stream) }.join("\n")
    end
  end

  # Open3 tags captured output with Encoding.default_external, which is US-ASCII
  # under LC_ALL=C or LANG=C. Every subprocess captured here emits UTF-8, so that
  # tag is simply wrong, and correctly formed bytes then raise
  # Encoding::InvalidByteSequenceError from JSON.parse and ArgumentError from
  # Regexp#match?. Re-tagging both streams at the capture seam stops the locale
  # deciding how captured bytes are read; it covers stderr as well as stdout
  # because an error path that crashes while formatting its own message is worse
  # than the failure it was reporting.
  #
  # Caller contract: this re-tags but deliberately does not scrub, so the payload
  # stream reaches JSON.parse as the subprocess wrote it. Genuinely malformed
  # bytes therefore survive here and still raise from Regexp#match? and
  # JSON.generate. Anything that interpolates either stream into a message must
  # route it through utf8_diagnostic rather than using it raw.
  def self.capture3_utf8(*)
    stdout, stderr, status = Open3.capture3(*)
    [force_utf8(stdout), force_utf8(stderr), status]
  end

  def self.force_utf8(text)
    text.dup.force_encoding(Encoding::UTF_8)
  end

  # Re-tagging fixes a wrong label but cannot repair genuinely malformed bytes,
  # and an invalid UTF-8 string still raises from Regexp#match? and from
  # JSON.generate in the --json reporters. Message paths therefore substitute
  # U+FFFD for undecodable bytes, because diagnostics are prose and a readable
  # approximation beats a second crash; payload paths deliberately do not,
  # because silently rewriting a state record is worse than failing to read it.
  def self.utf8_diagnostic(text)
    force_utf8(text).scrub
  end

  def self.safe_path!(path)
    return unless path.to_s.empty? || path.include?("..") || path.start_with?("/") || path.split("/").any?(&:empty?)

    raise PathValidationError, "unsafe state path: #{path}"
  end

  # Resolves a caller-supplied heartbeat/event status against the canonical
  # vocabulary: case and hyphen/underscore folding first, then the known-alias
  # map. Returns nil when the value is not recognized.
  def self.canonical_status(value)
    folded = value.to_s.strip.downcase.tr("-", "_")
    return folded if HEARTBEAT_STATUSES.include?(folded)

    HEARTBEAT_STATUS_ALIASES[folded]
  end

  # Machine/session identity is non-secret attribution metadata resolved from the
  # environment at call time; machine-token authentication remains authoritative
  # for access control.
  def self.environment_machine_id
    environment_identity_value(MACHINE_ID_ENV)
  end

  # Session resolution order: AGENT_COORD_SESSION_ID, then CODEX_THREAD_ID, then
  # unset. Never reuses a persisted session id.
  def self.environment_session_identity
    explicit = environment_identity_value(SESSION_ID_ENV)
    return [explicit, SESSION_SOURCE_AGENT_COORD] if explicit

    codex = environment_identity_value(CODEX_THREAD_ID_ENV)
    return [codex, SESSION_SOURCE_CODEX] if codex

    [nil, SESSION_SOURCE_UNSET]
  end

  # The single rule for "is this AGENT_COORD_* value set?", wherever the value
  # comes from: the process environment, the canonical user file, or an option
  # already resolved from either. Surrounding whitespace is not content, so a
  # whitespace-only value is unset -- an exported-but-empty wrapper variable
  # (`export AGENT_COORD_API_URL="$URL"` with URL unset and quoted) must not
  # read as a selection.
  #
  # Every reader that used to spell this rule for itself is why the same defect
  # shipped three times: `config show` reported `backend: http` for a canonical
  # AGENT_COORD_API_URL='   ' while resolution stripped it and fell through to
  # the implicit local backend, and a blank exported AGENT_COORD_REF displaced a
  # saved ref and was then sent to the GitHub API as a real ref
  # (`git/trees/   `). Reporting, resolution, and every guard that asks whether
  # a value is configured must route through this predicate rather than
  # re-deriving it, or they will disagree again.
  #
  # Deciding presence is all this does; it never rewrites the value. Callers
  # that keep a value keep it verbatim, because internal and trailing
  # whitespace inside a real token or path is significant.
  def self.config_value_set?(value)
    !value.to_s.strip.empty?
  end

  # Whole-value form: redact a URL that is itself the string being reported.
  def self.redact_url_userinfo(value)
    return value if value.nil?

    value.to_s.sub(URL_USERINFO_PREFIX) { "#{Regexp.last_match(1)}***@" }
  end

  # Prose form: redact every credential-bearing URL embedded in a message.
  def self.redact_userinfo_in_text(text)
    text.to_s.gsub(URL_USERINFO_ANYWHERE) { "#{Regexp.last_match(1)}***@" }
  end

  # Reads from the live process environment by default. load_user_configuration!
  # passes its pre-injection snapshot instead so that one strip-before-empty rule
  # decides both whether a process value overrides a saved one and what the
  # writers later record.
  def self.environment_identity_value(name, env: ENV)
    value = env.fetch(name, nil)
    return nil unless config_value_set?(value)

    value.to_s.strip
  end

  def self.state_record_path?(path)
    path.to_s.match?(STATE_PATH_PATTERN)
  end

  def self.state_directory_prefix?(path)
    path.to_s.match?(STATE_DIRECTORY_PREFIX_PATTERN)
  end

  # Ruby tags ARGV with the locale encoding, and everything downstream assumes
  # UTF-8: JSON.generate warns on a non-UTF-8 string today and raises under json
  # 3.0, and a differently tagged argument does not compare equal to the same
  # text read back from state, which is why under LC_ALL=C a non-ASCII agent
  # could neither renew nor release its own claim. Doing this once at the Runner
  # boundary covers the command token, every option value, the `log` positional,
  # and demo's passthrough argv together, so an option added later cannot forget
  # it. raw_indexes carries the exceptions: values that address the filesystem
  # rather than coordination state keep their bytes, because normalizing a path
  # changes which file it names. Returns a new array rather than normalizing in
  # place: Runner#run and parse_options consume the array they are given, and
  # that must not reach back into an ARGV or a caller's array they do not own.
  def self.normalize_argv(argv, raw_indexes: [])
    argv.each_with_index.map do |argument, index|
      raw_indexes.include?(index) ? argument.to_s : normalize_argument(argument.to_s)
    end
  end

  # How Ruby tagged the argument decides what normalizing it means, and argv is
  # the one boundary where both cases occur. BINARY is the absence of a tag --
  # what LANG=C/LC_ALL=C produces for an argument holding a non-ASCII byte -- so
  # there is no source encoding to convert from and force_utf8 retags it as the
  # UTF-8 it was meant to be, which is the same correction capture3_utf8 applies
  # to a mislabeled subprocess stream. Any other tag is a real claim about what
  # those bytes mean, so the argument is transcoded instead: retagging an
  # ISO-8859-1 terminal's `café` would either reject valid input or, when the
  # latin-1 bytes happen to form UTF-8, silently store different text than the
  # operator typed.
  #
  # This is a payload path, so it does not scrub, for the reason utf8_diagnostic
  # documents: rewriting a state record is worse than refusing to write it, and
  # these values are state keys, so a scrubbed agent-id or repo would be stored
  # as a silently different identity. load_launch_prompt refuses the same way.
  def self.normalize_argument(argument)
    normalized =
      if argument.encoding == Encoding::ASCII_8BIT
        force_utf8(argument)
      else
        argument.encode(Encoding::UTF_8)
      end
    # UTF-8 to UTF-8 is a no-op that does not validate, so a UTF-8-tagged
    # argument holding invalid bytes is still only caught here.
    return normalized if normalized.valid_encoding?

    raise Error, invalid_argument_message(argument)
  rescue EncodingError
    # Every transcoding failure: undefined conversion, invalid byte sequence in
    # the declared encoding, or an encoding with no converter to UTF-8.
    raise Error, invalid_argument_message(argument)
  end

  # The message half of the same policy: the rejected value is echoed through
  # utf8_diagnostic, so reporting an argument cannot itself raise on the bytes it
  # is reporting. force_encoding overrides whatever tag was there, so this
  # re-derives the value from its bytes whatever encoding it arrived claiming.
  def self.invalid_argument_message(argument)
    "command-line argument must be valid UTF-8: #{utf8_diagnostic(argument)}"
  end

  def self.validate_repo!(repo, field)
    value = repo.to_s
    return if value.match?(%r{\A[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\z})

    raise Error, "invalid #{field} repo: #{repo}"
  end

  def self.validate_segment!(segment, field)
    return if segment.to_s.match?(/\A[A-Za-z0-9_:-]+(?:\.[A-Za-z0-9_:-]+)*\z/)

    raise PathValidationError, "invalid #{field}: #{segment}"
  end

  # Renaming a file into place is not durable until the directory entry itself
  # reaches stable storage, so every atomic replacement in this file follows its
  # rename with this.
  def self.fsync_parent_directory(file, &fsync)
    return if Gem.win_platform?

    (fsync || method(:fsync_directory)).call(File.dirname(file))
  rescue Errno::EINVAL, Errno::ENOTSUP
    nil
  end

  def self.fsync_directory(directory)
    File.open(directory, File::RDONLY, &:fsync)
  end

  def self.claim_path(repo, target)
    validate_repo!(repo, "target")
    validate_segment!(target, "target")
    "claims/#{repo}/#{target}.json"
  end

  def self.heartbeat_path(agent_id)
    validate_segment!(agent_id, "agent-id")
    "heartbeats/#{agent_id}.json"
  end

  def self.batch_path(batch_id)
    validate_segment!(batch_id, "batch-id")
    "batches/#{batch_id}.json"
  end

  def self.event_path(batch_id, event_id)
    validate_segment!(batch_id, "batch-id")
    validate_segment!(event_id, "event-id")
    "events/#{batch_id}/#{event_id}.json"
  end

  def self.event_batch_prefix(batch_id)
    validate_segment!(batch_id, "batch-id")
    "events/#{batch_id}"
  end

  def self.event_batch_from_path(path)
    parts = path.split("/")
    parts.length >= 3 ? parts[1] : "UNKNOWN"
  end

  def self.archive_path(source_path)
    unless source_path.to_s.match?(%r{\A(?:claims|heartbeats|batches|events)/}) && state_record_path?(source_path)
      raise PathValidationError, "invalid archive source path: #{source_path}"
    end

    "archive/#{source_path}"
  end

  def self.repo_from_claim_path(path)
    parts = path.split("/")
    return "UNKNOWN" unless parts.length >= 4

    "#{parts[1]}/#{parts[2]}"
  end

  def self.target_from_path(path)
    File.basename(path, ".json")
  end

  # Split a target into the work item it names and the sub-lane within it:
  # `issue:319:qa` is the qa lane of item 319. Claims key those separately on
  # purpose -- a lane holds its own lease -- so this is a read-path identity
  # only. Folding the two together in a claim key would break lease exclusion.
  #
  # `adhoc:` is dropped only when what follows cannot be a GitHub number.
  # Nothing stops an operator naming an ad hoc task `adhoc:319`, and stripping
  # that would merge it into issue 319 -- the same wrong answer this identity
  # exists to prevent, arrived at from the other direction.
  def self.work_item_parts(target)
    # -1 keeps a trailing empty field: `319:` is a legal claim segment and a
    # different key from `319`, so dropping it would answer for both at once.
    segments = work_item_segments(target.to_s.strip.split(":", -1))
    base = segments.shift.to_s.downcase
    [base, segments.empty? ? nil : segments.join(":").downcase]
  end

  # A kind prefix comes off only where it is decoration rather than identity.
  # `issue:`/`pr:` decorate a GitHub number, so they come off ahead of one and
  # stay ahead of a slug -- `issue:foo` is not the separately keyed `foo`.
  # `adhoc:` is the mirror image: it decorates a slug, and ahead of a number it
  # stays, so `adhoc:319` is neither issue 319 nor the `319` lane of a work item
  # called "adhoc". A prefix that stays is part of the base, never a lane.
  def self.work_item_segments(segments)
    return segments unless segments.length > 1

    kind = segments.first.downcase
    return segments unless WORK_ITEM_KINDS.include?(kind)
    return segments.drop(1) if decorative_work_item_kind?(kind, segments[1])

    [segments.take(2).join(":"), *segments.drop(2)]
  end

  def self.decorative_work_item_kind?(kind, id)
    # An absent id decorates nothing. Without this, `adhoc:` comes off an empty
    # segment and `adhoc::qa` collapses onto the separately keyed `:qa`.
    return false if id.to_s.empty?

    numeric = id.to_s.match?(WORK_ITEM_NUMBER)
    WORK_ITEM_GITHUB_KINDS.include?(kind) ? numeric : !numeric
  end

  def self.source_root
    File.expand_path("..", __dir__)
  end

  def self.state_root?(root)
    JSON_PREFIXES.all? { |prefix| Dir.exist?(File.join(root, prefix)) }
  end
end

# RubyGems-generated wrappers load the same-named executable, so basename equality is intentional.
if File.basename($PROGRAM_NAME) == File.basename(__FILE__)
  begin
    exit AgentCoord::Runner.new(ARGV).run
  rescue AgentCoord::Error => e
    warn e.message
    exit e.exit_code
  end
end
