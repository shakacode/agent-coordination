  LANE_CLOSED_SCHEMA_VERSION = 2
  ARCHIVE_SCHEMA_VERSION = 1
  DEFAULT_WORKSPACE = "default"
  TERMINAL_STATES = %w[done abandoned superseded].freeze
  DEFAULT_BACKEND = nil
  DEFAULT_REF = "state"
  DEFAULT_CLAIM_TTL = 4 * 60 * 60
  DEFAULT_HEARTBEAT_TTL = 15 * 60
  HEARTBEAT_DEAD_AFTER_TTL_MULTIPLIER = 4
  DEFAULT_HOT_DAYS = 7
  DEFAULT_ARCHIVE_DAYS = 30
  DEFAULT_SYNTHETIC_HOT_DAYS = 1
  MAX_ARCHIVE_STATE_BYTES = 1024 * 1024
  STATUS_STATE_ROOT_ENV = "AGENT_COORD_STATUS_STATE_ROOT"
  # Explicit operator opt-in to the implicit local backend; suppresses the
  # split-brain advisory and the write hard stop.
  LOCAL_MODE_ENV = "AGENT_COORD_LOCAL"
  LOCAL_MODE_TRUE_VALUES = %w[1 true yes].freeze
